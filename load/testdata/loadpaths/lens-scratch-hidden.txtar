A lens keeping its scratch in hidden fields beside its result: a table it
looks a value up in, a helper the result refers to, and one built inside a
comprehension. The lens's digest covers the values its result reads from them,
bound by value, but not their names, so the lineage binds with the same IDs and
programs along every path (#250).
-- normal.cue --
name: "ship"
schemas: {
	"0": "0": schema: {kind: "a" | "b"}
	"1": "0": schema: {kind: "a" | "b", code: int}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		_codes: {a: 1, b: 2}
		_kind:  v0_0.kind
		_note: {if v0_0.kind == "a" {first: true}}
		v1_0: {
			kind: _kind
			code: _codes[_kind]
		}
	}
	"1.0->0.0": {
		v1_0: _
		_k: v1_0.kind
		v0_0: {kind: _k}
		lacunas: [{
			sourceFields: [{path: "code", value: v1_0.code}]
			message: "code is dropped"
			type:    "DroppedField"
		}]
	}
}
-- out/verdict --
# bind
ok
# ids
0.0 g2.f889899c1ace4cd7f69b44357848655fbc555ab17889a261b6e3aa4aa62942b9:g2.44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a
1.0 g2.4e16f8d0a0b1703b5286975d20060563473a4d496d76694a6e41b1e726d7946a:g2.085cb1654855b008c4badb742902b328edb9207e0dae025573e9f780e5b9671c
# programs
lens 0.0->1.0
out: {
  out.kind <- in.kind
  out.code = table in.kind {
    "a" {
      out.code = 1
    }
    "b" {
      out.code = 2
    }
  }
}
lens 1.0->0.0
out: {
  out.kind <- in.kind
}
lacuna DroppedField {
  source code = in.code
  message "code is dropped"
}
