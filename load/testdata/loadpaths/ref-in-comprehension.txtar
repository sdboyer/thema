A lens whose pending comprehension refers to a schema of the lineage, which
only the lens's syntax shows (ref-lens-to-schema).
-- normal.cue --
name: "ship"
schemas: {
	"0": "0": schema: {a?: string}
	"1": "0": schema: {b?: string}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			if v0_0.a != _|_ {
				b: schemas["0"]["0"].schema.a
			}
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			if v1_0.b != _|_ {
				a: v1_0.b
			}
		}
	}
}
-- out/verdict --
# bind
E0144 v1_0.b in lens 0.0->1.0 refers to schemas["0"]["0"].schema.a, a schema
