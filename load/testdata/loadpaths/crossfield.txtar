A minor version whose schemas constrain one field by another, so that the
compatibility check compares expressions that refer within each schema.
-- normal.cue --
name: "ship"
schemas: {
	"0": "0": schema: {
		low:  int
		high: int & >=low
	}
	"0": "1": schema: {
		low:   int
		high:  int & >=low
		note?: string
	}
}
lenses: "0.1->0.0": {
	v0_1: _
	v0_0: {
		low:  v0_1.low
		high: v0_1.high
	}
}
-- out/verdict --
# bind
ok
# ids
0.0 520e6d9772b3bfcc30b4ec4c70b8d797774a7f667c5ff178258849de69426eb5:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a
0.1 9b9650712adc289eb47b8cca842d0b96f019127dffada5e47d8455d4682c615d:1e26ddc29b524f402d22d82cadbcc4c772547f6431da5797b2e4d3045c2ae357
# programs
lens 0.1->0.0
out: {
  out.low <- in.low
  out.high <- in.high
}
