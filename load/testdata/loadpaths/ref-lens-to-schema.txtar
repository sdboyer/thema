A lens that refers to a schema of the lineage, which is invalid however the
lineage was loaded (ref-lens-to-schema).
-- normal.cue --
name: "ship"
schemas: {
	"0": "0": schema: {a: string}
	"1": "0": schema: {b: string}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: b: schemas["0"]["0"].schema.a
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: a: v1_0.b
	}
}
-- out/verdict --
# bind
E0144 v1_0.b in lens 0.0->1.0 refers to schemas["0"]["0"].schema.a, a schema
