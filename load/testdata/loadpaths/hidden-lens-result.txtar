A lens whose result declares hidden fields, one plain and one inside a
comprehension that has not fired: every path refuses both (#250), though the
same fields beside the result would be the lens's scratch space.
#ids: refused
-- normal.cue --
name: "ship"
schemas: {
	"0": "0": schema: {kind: "a" | "b"}
	"1": "0": schema: {kind: "a" | "b", code: int}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			_tmp: v0_0.kind
			kind: _tmp
			code: 1
			if v0_0.kind == "a" {_seen: true}
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {kind: v1_0.kind}
		lacunas: [{
			sourceFields: [{path: "code", value: v1_0.code}]
			message: "code is dropped"
			type:    "DroppedField"
		}]
	}
}
-- out/verdict --
# bind
E0151 the result of lens v0.0->v1.0 declares _tmp, a hidden field
E0151 the result of lens v0.0->v1.0 declares _seen, a hidden field
