# minor bump removes a default (*1 | int -> int); {} was valid at 0.0 and is invalid at 0.1
#issue: 17
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "compat-remove-default"
	schemas: [{
		version: [0, 0]
		schema: {a: *1 | int}
	}, {
		version: [0, 1]
		schema: {a: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind fail
