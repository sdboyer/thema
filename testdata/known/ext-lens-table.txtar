# lens results are looked up in a table outside the lineage. The key is a
# finite set of constants, each an entry, so the lens is total; what is wrong is
# where the table lives.
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

_table: {x: "from-outside", y: "also-outside"}

lin: thema.Lineage & {
	name: "extLensTable"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"1": "0": {
			schema: {b: "x" | "y"}
		}
	}
	lenses: {
		"1.0->0.0": {
			input: _
			result: {a: _table[input.b]}
		}
		"0.0->1.0": {
			input: _
			result: {b: "x"}
		}
	}
}
-- expect --
bind fail
