# lens results are looked up in a table outside the lineage
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

_table: {x: "from-outside"}

lin: thema.Lineage & {
	name: "extLensTable"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"1": "0": {
			schema: {b: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			input: _
			result: {a: _table[input.b]}
		}
		"0.0->1.0": {
			input: _
			result: {b: _table.x}
		}
	}
}
-- expect --
bind fail
