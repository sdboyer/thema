# lens results are looked up in a table outside the lineage
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

_table: {x: "from-outside"}

lin: thema.Lineage & {
	name: "extLensTable"
	schemas: [{
		version: [0, 0]
		schema: {a: string}
	}, {
		version: [1, 0]
		schema: {b: string}
	}]
	lenses: [{
		from: [1, 0]
		to: [0, 0]
		input: _
		result: {a: _table[input.b]}
	}, {
		from: [0, 0]
		to: [1, 0]
		input: _
		result: {b: _table.x}
	}]
}
-- expect --
bind fail
