# identical schemas containing a conditional field fail to bind: a pending comprehension
# makes the schema's kind bottom, which checkSchemaShapes rejects as "not a struct"
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "fpIdenticalConditional"
	schemas: {
		"0": "0": {
			schema: {kind: string, if kind == "x" {extra?: int}}
		}
		"0": "1": {
			schema: {kind: string, if kind == "x" {extra?: int}}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: input
		}
	}
}
-- expect --
bind ok
translate 0.0 0.1 ok {kind: "x", extra: 1}
