# schema is borrowed from another lineage's latest schema
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

other: thema.Lineage & {
	name: "other"
	schemas: {
		"0": "0": {schema: {a: int}}
	}
}

lin: thema.Lineage & {
	name: "extSchemaOtherLineage"
	schemas: {
		"0": "0": {
			schema: other.schemas["0"]["\(len(other.schemas["0"])-1)"].schema
		}
	}
}
-- expect --
bind fail
