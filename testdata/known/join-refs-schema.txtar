# joinSchema references the lineage's latest schema, so it changes as the lineage grows
#issue: 22
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "joinRefsSchema"
	joinSchema: lin.schemas[len(lin.schemas)-1].schema
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [0, 1]
		schema: {a: int, b?: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind fail
