# schema is not an instance of the joinSchema; the join's required field is silently merged in
#issue: 22
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "join-not-instance"
	joinSchema: {kind: string}
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}]
}
-- expect --
bind fail
