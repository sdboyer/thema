# adding a hidden helper field, invisible to data, is judged backwards incompatible
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "fp-hidden-field-added"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [0, 1]
		schema: {a: int, _h: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind ok
translate 0.0 0.1 ok {a: 1}
