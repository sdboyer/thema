-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "extLensUsesName"
	schemas: [{
		version: [0, 0]
		schema: {a: string, v: lin.#LatestVersion[1]}
	}, {
		version: [0, 1]
		schema: {a: string, b?: string, v: lin.#LatestVersion[1]}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: lin.name, v: input.v}
	}]
}
-- expect --
bind fail
