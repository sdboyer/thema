# two lenses for the same step 0.1 -> 0.0; one is silently ignored
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lens-duplicate"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [0, 1]
		schema: {a: int, b?: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}, {
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: 1000}
	}]
}
-- expect --
bind fail
