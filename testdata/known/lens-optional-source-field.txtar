# lens maps a required target field from an optional source field, so it is undefined when that field is absent
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensOptionalSourceField"
	schemas: [{
		version: [0, 0]
		schema: {a: string}
	}, {
		version: [1, 0]
		schema: {b: string, c?: string}
	}]
	lenses: [{
		from: [1, 0]
		to: [0, 0]
		input: _
		result: {a: input.c}
	}, {
		from: [0, 0]
		to: [1, 0]
		input: _
		result: {b: input.a}
	}]
}
-- expect --
bind fail
