# major bump that only adds a hidden field is accepted as breaking
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "major-hidden-only"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [1, 0]
		schema: {a: int, _h: int}
	}]
	lenses: [{
		from: [1, 0]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}, {
		from: [0, 0]
		to: [1, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind fail
