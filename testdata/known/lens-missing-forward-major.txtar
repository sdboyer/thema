# no forward lens 0.0 -> 1.0 across a major boundary
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lens-missing-forward-major"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [1, 0]
		schema: {a: string}
	}]
	lenses: [{
		from: [1, 0]
		to: [0, 0]
		input: _
		result: {a: 0}
	}]
}
-- expect --
bind fail
