# identical time.Time in both versions is judged backwards incompatible
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
	"time"
)

lin: thema.Lineage & {
	name: "fp-time-identical"
	schemas: [{
		version: [0, 0]
		schema: {a: time.Time}
	}, {
		version: [0, 1]
		schema: {a: time.Time, b?: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind ok
translate 0.0 0.1 ok {a: "2024-01-01T00:00:00Z"}
