# lens result is read from another lens (via the lineage path) rather than from its own input
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensResultDependsOnOtherLens"
	schemas: [{
		version: [0, 0]
		schema: {a: string}
	}, {
		version: [1, 0]
		schema: {b: string}
	}]
	lenses: [{
		from: [1, 0]
		to: [0, 0]
		input: {b: *"default-from-lens-input" | string}
		result: {a: input.b}
	}, {
		from: [0, 0]
		to: [1, 0]
		input: _
		result: {b: lin.lenses[0].result.a}
	}]
}
-- expect --
bind fail
