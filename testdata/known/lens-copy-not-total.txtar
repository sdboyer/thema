# a lens copying from a source's ... into a destination the target types can't
# translate every valid source instance, yet binds
#issue: 46
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensCopyNotTotal"
	schemas: [{
		version: [0, 0]
		schema: {a: string, ...}
	}, {
		version: [1, 0]
		schema: {a: string, zzz?: string, ...}
	}]
	lenses: [{
		from: [1, 0], to: [0, 0], input: _, result: {a: input.a}
	}, {
		from: [0, 0], to: [1, 0], input: _, result: input
	}]
}
-- expect --
bind fail
