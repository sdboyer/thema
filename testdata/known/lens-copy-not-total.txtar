# a lens copying from a source's ... into a destination the target types can't
# translate every valid source instance, yet binds
#issue: 46
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensCopyNotTotal"
	schemas: {
		"0": "0": {
			schema: {a: string, ...}
		}
		"1": "0": {
			schema: {a: string, zzz?: string, ...}
		}
	}
	lenses: {
		"1.0->0.0": {
			input: _, result: {a: input.a}
		}
		"0.0->1.0": {
			input: _, result: input
		}
	}
}
-- expect --
bind fail
