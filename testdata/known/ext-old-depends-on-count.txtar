# schema 0.0 is constrained by the number of schemas, so appending a version changes it
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "extOldDependsOnCount"
	schemas: {
		"0": "0": {
			schema: {n: <=len(lin.schemas)}
		}
		"0": "1": {
			schema: {n: <=len(lin.schemas), m?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: {n: input.n}
		}
	}
}
-- expect --
bind fail
