import "github.com/sdboyer/thema"

thema.Lineage
name: "refstruct"
schemas: {
	"0": "0": {
		schema: {
			aBaz: #Baz
			disj: #Baz | #Bar
	
			#Baz: {
				run:  string
				tell?: bytes
				dat:  int32
			}
	
			#Bar: {
			    one: string
			    two: string
			}
		}
	}
}
lenses: {}
