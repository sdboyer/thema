# Simple expansion of a schema over time through backwards compatible addition of fields
-- in.cue --

import "github.com/sdboyer/thema"

thema.Lineage
name: "expand"
schemas: {
    "0": "0": {
        schema: {
            init: string
        }
    }
    "0": "1": {
        schema: {
            init:      string
            optional?: int
        }
    }
    "0": "2": {
        schema: {
            init:         string
            optional?:    int
            withDefault?: *"foo" | "bar"
        }
    }
    "0": "3": {
        schema: {
            init:         string
            optional?:    int
            withDefault?: *"foo" | "bar" | "baz"
        }
    }
}

lenses: {
    "0.1->0.0": {
        v0_1: _
        v0_0: {
            init: v0_1.init
        }
    }
    "0.2->0.1": {
        v0_2: _
        v0_1: {
            init: v0_2.init
            if v0_2.optional != _|_ {
                optional: v0_2.optional
            }
        }
    }
    "0.3->0.2": {
        v0_3: _
        v0_2: {
            init: v0_3.init
            if v0_3.optional != _|_ {
                optional: v0_3.optional
            }
            if v0_3.withDefault != _|_ {
                if v0_3.withDefault != "baz" {
                    withDefault: v0_3.withDefault
                }
                if v0_3.withDefault == "baz" {
                    // 0.2 has no "baz"; its default stands in for it, and the
                    // lacuna below says so.
                    withDefault: "foo"
                }
            }
        }
        lacunas: [
            thema.Lacuna & {
                condition: (v0_3.withDefault & "baz") != _|_
                sourceFields: [{path: "withDefault", value: v0_3.withDefault}]
                targetFields: [{path: "withDefault", value: v0_2.withDefault}]
                message: "withDefault was \"baz\", which 0.2 does not have; \"foo\", its default, was substituted"
                type:    thema.LacunaTypes.LossyFieldMapping
            },
        ]
    }
}
-- in/validate/TestValidate/invalidEnumValue.data.json --
{
    "init": "init",
    "withDefault": "invalid value for withDefault"
}
-- out/validate/TestValidate/invalidEnumValue --
error[E0505]: withDefault in the data matches none of the alternatives schema 0.3 allows
  --> in/validate/TestValidate/invalidEnumValue.data.json:3:20
   |
 3 |     "withDefault": "invalid value for withDefault"
   |                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
   |
  ::: /in.cue:29:28
   |
29 |             withDefault?: *"foo" | "bar" | "baz"
   |                            ----- withDefault: conflicting values "foo" and "invalid value for withDefault"
   |                                    ----- withDefault: conflicting values "bar" and "invalid value for withDefault"
   |                                            ----- withDefault: conflicting values "baz" and "invalid value for withDefault"
   |
   = detail: withDefault: 3 errors in empty disjunction:
