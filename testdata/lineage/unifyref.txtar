import "github.com/sdboyer/thema"

thema.#Lineage
name: "unifyref"
schemas: [{
	version: [0, 0]
	schema: {
	    afoo: #Foo

	    #Foo: External & {
	        optf?: #Bar
	    }
	    #Bar: {
	        another: string
	    }
	}
}]
lenses: []

External: {
    extfield: string
}
