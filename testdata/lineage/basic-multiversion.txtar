# Basic schema evolution over time

#multiversion
#slow
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "basicMultiversion"

schemas: {
    "0": "0": {
        schema: {
            init: string
        }
        examples: {
            simple: {
                init: "some string"
            }
        }
    }
    "0": "1": {
        schema: {
            init:      string
            optional?: int32
        }
        examples: {
            withoutOptional: {
                init: "some string"
            }
            withOptional: {
                init: "some string"
                optional: 32
            }
        }
    }
    "0": "2": {
        schema: {
            init:        string
            optional?:   int32
            withDefault?: *"foo" | "bar"
        }
        examples: {
            withoutOptional: {
                init: "some string"
                withDefault: "foo"
            }
            withOptional: {
                init: "some string"
                optional: 32
                withDefault: "bar"
            }
        }
    }
    "0": "3": {
        schema: {
            init:        string
            optional?:   int32
            withDefault?: *"foo" | "bar" | "baz"
        }
        examples: {
            withoutOptional: {
                init: "some string"
                withDefault: "baz"
            }
            withOptional: {
                init: "some string"
                optional: 32
                withDefault: "baz"
            }
        }
    }
    "1": "0": {
        schema: {
            renamed:     string
            optional?:   int32
            withDefault: "foo" | *"bar" | "baz"
        }
        examples: {
            withoutOptional: {
                renamed: "some string"
                withDefault: "foo"
            }
            withOptional: {
                renamed: "some string"
                optional: 32
                withDefault: "bar"
            }
        }
    }
    "1": "1": {
        schema: {
            renamed:     string
            optional?:   int32
            withDefault: "foo" | *"bar" | "baz" | "bing"
        }
        examples: {
            withoutOptional: {
                renamed: "some string"
                withDefault: "bing"
            }
            withOptional: {
                renamed: "some string"
                optional: 32
                withDefault: "bing"
            }
        }
    }
    "2": "0": {
        schema: {
            toObj:     {
                init: string
            }
            optional?:   int32
            withDefault: "foo" | *"bar" | "baz" | "bing"
        }
        examples: {
            withoutOptional: {
                toObj: {
                    init: "some string"
                }
                withDefault: "bing"
            }
            withOptional: {
                toObj: {
                    init: "some string"
                }
                optional: 32
                withDefault: "bing"
            }
        }
    }
}

lenses: {
    "0.1->0.0": {
        v0_1: _
        v0_0: {
            init: v0_1.init
        }
    }
    "0.2->0.1": {
        v0_2: _
        v0_1: {
            init: v0_2.init
            if (v0_2.optional != _|_) {
                optional: v0_2.optional
            }
        }
    }
    "0.3->0.2": {
        v0_3: _
        v0_2: {
            init: v0_3.init
            if (v0_3.optional != _|_) {
                optional: v0_3.optional
            }
            if v0_3.withDefault != _|_ {
                if v0_3.withDefault != "baz" {
                    withDefault: v0_3.withDefault
                }
                if v0_3.withDefault == "baz" {
                    // 0.2 has no "baz"; its default stands in for it.
                    withDefault: "foo"
                }
            }
        }
        lacunas: [
            thema.Lacuna & {
                condition: (v0_3.withDefault & "baz") != _|_
                sourceFields: [{path: "withDefault", value: v0_3.withDefault}]
                targetFields: [{path: "withDefault", value: v0_2.withDefault}]
                message: "withDefault was \"baz\", which 0.2 does not have; \"foo\", its default, was substituted"
                type:    thema.LacunaTypes.LossyFieldMapping
            },
        ]
    }
    "1.0->0.3": {
        v1_0: _
        v0_3: {
            init: v1_0.renamed
            if (v1_0.optional != _|_) {
                optional: v1_0.optional
            }
            // 1.0 defaults withDefault to "bar" and 0.3 to "foo": an instance
            // omitting it means "bar", which 0.3 must say outright.
            if v1_0.withDefault != "bar" {
                withDefault: v1_0.withDefault
            }
            if v1_0.withDefault == "bar" {
                withDefault: "bar"
            }
        }
    }
    "0.3->1.0": {
        v0_3: _
        v1_0: {
            renamed: v0_3.init
            if (v0_3.optional != _|_) {
                optional: v0_3.optional
            }
            if v0_3.withDefault != _|_ {
                withDefault: v0_3.withDefault
            }
            if v0_3.withDefault == _|_ {
                // absent in 0.3 means its default, "foo"; 1.0 defaults to "bar".
                withDefault: "foo"
            }
        }
    }
    "1.1->1.0": {
        v1_1: _
        v1_0: {
            renamed: v1_1.renamed
            if (v1_1.optional != _|_) {
                optional: v1_1.optional
            }
            if v1_1.withDefault != "bing" {
                withDefault: v1_1.withDefault
            }
            if v1_1.withDefault == "bing" {
                // 1.0 has no "bing"; its default stands in for it.
                withDefault: "bar"
            }
        }
        lacunas: [
            thema.Lacuna & {
                condition: v1_1.withDefault == "bing"
                sourceFields: [{path: "withDefault", value: v1_1.withDefault}]
                targetFields: [{path: "withDefault", value: v1_0.withDefault}]
                message: "withDefault was \"bing\", which 1.0 does not have; \"bar\", its default, was substituted"
                type:    thema.LacunaTypes.LossyFieldMapping
            },
        ]
    }
    "2.0->1.1": {
        v2_0: _
        v1_1: {
            renamed: v2_0.toObj.init
            if (v2_0.optional != _|_) {
                optional: v2_0.optional
            }
            withDefault: v2_0.withDefault
        }
    }
    "1.1->2.0": {
        v1_1: _
        v2_0: {
            toObj: {
                init: v1_1.renamed
            }
            if (v1_1.optional != _|_) {
                optional: v1_1.optional
            }
            withDefault: v1_1.withDefault
        }
    }
}
