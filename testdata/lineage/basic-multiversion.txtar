            init:        string
            optional?:   int32
            withDefault?: *"foo" | "bar" | "baz"
        }
        examples: {
            withoutOptional: {
                init: "some string"
                withDefault: "baz"
            }
            withOptional: {
                init: "some string"
                optional: 32
                withDefault: "baz"
            }
        }
    }
    "1": "0": {
        schema: {
            renamed:     string
            optional?:   int32
            withDefault: "foo" | *"bar" | "baz"
        }
        examples: {
            withoutOptional: {
