#firstLin: lin1
#secondLin: lin2
-- in.cue --
import "github.com/sdboyer/thema"

lin1: thema.Lineage
lin1: name: "noref"
lin1: schemas: {
	"0": "0": {
		schema: {
			someField: string
	
			#Baz: {
				run:  string
				tell: bytes
				dat:  int32
			}
		}
	}
}

lin2: thema.Lineage
lin2: name: "noref"
lin2: schemas: {
	"0": "0": {
	    schema: {
			someField: string
	
			#Baz: {
				run:  string
				tell: bytes
				dat?:  int32
			}
	    }
	}
}
