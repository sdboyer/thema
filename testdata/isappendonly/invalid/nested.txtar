#firstLin: lin1
#secondLin: lin2
-- in.cue --
import "github.com/sdboyer/thema"

lin1: thema.Lineage
lin1: name: "nested"
lin1: schemas: {
	"0": "0": {
		schema: {
			anObject: {
	            aField: string
	        }
		}
	}
}

lin2: thema.Lineage
lin2: name: "nested"
lin2: schemas: {
	"0": "0": {
	    schema: {
			anObject: {
	            aField: string
	            aNewOptionalField?: string
	        }
	    }
	}
}
