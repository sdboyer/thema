#firstLin: lin1
#secondLin: lin2
-- in.cue --
import "github.com/sdboyer/thema"

lin1: thema.Lineage
lin1: name: "defaultchange"
lin1: schemas: {
	"0": "0": {
		schema: {
			aunion: *"foo" | "bar" | "baz"
		}
	}
}

lin2: thema.Lineage
lin2: name: "defaultchange"
lin2: schemas: {
	"0": "0": {
	    schema: {
	        aunion: "foo" | *"bar" | "baz"
	    }
	}
}
