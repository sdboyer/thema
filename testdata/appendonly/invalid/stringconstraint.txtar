#firstLin: lin1
#secondLin: lin2
-- in.cue --
import (
	"strings"

	"github.com/sdboyer/thema"
)

lin1: thema.Lineage
lin1: name: "stringconstraint"
lin1: schemas: {
	"0": "0": {
		schema: {
			aString: string & strings.MinRunes(1)
			
			anObject: {
				aField: int
			}
		}
	}
}

lin2: thema.Lineage
lin2: name: "stringconstraint"
lin2: schemas: {
	"0": "0": {
		schema: {
			aString: string & strings.MinRunes(2)
			
			anObject: {
				aField: int
			}
		}
	}
}
-- out/appendonly-fail --
error[E0250]: schema 0.0 is not as published
  --> /in.cue:25:3
   |
25 |         schema: {
   |         ^^^^^^
   |
   = note: a published version never changes: instances were validated against it as it was published
   = help: restore schema 0.0 as it was published, and make the change in a new version
