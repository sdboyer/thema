-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "typo"
schemas: {
	"0": "0": {
		schema: {
			foo: string
		}
	}
	"1": "0": {
		schema: {
			bar: string
		}
	}
}
lenses: {
	"1.0->0.0": {
		v1_0: _
		reslt: {
			foo: v1_0.bar
		}
	}
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			bar: v0_0.foo
		}
	}
}
-- out/bindfail --
error[E0123]: reslt is not a field of a lens
  --> /in.cue:20:3
   |
20 |         reslt: {
   |         ^^^^^
   |
   = help: a lens has only lacunas, v0_0, v1_0
