-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "typo"
schemas: {
	"0": "0": {
		schema: {
			foo: string
		}
	}
	"1": "0": {
		schema: {
			bar: string
		}
	}
}
lenses: {
	"1.0->0.0": {
		input: _
		reslt: {
			foo: input.bar
		}
	}
	"0.0->1.0": {
		input: _
		result: {
			bar: input.foo
		}
	}
}
-- out/bindfail --
error[E0123]: reslt is not a field of a lens
  --> /in.cue:20:3
   |
20 |         reslt: {
   |         ^^^^^
   |
   = help: did you mean result?
