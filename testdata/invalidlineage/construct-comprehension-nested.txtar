# a comprehension nested in a sub-struct is found too; the top-level kind
# stays struct, so only this check catches it (#77)
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage & {
	name: "comprehensionNested"
	schemas: "0": "0": {
		schema: {
			a: int
			m: {
				kind: string
				if kind == "x" {
					extra?: int
				}
			}
		}
	}
}
-- out/bindfail --
error[E0132]: schema 0.0 uses a comprehension
  --> /in.cue:10:5
   |
10 |                 if kind == "x" {
   |                 ^^
   |
   = note: a schema's fields must be known without evaluating data: no check can describe a schema whose fields depend on evaluation
   = help: write the fields the comprehension would produce
