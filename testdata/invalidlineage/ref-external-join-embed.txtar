# the joinSchema embeds a hidden field declared outside it, at the top of the file: the file is the lineage, so what it declares beside the
# schemas is declared in the lineage outside the schema (rule ref-lineage-meta).
# Was testdata/lineage: joinSchema is a reference to an embedded struct
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "embedref"
joinSchema: {
    _EmbedRef
}
schemas: {
    "0": "0": {
    	schema: {
    		foo: string
    	}
    }
}
lenses: {}

_EmbedRef: {
	refField1: string
	refField2: 42
}
-- out/bindfail --
error[E0141]: joinSchema refers to _EmbedRef, which is declared in the lineage outside the joinSchema
 --> /in.cue:5:1
  |
5 | joinSchema: {
  | ^^^^^^^^^^
  |
  = note: reference rule ref-lineage-meta
  = help: a joinSchema may refer only to its own body and CUE's builtin packages
