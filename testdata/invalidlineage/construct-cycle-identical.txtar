# a recursive schema is refused even when identical across versions, and even
# though CUE validates and translates its instances: see #78 for why
#issue: 25
#lineagePath: lin
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "fpIdenticalRecursive"
	schemas: {
		"0": "0": {
			schema: {#Node: {v: int, next?: #Node}, root: #Node}
		}
		"0": "1": {
			schema: {#Node: {v: int, next?: #Node}, root: #Node}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: v0_1
		}
	}
}
-- out/bindfail --
error[E0133]: schema 0.0 has a reference cycle: #Node -> #Node
 --> /in.cue:9:29
  |
9 |             schema: {#Node: {v: int, next?: #Node}, root: #Node}
  |                                      ^^^^
  |
  = note: a schema's references may not form a cycle: no check can describe a schema whose paths are unbounded
