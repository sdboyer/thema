# a recursive schema is refused even when identical across versions, and even
# though CUE validates and translates its instances: see #78 for why
#issue: 25
#lineagePath: lin
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "fpIdenticalRecursive"
	schemas: {
		"0": "0": {
			schema: {#Node: {v: int, next?: #Node}, root: #Node}
		}
		"0": "1": {
			schema: {#Node: {v: int, next?: #Node}, root: #Node}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: input
		}
	}
}
-- out/bindfail --
schema 0.0: reference cycle #Node -> #Node; schemas may not contain circular references:
    ./in.cue:9:29
