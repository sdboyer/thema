# a JSON-like value type recurses through a list and a pattern (#78)
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage & {
	name: "cycleDisjunction"
	schemas: "0": "0": {
		schema: {
			#Value: string | [...#Value] | {[string]: #Value}
			v: #Value
		}
	}
}
-- out/bindfail --
error[E0133]: schema 0.0 has a reference cycle: #Value -> #Value
 --> /in.cue:7:25
  |
7 |             #Value: string | [...#Value] | {[string]: #Value}
  |                                  ^^^^^^
  |
  = note: a schema's references may not form a cycle: no check can describe a schema whose paths are unbounded
