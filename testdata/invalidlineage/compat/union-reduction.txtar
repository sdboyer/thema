# reducing the permitted options in a union/disjunction is backwards incompatible
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "unionReduction"
lin: schemas: {
    "0": "0": {
        schema: {
            concreteCross: "foo" | "bar" | 42
            concreteString: "foo" | "bar" | "baz"
            crossKind3: string | int32 | bytes
            crossKind2: string | int32
        }
    }
    "0": "1": {
        schema: {
            concreteCross: "foo" | 42
            concreteString: "foo" | "bar"
            crossKind3: string | int32
            crossKind2: string
        }
    }
}

lin: lenses: {
    "0.1->0.0": {
    	v0_1: _
    	v0_0: {
            concreteCross: v0_1.concreteCross
            concreteString: v0_1.concreteString
            crossKind3: v0_1.crossKind3
            crossKind2: v0_1.crossKind2
    	}
    }
}
-- out/bindfail --
error[E0215]: concreteCross in schema 0.1 is now "foo" | 42, which has no alternative for the prior "bar"
  --> /in.cue:17:13
   |
17 |             concreteCross: "foo" | 42
   |             ^^^^^^^^^^^^^
   |
   = note: schema 0.1 is declared as a minor version of 0.0, so every instance of schema 0.0 must be an instance of it (compatibility rule value-narrowed)
   = help: make the change compatible, or make this version 1.0

error[E0215]: concreteString in schema 0.1 is now "foo" | "bar", which has no alternative for the prior "baz"
  --> /in.cue:18:13
   |
18 |             concreteString: "foo" | "bar"
   |             ^^^^^^^^^^^^^^
   |
   = note: schema 0.1 is declared as a minor version of 0.0, so every instance of schema 0.0 must be an instance of it (compatibility rule value-narrowed)
   = help: make the change compatible, or make this version 1.0

error[E0215]: crossKind2 in schema 0.1 was int and is now string
  --> /in.cue:20:13
   |
20 |             crossKind2: string
   |             ^^^^^^^^^^
   |
   = note: schema 0.1 is declared as a minor version of 0.0, so every instance of schema 0.0 must be an instance of it (compatibility rule value-narrowed)
   = help: make the change compatible, or make this version 1.0

error[E0215]: crossKind3 in schema 0.1 is now string | int32, no alternative of which has the kind bytes of the prior alternative bytes
  --> /in.cue:19:13
   |
19 |             crossKind3: string | int32
   |             ^^^^^^^^^^
   |
   = note: schema 0.1 is declared as a minor version of 0.0, so every instance of schema 0.0 must be an instance of it (compatibility rule value-narrowed)
   = help: make the change compatible, or make this version 1.0
