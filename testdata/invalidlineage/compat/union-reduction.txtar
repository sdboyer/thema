# reducing the permitted options in a union/disjunction is backwards incompatible
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "unionReduction"
lin: schemas: {
    "0": "0": {
        schema: {
            concreteCross: "foo" | "bar" | 42
            concreteString: "foo" | "bar" | "baz"
            crossKind3: string | int32 | bytes
            crossKind2: string | int32
        }
    }
    "0": "1": {
        schema: {
            concreteCross: "foo" | 42
            concreteString: "foo" | "bar"
            crossKind3: string | int32
            crossKind2: string
        }
    }
}

lin: lenses: {
    "0.1->0.0": {
    	input: _
    	result: {
            concreteCross: input.concreteCross
            concreteString: input.concreteString
            crossKind3: input.crossKind3
            crossKind2: input.crossKind2
    	}
    }
}
-- out/bindfail --
schema 0.1 is not backwards compatible with schema 0.0:
concreteCross is now "foo" | 42, which has no alternative for the prior "bar" (rule value-narrowed):
    /in.cue:17:13
concreteString is now "foo" | "bar", which has no alternative for the prior "baz" (rule value-narrowed):
    /in.cue:18:13
crossKind3 is now string | int32, no alternative of which has the kind bytes of the prior alternative bytes (rule value-narrowed):
    /in.cue:19:13
crossKind2 was int and is now string (rule value-narrowed):
    /in.cue:20:13
