# adding a required field is a backwards incompatible change
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "addRequired"
lin: schemas: {
    "0": "0": {
        schema: {
            firstfield: string
        }
    }
    "0": "1": {
        schema: {
            firstfield: string
            added: int32
        }
    }
}

lin: lenses: {
    "0.1->0.0": {
    	input: _
    	result: {
    		firstfield: input.firstfield
    	}
    }
}
-- out/bindfail --
error[E0210]: added in schema 0.1 is required in the new schema but not declared in the prior one
  --> /in.cue:15:13
   |
15 |             added: int32
   |             ^^^^^
   |
   = note: schema 0.1 is declared as a minor version of 0.0, so every instance of schema 0.0 must be an instance of it (compatibility rule field-added-required)
   = help: make the change compatible, or make this version 1.0
