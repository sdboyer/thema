# adding a required field is a backwards incompatible change
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "addRequired"
lin: schemas: [{
    version: [0, 0]
    schema: {
        firstfield: string
    }
},
{
    version: [0, 1]
    schema: {
        firstfield: string
        added: int32
    }
}]

lin: lenses: [{
	from: [0, 1]
	to: [0, 0]
	input: _
	result: {
		firstfield: input.firstfield
	}
}]
-- out/bindfail --
schema 0.1 is not backwards compatible with schema 0.0:
added is required in the new schema but not declared in the prior one; prior instances that omit it are rejected (rule field-added-required):
    /in.cue:16:9
