# adding a required field is a backwards incompatible change
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "addRequired"
lin: schemas: {
    "0": "0": {
        schema: {
            firstfield: string
        }
    }
    "0": "1": {
        schema: {
            firstfield: string
            added: int32
        }
    }
}

lin: lenses: {
    "0.1->0.0": {
    	input: _
    	result: {
    		firstfield: input.firstfield
    	}
    }
}
-- out/bindfail --
schema 0.1 is not backwards compatible with schema 0.0:
regular field is constraint in subsumed value: added
value not an instance
