# adding a required field is a backwards incompatible change
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "addRequired"
lin: schemas: {
    "0": "0": {
        schema: {
            firstfield: string
        }
    }
    "0": "1": {
        schema: {
            firstfield: string
            added: int32
        }
    }
}

lin: lenses: {
    "0.1->0.0": {
    	v0_1: _
    	v0_0: {
    		firstfield: v0_1.firstfield
    	}
    }
}
-- out/bindfail --
error[E0210]: added in schema v0.1 is required in the new schema but not declared in the prior one
  --> /in.cue:15:13
   |
15 |             added: int32
   |             ^^^^^
   |
   = note: schema v0.1 is a minor version, so it must accept all data schema v0.0 accepts
   = help: make the change compatible, or make this version v1.0
