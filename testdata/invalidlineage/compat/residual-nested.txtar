# declaring, beneath a struct, a field the prior schema accepted through ... is a backwards incompatible change; the declaration the help offers is the field at the primary, by its own name
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "residualNested"
lin: schemas: {
    "0": "0": {
        schema: {
            meta: {
                owner: string
                ...
            }
        }
    }
    "0": "1": {
        schema: {
            meta: {
                owner: string
                size?: int
                ...
            }
        }
    }
}

lin: lenses: {
    "0.1->0.0": {
    	v0_1: _
    	v0_0: {
    		meta: owner: v0_1.meta.owner
    	}
    }
}
-- out/bindfail --
error[E0215]: meta.size in schema 0.1 is now int, which does not accept every value of the prior _
  --> /in.cue:19:17
   |
19 |                 size?: int
   |                 ^^^^
   |
   = note: schema 0.1 is a minor version, so it must accept all data schema 0.0 accepts
   = note: schema 0.0 does not declare meta.size by name, but accepts it through ... or a pattern, so an instance may already hold any value there
   = help: declare it as size?: _ to accept what 0.0 accepted, or make this version 1.0
