# removing a required field is a backwards incompatible change
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "removeRequired"
lin: schemas: [{
    version: [0, 0]
    schema: {
        firstfield: string
        getsRemoved: int32
    }
},
{
    version: [0, 1]
    schema: {
        firstfield: string
    }
}]

lin: lenses: [{
	from: [0, 1]
	to: [0, 0]
	input: _
	result: {
		firstfield: input.firstfield
		getsRemoved: 42
	}
}]
-- out/bindfail --
schema 0.1 is not backwards compatible with schema 0.0:
getsRemoved: old declares the field and new does not accept it [field-removed]; witness: an instance with getsRemoved set:
    /in.cue:10:9
