# removing a required field is a backwards incompatible change
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "removeRequired"
lin: schemas: {
    "0": "0": {
        schema: {
            firstfield: string
            getsRemoved: int32
        }
    }
    "0": "1": {
        schema: {
            firstfield: string
        }
    }
}

lin: lenses: {
    "0.1->0.0": {
    	v0_1: _
    	v0_0: {
    		firstfield: v0_1.firstfield
    		getsRemoved: 42
    	}
    }
}
-- out/bindfail --
error[E0211]: getsRemoved in schema 0.1 is declared in the prior schema and not accepted by the new one
  --> /in.cue:10:13
   |
10 |             getsRemoved: int32
   |             ^^^^^^^^^^^
   |
   = note: schema 0.1 is a minor version, so it must accept all data schema 0.0 accepts
   = help: make the change compatible, or make this version 1.0
