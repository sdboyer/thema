# removing a required field is a backwards incompatible change
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "removeRequired"
lin: schemas: {
    "0": "0": {
        schema: {
            firstfield: string
            getsRemoved: int32
        }
    }
    "0": "1": {
        schema: {
            firstfield: string
        }
    }
}

lin: lenses: {
    "0.1->0.0": {
    	input: _
    	result: {
    		firstfield: input.firstfield
    		getsRemoved: 42
    	}
    }
}
-- out/bindfail --
schema 0.1 is not backwards compatible with schema 0.0:
getsRemoved is declared in the prior schema and not accepted by the new one (rule field-removed):
    /in.cue:10:13
