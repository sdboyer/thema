# upgrading a field from optional to required is backwards incompatible
-- in.cue --

import "github.com/sdboyer/thema"

thema.Lineage
name: "optionalToRequired"
schemas: [{
    version: [0, 0]
    schema: {
        toUpgrade?: string
    }
},
{
    version: [0, 1]
    schema: {
        toUpgrade: string
    }
}]

lenses: [{
	from: [0, 1]
	to: [0, 0]
	input: _
	result: {
		toUpgrade: input.toUpgrade
	}
}]
-- out/bindfail --
schema 0.1 is not backwards compatible with schema 0.0:
field toUpgrade not present in {toUpgrade?:string}:
    /github.com/sdboyer/thema@v0.1.0/lineage.cue:227:11
missing field "toUpgrade"
