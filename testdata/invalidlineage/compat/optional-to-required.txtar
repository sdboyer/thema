# upgrading a field from optional to required is backwards incompatible
-- in.cue --

import "github.com/sdboyer/thema"

thema.Lineage
name: "optionalToRequired"
schemas: {
    "0": "0": {
        schema: {
            toUpgrade?: string
        }
    }
    "0": "1": {
        schema: {
            toUpgrade: string
        }
    }
}

lenses: {
    "0.1->0.0": {
    	v0_1: _
    	v0_0: {
    		toUpgrade: v0_1.toUpgrade
    	}
    }
}
-- out/bindfail --
schema 0.1 is not backwards compatible with schema 0.0:
toUpgrade was optional and is now required (rule field-now-required):
    /in.cue:14:13
