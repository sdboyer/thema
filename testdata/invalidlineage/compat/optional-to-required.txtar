# upgrading a field from optional to required is backwards incompatible
-- in.cue --

import "github.com/sdboyer/thema"

thema.Lineage
name: "optionalToRequired"
schemas: {
    "0": "0": {
        schema: {
            toUpgrade?: string
        }
    }
    "0": "1": {
        schema: {
            toUpgrade: string
        }
    }
}

lenses: {
    "0.1->0.0": {
    	input: _
    	result: {
    		toUpgrade: input.toUpgrade
    	}
    }
}
-- out/bindfail --
error[E0212]: toUpgrade in schema 0.1 was optional and is now required
  --> /in.cue:14:13
   |
14 |             toUpgrade: string
   |             ^^^^^^^^^
   |
   = note: schema 0.1 is declared as a minor version of 0.0, so every instance of schema 0.0 must be an instance of it (compatibility rule field-now-required)
   = help: make the change compatible, or make this version 1.0
