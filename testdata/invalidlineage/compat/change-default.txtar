# changing a default value is not backwards compatible
-- in.cue --

import "github.com/sdboyer/thema"

thema.Lineage
name: "changeDefault"
schemas: {
    "0": "0": {
		schema: {
		    aunion: *"foo" | "bar"
        }
    }
    "0": "1": {
		schema: {
		    aunion: *"foo" | "bar" | "baz"
        }
    }
    "0": "2": {
		schema: {
		    aunion: "foo" | "bar" | *"baz"
        }
    }
}

lenses: {
    "0.1->0.0": {
        input: _
        result: {
            aunion: input.aunion
        }
    }
    "0.2->0.1": {
        input: _
        result: {
            aunion: input.aunion
        }
    }
}
-- out/bindfail --
schema 0.2 is not backwards compatible with schema 0.1:
aunion fills with "baz" when absent, where the prior schema filled it with "foo" (rule default-changed):
    /in.cue:19:7
