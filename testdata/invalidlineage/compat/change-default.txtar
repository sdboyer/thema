# changing a default value is not backwards compatible
-- in.cue --

import "github.com/sdboyer/thema"

thema.Lineage
name: "changeDefault"
schemas: {
    "0": "0": {
		schema: {
		    aunion: *"foo" | "bar"
        }
    }
    "0": "1": {
		schema: {
		    aunion: *"foo" | "bar" | "baz"
        }
    }
    "0": "2": {
		schema: {
		    aunion: "foo" | "bar" | *"baz"
        }
    }
}

lenses: {
    "0.1->0.0": {
        input: _
        result: {
            aunion: input.aunion
        }
    }
    "0.2->0.1": {
        input: _
        result: {
            aunion: input.aunion
        }
    }
}
-- out/bindfail --
error[E0214]: aunion in schema 0.2 fills with "baz" when absent, where the prior schema filled it with "foo"
  --> /in.cue:19:7
   |
19 |             aunion: "foo" | "bar" | *"baz"
   |             ^^^^^^
   |
   = note: schema 0.2 is declared as a minor version of 0.1, so every instance of schema 0.1 must be an instance of it (compatibility rule default-changed)
   = help: make the change compatible, or make this version 1.0
