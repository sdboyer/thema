# adding an optional field is a backwards compatible change
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "addOptional"
lin: schemas: {
    "0": "0": {
        schema: {
            firstfield: string
        }
    }
    "1": "0": {
        schema: {
            firstfield: string
            getsAdded?: int32
        }
    }
}

lin: lenses: {
    "0.0->1.0": {
    	v0_0: _
    	v1_0: {
    		firstfield: v0_0.firstfield
    	}
    }
    "1.0->0.0": {
    	v1_0: _
    	v0_0: {
    		firstfield: v1_0.firstfield
    	}
    }
}
-- out/bindfail --
error[E0208]: schema 1.0 is backward compatible with 0.0, so it is not a major version
  --> /in.cue:13:9
   |
13 |         schema: {
   |         ^^^^^^
   |
   = help: declare it as version 0.1, or make a breaking change
