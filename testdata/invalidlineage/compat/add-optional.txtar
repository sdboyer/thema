# adding an optional field is a backwards compatible change
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "addOptional"
lin: schemas: {
    "0": "0": {
        schema: {
            firstfield: string
        }
    }
    "1": "0": {
        schema: {
            firstfield: string
            getsAdded?: int32
        }
    }
}

lin: lenses: {
    "0.0->1.0": {
    	v0_0: _
    	v1_0: {
    		firstfield: v0_0.firstfield
    	}
    }
    "1.0->0.0": {
    	v1_0: _
    	v0_0: {
    		firstfield: v1_0.firstfield
    	}
    }
}
-- out/bindfail --
schema 1.0 must be backwards incompatible with schema 0.0: introduce a breaking change, or redeclare as version 0.1
