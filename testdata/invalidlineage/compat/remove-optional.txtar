# removing an optional field is a backwards incompatible change
#lineagePath: lin
-- in.cue --

import "github.com/sdboyer/thema"

lin: thema.Lineage
lin: name: "removeOptional"
lin: schemas: {
    "0": "0": {
        schema: {
            firstfield: string
            getsRemoved?: int32
        }
    }
    "0": "1": {
        schema: {
            firstfield: string
        }
    }
}

lin: lenses: {
    "0.1->0.0": {
    	input: _
    	result: {
    		firstfield: input.firstfield
    	}
    }
}
-- out/bindfail --
error[E0211]: getsRemoved in schema 0.1 is declared in the prior schema and not accepted by the new one
  --> /in.cue:10:13
   |
10 |             getsRemoved?: int32
   |             ^^^^^^^^^^^
   |
   = note: schema 0.1 is declared as a minor version of 0.0, so every instance of schema 0.0 must be an instance of it (compatibility rule field-removed)
   = help: make the change compatible, or make this version 1.0
