# the joinSchema refers to a hidden field and a definition declared outside it, at the top of the file: the file is the lineage, so what it declares beside the
# schemas is declared in the lineage outside the schema (rule ref-lineage-meta).
# Was testdata/lineage: joinSchema contains references to external definitions
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "exref"
joinSchema: {
    ref: _ExRef
    refdef: #ExRefDef
}
schemas: {
    "0": "0": {
    	schema: {
    		foo: string
    	}
    }
}
lenses: {}

_ExRef: {
	normalField: string
}

#ExRefDef: {
	defField: string
}
-- out/bindfail --
error[E0141]: ref in joinSchema refers to _ExRef, which is declared in the lineage outside the joinSchema
 --> /in.cue:6:10
  |
6 |     ref: _ExRef
  |          ^^^^^^
  |
  = note: reference rule ref-lineage-meta
  = help: a joinSchema may refer only to its own body and CUE's builtin packages

error[E0141]: refdef in joinSchema refers to #ExRefDef, which is declared in the lineage outside the joinSchema
 --> /in.cue:7:13
  |
7 |     refdef: #ExRefDef
  |             ^^^^^^^^^
  |
  = note: reference rule ref-lineage-meta
  = help: a joinSchema may refer only to its own body and CUE's builtin packages
