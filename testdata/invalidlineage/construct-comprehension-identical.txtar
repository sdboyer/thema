# identical schemas with a conditional field: the comprehension is refused
# before the compatibility check ever sees it (#18, #77)
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage & {
	name: "comprehensionIdentical"
	schemas: "0": {
		"0": schema: {kind: string, if kind == "x" {extra?: int}}
		"1": schema: {kind: string, if kind == "x" {extra?: int}}
	}
	lenses: "0.1->0.0": {
		v0_1: _
		v0_0: v0_1
	}
}
-- out/bindfail --
error[E0132]: schema 0.0 uses a comprehension
 --> /in.cue:6:31
  |
6 |         "0": schema: {kind: string, if kind == "x" {extra?: int}}
  |                                     ^^
  |
  = note: a schema's fields must be known without evaluating data: no check can describe a schema whose fields depend on evaluation
  = help: write the fields the comprehension would produce
