# a definition that refers to itself is a reference cycle (#78)
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage & {
	name: "cycleDefinition"
	schemas: [{
		version: [0, 0]
		schema: {
			#N: {
				v:     int
				next?: #N
			}
			n: #N
		}
	}]
}
-- out/bindfail --
schema 0.0: reference cycle #N -> #N; schemas may not contain circular references:
    ./in.cue:10:5
