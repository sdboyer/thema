# a definition that refers to itself is a reference cycle (#78)
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage & {
	name: "cycleDefinition"
	schemas: "0": "0": {
		schema: {
			#N: {
				v:     int
				next?: #N
			}
			n: #N
		}
	}
}
-- out/bindfail --
error[E0133]: schema 0.0 has a reference cycle: #N -> #N
 --> /in.cue:9:5
  |
9 |                 next?: #N
  |                 ^^^^
  |
  = note: a schema's references may not form a cycle: no check can describe a schema whose paths are unbounded
