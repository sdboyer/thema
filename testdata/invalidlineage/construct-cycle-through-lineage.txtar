# a schema that refers to the lineage it belongs to refers, through it, to
# itself: the hazard in #21 is a reference cycle (#78)
#issue: 21
#lineagePath: lin
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "extOldDependsOnCount"
	schemas: {
		"0": "0": {
			schema: {n: <=len(lin.schemas)}
		}
		"0": "1": {
			schema: {n: <=len(lin.schemas), m?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {n: v0_1.n}
		}
	}
}
-- out/bindfail --
error[E0134]: schema 0.0 refers to schemas, which contains it
 --> /in.cue:7:22
  |
7 |             schema: {n: <=len(lin.schemas)}
  |                               ^^^
  |
  = note: a schema's references may not form a cycle: no check can describe a schema whose paths are unbounded
