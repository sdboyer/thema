# the joinSchema is checked like a schema (#77)
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage & {
	name: "comprehensionJoin"
	joinSchema: {
		kind: string
		if kind == "x" {
			extra?: int
		}
	}
	schemas: "0": "0": {
		schema: {a: int}
	}
}
-- out/bindfail --
error[E0132]: joinSchema uses a comprehension
 --> /in.cue:7:3
  |
7 |         if kind == "x" {
  |         ^^
  |
  = note: a schema's fields must be known without evaluating data: no check can describe a schema whose fields depend on evaluation
  = help: write the fields the comprehension would produce
