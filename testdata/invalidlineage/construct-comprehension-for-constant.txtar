# a for comprehension is not allowed in a schema even over constant data,
# though the evaluator expands it: the rule is syntactic (#77)
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage & {
	name: "comprehensionForConstant"
	schemas: "0": "0": {
		schema: {
			for k in ["a", "b"] {
				(k): int
			}
		}
	}
}
-- out/bindfail --
error[E0132]: schema 0.0 uses a comprehension
 --> /in.cue:7:4
  |
7 |             for k in ["a", "b"] {
  |             ^^^
  |
  = note: a schema's fields must be known without evaluating data: no check can describe a schema whose fields depend on evaluation
  = help: write the fields the comprehension would produce
