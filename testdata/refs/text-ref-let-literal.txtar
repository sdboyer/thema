#description: A schema in the text uses Kind, a let the text declares beside its schemas and binds to a literal. The let is declared in the lineage outside the schema, so this is ref-lineage-meta, as testdata/known/ref-lineage-let-literal.txtar records.
#expect: E0141
#spec: docs/invariants.md:116-118, docs/invariants.md:220
#at: lin.h
#known/together: #130 the evaluator substitutes a let bound to a literal, and the reference check does not compare the let's declaration position with the schema's span, so it sees a literal.
#known/compose: #130 the evaluator substitutes a let bound to a literal, and the reference check does not compare the let's declaration position with the schema's span, so it sees a literal.
-- in.cue --
import "github.com/sdboyer/thema"

lin: h: thema.Lineage & {name: "h"}
-- text.cue --
let Kind = "k"
schemas: "0": "0": schema: {a: string, kind: Kind}
-- out/compose/bind --
verdict: ok
-- out/together/bind --
verdict: ok
