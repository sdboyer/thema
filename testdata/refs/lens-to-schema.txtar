#description: The lens from 0.0 to 1.0 in the text takes its field's value from schema 0.0 instead of from the instance it takes. A lens referring to a schema of the lineage is ref-lens-to-schema.
#expect: E0144
#spec: docs/invariants.md:124-130, docs/invariants.md:223
#at: lin.h
-- in.cue --
import "github.com/sdboyer/thema"

lin: h: thema.Lineage & {name: "h"}
-- text.cue --
schemas: {
	"0": "0": schema: {a: string}
	"1": "0": schema: {b: string}
}
lenses: {
	"1.0->0.0": {v1_0: _, v0_0: {a: v1_0.b}}
	"0.0->1.0": {v0_0: _, v1_0: {b: schemas["0"]["0"].schema.a}}
}
-- out/compose/bind --
verdict: E0144
E0144 v1_0.b in lens 0.0->1.0 refers to schemas["0"]["0"].schema.a, a schema @ text.cue:7:34
-- out/together/bind --
verdict: E0144
E0144 v1_0.b in lens 0.0->1.0 refers to schemas["0"]["0"].schema.a, a schema @ /m/text.cue:8:34
