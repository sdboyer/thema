#description: A definition holds the lineage, and a schema in the text refers to another field of the same schema. A schema may refer to its own body wherever the lineage is held; this is the case #265 broke.
#expect: ok
#spec: docs/invariants.md:116-118, docs/invariants.md:143-148
#at: lin.h
-- in.cue --
import "github.com/sdboyer/thema"

#Op: h: thema.Lineage & {name: "h"}
lin: #Op
-- text.cue --
schemas: "0": "0": schema: {a?: string, b?: a}
-- out/compose/bind --
verdict: ok
-- out/together/bind --
verdict: ok
