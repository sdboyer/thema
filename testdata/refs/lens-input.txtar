#description: Each lens in the text refers to the instance it takes (v1_0.b, v0_0.a). A lens may refer to the instance it takes.
#expect: ok
#spec: docs/invariants.md:124-130
#at: lin.h
-- in.cue --
import "github.com/sdboyer/thema"

lin: h: thema.Lineage & {name: "h"}
-- text.cue --
schemas: {
	"0": "0": schema: {a: string}
	"1": "0": schema: {b: string}
}
lenses: {
	"1.0->0.0": {v1_0: _, v0_0: {a: v1_0.b}}
	"0.0->1.0": {v0_0: _, v1_0: {b: v0_0.a}}
}
-- out/fill-text-named/bind --
verdict: ok
-- out/fill-text/bind --
verdict: ok
-- out/fill-use/bind --
verdict: ok
-- out/third-root/bind --
verdict: ok
-- out/together/bind --
verdict: ok
-- out/unify-text-use/bind --
verdict: ok
-- out/unify-use-text/bind --
verdict: ok
