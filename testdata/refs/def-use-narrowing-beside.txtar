#description: A definition holds the lineage and narrows its joinSchema with #J, declared beside the use; the text declares only the schemas. This is #260's own case: a narrowing may refer outside the lineage.
#expect: ok
#spec: docs/invariants.md:162-176
#at: lin.h
-- in.cue --
import "github.com/sdboyer/thema"

#J: {[string]: string, ...}
#Op: h: thema.Lineage & {name: "h", joinSchema: #J}
lin: #Op
-- text.cue --
schemas: "0": "0": schema: {a?: string}
-- out/compose/bind --
verdict: ok
-- out/together/bind --
verdict: ok
