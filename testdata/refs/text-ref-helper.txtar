#description: A schema in the text refers to _x, a hidden helper field the text declares beside its schemas. A helper declared in the lineage outside the schema is ref-lineage-meta.
#expect: E0141
#spec: docs/invariants.md:116-118, docs/invariants.md:220
#at: lin.h
-- in.cue --
import "github.com/sdboyer/thema"

lin: h: thema.Lineage & {name: "h"}
-- text.cue --
name: "h"
_x: string
schemas: "0": "0": schema: {a?: _x}
-- out/compose/bind --
verdict: E0141
E0141 a in schema 0.0 refers to _x, which is declared in the lineage outside the schema @ text.cue:3:33
-- out/together/bind --
verdict: E0141
E0141 a in schema 0.0 refers to _x, which is declared in the lineage outside the schema @ /m/text.cue:4:33
