#description: A schema in the text refers to the lineage's name, which the text declares beside its schemas. A schema may refer only to its own body, so this is ref-lineage-meta.
#expect: E0141
#spec: docs/invariants.md:116-118, docs/invariants.md:220
#at: lin.h
-- in.cue --
import "github.com/sdboyer/thema"

lin: h: thema.Lineage & {name: "h"}
-- text.cue --
name: "h"
schemas: "0": "0": schema: {a?: string, n?: name}
-- out/compose/bind --
verdict: E0141
E0141 n in schema 0.0 refers to name, which is declared in the lineage outside the schema @ text.cue:2:45
-- out/together/bind --
verdict: E0141
E0141 n in schema 0.0 refers to name, which is declared in the lineage outside the schema @ /m/text.cue:3:45
