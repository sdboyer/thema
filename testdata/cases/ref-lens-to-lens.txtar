# a lens reads a hidden field of another lens through the lineage: a lens may
# refer only to input, its own body and CUE's builtin packages (rule
# ref-lens-to-lens). Each lens declares what it needs.
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "refLensToLens"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"1": "0": {
			schema: {b: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			input: _
			_fallback: "x"
			result: {a: input.b}
		}
		"0.0->1.0": {
			input: _
			result: {b: lin.lenses["1.0->0.0"]._fallback}
		}
	}
}
-- expect --
bind fail ref-lens-to-lens
