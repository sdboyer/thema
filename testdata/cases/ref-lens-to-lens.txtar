# a lens reads a hidden field of another lens through the lineage: a lens may
# refer only to the instance it takes, its own body and CUE's builtin packages
# (rule ref-lens-to-lens). Each lens declares what it needs.
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "refLensToLens"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"1": "0": {
			schema: {b: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			v1_0: _
			_fallback: "x"
			v0_0: {a: v1_0.b}
		}
		"0.0->1.0": {
			v0_0: _
			v1_0: {b: lin.lenses["1.0->0.0"]._fallback}
		}
	}
}
-- expect --
bind fail ref-lens-to-lens
