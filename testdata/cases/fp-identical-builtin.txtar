# identical strings.MinRunes(1) in both versions is judged backwards incompatible
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
	"strings"
)

lin: thema.Lineage & {
	name: "fpIdenticalBuiltin"
	schemas: {
		"0": "0": {
			schema: {a: strings.MinRunes(1)}
		}
		"0": "1": {
			schema: {a: strings.MinRunes(1), b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {a: v0_1.a}
		}
	}
}
-- expect --
bind ok
translate 0.0 0.1 ok {a: "x"}
