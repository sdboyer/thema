# a lens builds the field it returns from another lens, read through the
# lineage, rather than from the instance it takes: a lens may refer only to the
# instance it takes, its own body and CUE's builtin packages (rule
# ref-lens-to-lens), and the reference check runs before the totality check,
# so that is what is reported. Were the reference allowed, the lens would fail
# totality too: the lens it reads constrains the field it takes with a default
# (rule source-constrained), and what the reading lens would see is that
# disjunction, not a value.
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensResultDependsOnOtherLens"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"1": "0": {
			schema: {b: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			v1_0: {b: *"default-from-lens-v1_0" | string}
			v0_0: {a: v1_0.b}
		}
		"0.0->1.0": {
			v0_0: _
			v1_0: {b: lin.lenses["1.0->0.0"].v0_0.a}
		}
	}
}
-- expect --
bind fail ref-lens-to-lens
