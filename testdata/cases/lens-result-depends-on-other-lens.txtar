# lens result is read from another lens (via the lineage path) rather than from
# its own input: that lens constrains the field it takes with a default, which is refused
# on its own; what the reading lens would see is that disjunction, not a value
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensResultDependsOnOtherLens"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"1": "0": {
			schema: {b: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			v1_0: {b: *"default-from-lens-v1_0" | string}
			v0_0: {a: v1_0.b}
		}
		"0.0->1.0": {
			v0_0: _
			v1_0: {b: lin.lenses["1.0->0.0"].v0_0.a}
		}
	}
}
-- expect --
bind fail source-constrained
