# lens result is read from another lens (via the lineage path) rather than from
# its own input: a lens may refer only to input, its own body and CUE's builtin
# packages (rule ref-lens-to-lens). What it reads is that lens's input default,
# a disjunction, not a value; the reference rule reports the cause.
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensResultDependsOnOtherLens"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"1": "0": {
			schema: {b: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			input: {b: *"default-from-lens-input" | string}
			result: {a: input.b}
		}
		"0.0->1.0": {
			input: _
			result: {b: lin.lenses["1.0->0.0"].result.a}
		}
	}
}
-- expect --
bind fail ref-lens-to-lens
