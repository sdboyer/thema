# a schema selects a field of the lineage by a label only an instance decides:
# CUE leaves the selection pending, and thema cannot tell from the schema what
# the reference denotes (rule ref-unresolved). A label the evaluator can fold
# (lin["na"+"me"]) is lin.name, a reference to the lineage (ref-lineage-meta);
# either way the schema writes the literal it wants.
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "refUnresolved"
	schemas: {
		"0": "0": {
			schema: {a: string, n: lin[a]}
		}
	}
}
-- expect --
bind fail ref-unresolved
