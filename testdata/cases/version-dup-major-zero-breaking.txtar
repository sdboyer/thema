# version [0, 0] is declared twice, the second a breaking change
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionDupMajorZeroBreaking"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [0, 0]
		schema: {a: string}
	}]
	lenses: [{
		from: [0, 0]
		to: [0, 0]
		input: _
		result: {a: 1}
	}]
}
-- expect --
bind fail
