# versions skip a major: [0, 0] then [2, 0]
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionSkipMajor"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [2, 0]
		schema: {a: string}
	}]
	lenses: [{
		from: [2, 0]
		to: [0, 0]
		input: _
		result: {a: 0}
	}, {
		from: [0, 0]
		to: [2, 0]
		input: _
		result: {a: "x"}
	}]
}
-- expect --
bind fail
