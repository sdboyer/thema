# versions skip a major: [0, 0] then [2, 0]
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionSkipMajor"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"2": "0": {
			schema: {a: string}
		}
	}
	lenses: {
		"2.0->0.0": {
			v2_0: _
			v0_0: {a: 0}
		}
		"0.0->2.0": {
			v0_0: _
			v2_0: {a: "x"}
		}
	}
}
-- expect --
bind fail schema version 2.0 does not follow 0.0
