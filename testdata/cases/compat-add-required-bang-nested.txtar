# minor bump adds a nested required (!) field; {n: {a: "x"}} was valid at 0.0 and is invalid at 0.1
#issue: 17
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "compatAddRequiredBangNested"
	schemas: {
		"0": "0": {
			schema: {n!: {a!: string}}
		}
		"0": "1": {
			schema: {n!: {a!: string, b!: int}}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {n: a: v0_1.n.a}
		}
	}
}
-- expect --
bind fail
