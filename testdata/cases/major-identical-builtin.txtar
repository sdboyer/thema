# major bump identical to its predecessor (strings.MinRunes) is accepted as breaking
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
	"strings"
)

lin: thema.Lineage & {
	name: "majorIdenticalBuiltin"
	schemas: [{
		version: [0, 0]
		schema: {a: strings.MinRunes(1)}
	}, {
		version: [1, 0]
		schema: {a: strings.MinRunes(1)}
	}]
	lenses: [{
		from: [1, 0]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}, {
		from: [0, 0]
		to: [1, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind fail
