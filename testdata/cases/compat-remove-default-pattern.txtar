# minor bump removes a default in pattern-constrained map values; {m: {k: {}}} was valid at 0.0 and is invalid at 0.1
#issue: 17
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "compatRemoveDefaultPattern"
	schemas: {
		"0": "0": {
			schema: {m: [string]: {a: *1 | int}}
		}
		"0": "1": {
			schema: {m: [string]: {a: int}}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: v0_1
		}
	}
}
-- expect --
bind fail
