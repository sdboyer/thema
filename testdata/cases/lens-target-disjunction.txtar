# the disjunct exemplar: schemas whose top field is a disjunction of structs
# discriminated by a constant, where 0.1 adds a third alternative. The lens back
# to 0.0 copies branches 1 and 2 through and maps branch 3, which 0.0 has no
# correspondence for, to branch 1 with a filler value, declaring the loss.
#
# The lens is total: every 0.1 instance has exactly one branch, each arm writes
# rootfield once, and each result is an instance of 0.0. thema shows it: the
# equality on rootfield.branch in each arm refines the alternatives of the
# copied rootfield to the one whose branch it names, which the matching 0.0
# alternative accepts; the branch-3 arm's struct literal is proven against the
# 0.0 alternative its constant branch selects; and the three equalities cover
# the source's constant branches (#121).
#issue: 121
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "disjunct"
	schemas: {
		"0": "0": {
			schema: {
				rootfield: {
					branch:    1
					branchone: string
				} | {
					branch:    2
					branchtwo: string
				}
			}
		}
		"0": "1": {
			schema: {
				rootfield: {
					branch:    1
					branchone: string
				} | {
					branch:    2
					branchtwo: string
				} | {
					branch: 3
					branchthree: {
						branchthreeinner: int
					} | {
						branchthreeinner: string
					}
				}
			}
		}
	}

	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {
				// Branches 1 and 2 are unchanged: copy them through.
				if v0_1.rootfield.branch == 1 {
					rootfield: v0_1.rootfield
				}
				if v0_1.rootfield.branch == 2 {
					rootfield: v0_1.rootfield
				}
				// Branch 3 has no correspondence in 0.0: fall back to branch 1
				// with a filler value, and say so with the lacuna below.
				if v0_1.rootfield.branch == 3 {
					rootfield: {
						branch:    1
						branchone: "wasthree"
					}
				}
			}
			lacunas: [
				thema.Lacuna & {
					condition: v0_1.rootfield.branch == 3
					sourceFields: [{
						path:  "rootfield"
						value: v0_1.rootfield
					}]
					targetFields: [{
						path:  "rootfield"
						value: v0_0.rootfield
					}]
					message: "rootfield was branch 3, which 0.0 does not have; branch 1 with branchone \"wasthree\" was substituted"
					type:    thema.LacunaTypes.LossyFieldMapping
				},
			]
		}
	}
}
-- expect --
bind ok
translate 0.1 0.0 ok {rootfield: {branch: 1, branchone: "a"}}
translate 0.1 0.0 ok {rootfield: {branch: 2, branchtwo: "b"}}
translate 0.1 0.0 ok {rootfield: {branch: 3, branchthree: {branchthreeinner: 5}}}
translate 0.1 0.0 ok {rootfield: {branch: 3, branchthree: {branchthreeinner: "s"}}}
translate 0.0 0.1 ok {rootfield: {branch: 1, branchone: "a"}}
translate 0.0 0.1 ok {rootfield: {branch: 2, branchtwo: "b"}}
