# the disjunct exemplar: schemas whose top field is a disjunction of structs
# discriminated by a constant, where 0.1 adds a third alternative. The lens back
# to 0.0 copies branches 1 and 2 through and maps branch 3, which 0.0 has no
# correspondence for, to branch 1 with a filler value, declaring the loss.
#
# The lens is total: every 0.1 instance has exactly one branch, each arm writes
# rootfield once, and each result is an instance of 0.0 (checked by evaluating
# the lens against an instance of each alternative). thema cannot show it: the
# checker descends into the target only through a single struct or list, so the
# branch-3 fallback, a struct literal written beneath a disjunction in the target
# schema, is unknown-target-constraint, and a copy of the whole of rootfield is
# judged against the target disjunction alternative by alternative without the
# arm's equality on rootfield.branch narrowing the parent, so the branch-3
# alternative is still among what is copied (copy-narrowed). The lineage lived
# in exemplars until the totality check was enforced there (#87); #121 is the
# checker work (descent beneath a disjunctive target, child-path refinement)
# after which it binds and returns to exemplars.
#issue: 121
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "disjunct"
	schemas: {
		"0": "0": {
			schema: {
				rootfield: {
					branch:    1
					branchone: string
				} | {
					branch:    2
					branchtwo: string
				}
			}
		}
		"0": "1": {
			schema: {
				rootfield: {
					branch:    1
					branchone: string
				} | {
					branch:    2
					branchtwo: string
				} | {
					branch: 3
					branchthree: {
						branchthreeinner: int
					} | {
						branchthreeinner: string
					}
				}
			}
		}
	}

	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {
				// Branches 1 and 2 are unchanged: copy them through.
				if v0_1.rootfield.branch == 1 {
					rootfield: v0_1.rootfield
				}
				if v0_1.rootfield.branch == 2 {
					rootfield: v0_1.rootfield
				}
				// Branch 3 has no correspondence in 0.0: fall back to branch 1
				// with a filler value, and say so with the lacuna below.
				if v0_1.rootfield.branch == 3 {
					rootfield: {
						branch:    1
						branchone: "wasthree"
					}
				}
			}
			lacunas: [
				thema.Lacuna & {
					condition: v0_1.rootfield.branch == 3
					sourceFields: [{
						path:  "rootfield"
						value: v0_1.rootfield
					}]
					targetFields: [{
						path:  "rootfield"
						value: v0_0.rootfield
					}]
					message: "rootfield was branch 3, which 0.0 does not have; branch 1 with branchone \"wasthree\" was substituted"
					type:    thema.LacunaTypes.LossyFieldMapping
				},
			]
		}
	}
}
-- expect --
bind fail unknown-target-constraint
