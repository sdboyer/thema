# a field referring to a hidden helper holds what the helper holds, not a copy: only references into input copy
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensHiddenReferenced"
	schemas: [{
		version: [0, 0]
		schema: {a: string, x?: {...}}
	}, {
		version: [0, 1]
		schema: {a: string, x?: {...}, b?: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {
			a: input.a
			_h: {extra: 2}
			x: _h
		}
	}]
}
-- expect --
bind fail x.extra
