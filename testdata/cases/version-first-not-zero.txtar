# the first schema is declared [0, 1] rather than [0, 0]
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionFirstNotZero"
	schemas: {
		"0": "1": {
			schema: {a: int}
		}
	}
	lenses: {}
}
-- expect --
bind fail the first schema is version 0.1, not 0.0
