# an instance valid only via a schema default cannot be translated: lenses see the raw input, without defaults
#issue: 24
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "validateDefaultThenTranslate"
	schemas: {
		"0": "0": {
			schema: {a: *"x" | string}
		}
		"0": "1": {
			schema: {a: *"x" | string, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {a: v0_1.a}
		}
	}
}
-- expect --
translate 0.1 0.0 ok {}
