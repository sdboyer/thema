# a lens's input and lacunas are covered by its digest as its result is, so
# neither may declare a hidden field (#250)
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "lensHiddenInputLacuna"
	schemas: {
		"0": "0": {schema: {a: string}}
		"1": "0": {schema: {b: string}}
	}
	lenses: {
		"0.0->1.0": {
			v0_0: {_seen: true, ...}
			v1_0: {b: v0_0.a}
			lacunas: [{
				_why: "renamed"
				sourceFields: [{path: "a", value: v0_0.a}]
				message: "a is renamed b"
				type:    "DroppedField"
			}]
		}
		"1.0->0.0": {
			v1_0: _
			v0_0: {a: v1_0.b}
		}
	}
}
-- expect --
bind fail the input of lens 0.0->1.0 declares _seen, a hidden field
bind fail lens 0.0->1.0 declares _why, a hidden field in its lacunas
