# adding a definition, a helper invisible to data, is backwards compatible. #18
# found this for a hidden field, which a schema may no longer declare (#250).
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "fpDefinitionAdded"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"0": "1": {
			schema: {a: int, #H: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {a: v0_1.a}
		}
	}
}
-- expect --
bind ok
translate 0.0 0.1 ok {a: 1}
