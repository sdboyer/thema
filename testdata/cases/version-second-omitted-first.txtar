# first schema omits its version (defaulting to [0, 0]) and the second declares [0, 0] too
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionSecondOmittedFirst"
	schemas: [{
		schema: {a: int}
	}, {
		version: [0, 0]
		schema: {a: int, b: string}
	}]
}
-- expect --
bind fail
