# versions skip a minor: [0, 0] then [0, 2]
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionSkipMinor"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"0": "2": {
			schema: {a: int, b?: int}
		}
	}
	lenses: {
		"0.2->0.0": {
			input: _
			result: {a: input.a}
		}
	}
}
-- expect --
bind fail schema version 0.2 does not follow 0.0
