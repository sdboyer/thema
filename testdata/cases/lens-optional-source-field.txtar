# lens maps a required target field from an optional source field, so it is
# undefined when that field is absent
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensOptionalSourceField"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"1": "0": {
			schema: {b: string, c?: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			v1_0: _
			v0_0: {a: v1_0.c}
		}
		"0.0->1.0": {
			v0_0: _
			v1_0: {b: v0_0.a}
		}
	}
}
-- expect --
bind fail source-absent
