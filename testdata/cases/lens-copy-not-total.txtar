# a lens copying from a source's ... into a destination the target types can't
# translate every valid source instance: the copy is narrowed
#issue: 46
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensCopyNotTotal"
	schemas: {
		"0": "0": {
			schema: {a: string, ...}
		}
		"1": "0": {
			schema: {a: string, zzz?: string, ...}
		}
	}
	lenses: {
		"1.0->0.0": {
			v1_0: _, v0_0: {a: v1_0.a}
		}
		"0.0->1.0": {
			v0_0: _, v1_0: v0_0
		}
	}
}
-- expect --
bind fail copy-narrowed
