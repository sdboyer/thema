# the lens for step 0.1 -> 0.0 is declared twice. Lenses are keyed by edge, so
# the two declarations unify into one lens, as any CUE field does: neither is
# ignored, and the unified result {a: input.a & 1000} fails for any other a.
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensDuplicate"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"0": "1": {
			schema: {a: int, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: {a: input.a}
		}
		"0.1->0.0": {
			input: _
			result: {a: 1000}
		}
	}
}
-- expect --
bind ok
translate 0.1 0.0 ok {a: 1000}
translate 0.1 0.0 fail {a: 5}
