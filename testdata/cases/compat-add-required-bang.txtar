# minor bump adds a required (!) field; {a: "x"} was valid at 0.0 and is invalid at 0.1
#issue: 17
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "compatAddRequiredBang"
	schemas: [{
		version: [0, 0]
		schema: {a!: string}
	}, {
		version: [0, 1]
		schema: {a!: string, b!: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind fail
