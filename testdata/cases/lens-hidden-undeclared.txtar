# a lens may keep scratch in hidden fields beside its result, plain or built
# inside a comprehension: they are not output, and no digest covers them
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensHiddenUndeclared"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"0": "1": {
			schema: {a: string, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			_h: {extra: 2}
			_c: {if v0_1.a == "boom" {extra: 2}}
			v0_0: {a: v0_1.a}
		}
	}
}
-- expect --
bind ok
translate 0.1 0.0 ok {a: "boom"}
