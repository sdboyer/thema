# a lens may build an undeclared hidden field: hidden fields are not output, and closedness doesn't apply to them
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensHiddenUndeclared"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"0": "1": {
			schema: {a: string, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: {a: input.a, _h: {extra: 2}}
		}
	}
}
-- expect --
bind ok
translate 0.1 0.0 ok {a: "boom"}
