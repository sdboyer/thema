# a lens writes a field under a condition on the instance it takes, and the
# field's value refers outside the lineage (rule ref-outside-lineage). While
# the instance is unknown the comprehension is pending, and nothing it tests or
# declares is part of the lens's value; it is read from the lens's syntax.
#issue: 119
-- in.cue --
import "github.com/sdboyer/thema"

_fallbacks: {c: "none"}

lin: thema.Lineage & {
	name: "refLensComprehensionOutside"
	schemas: {
		"0": "0": {
			schema: {a: string, k?: string}
		}
		"1": "0": {
			schema: {b: string, c?: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			v1_0: _
			v0_0: {a: v1_0.b}
		}
		"0.0->1.0": {
			v0_0: _
			v1_0: {
				b: v0_0.a
				if v0_0.k != _|_ {
					c: _fallbacks.c
				}
			}
		}
	}
}
-- expect --
bind fail ref-outside-lineage
