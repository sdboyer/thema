# identical schema using a let binding is judged backwards incompatible
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "fpIdenticalLet"
	schemas: {
		"0": "0": {
			schema: {let T = int, a: T}
		}
		"0": "1": {
			schema: {let T = int, a: T}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: v0_1
		}
	}
}
-- expect --
bind ok
translate 0.0 0.1 ok {a: 1}
