# identical struct.MinFields(1) in both versions is judged backwards incompatible
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
	"struct"
)

lin: thema.Lineage & {
	name: "fpIdenticalStructMinfields"
	schemas: {
		"0": "0": {
			schema: {m: struct.MinFields(1) & {[string]: int}}
		}
		"0": "1": {
			schema: {m: struct.MinFields(1) & {[string]: int}}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: v0_1
		}
	}
}
-- expect --
bind ok
translate 0.0 0.1 ok {m: {a: 1}}
