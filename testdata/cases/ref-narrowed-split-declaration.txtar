# a lineage declared in two structs unified with thema.Lineage, one of them
# holding the joinSchema: neither is a lineage until they are unified, so the
# joinSchema is the lineage's own text and narrows nothing (rule
# ref-outside-lineage)
#issue: 238
-- in.cue --
import "github.com/sdboyer/thema"

#Outside: {authorization?: string, ...}
lin: thema.Lineage & {joinSchema: #Outside} & {
	name: "request_headers"
	schemas: "0": "0": schema: authorization?: =~"^Bearer "
}
-- expect --
bind fail error[E0142]: joinSchema refers to #Outside
