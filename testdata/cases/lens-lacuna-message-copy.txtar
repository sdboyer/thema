# a lacuna message copies an integer where thema requires a string
#issue: 107
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "lensLacunaMessageCopy"
	schemas: {
		"0": "0": {schema: {a!: int}}
		"1": "0": {schema: {b!: int}}
	}
	lenses: {
		"0.0->1.0": {
			v0_0: _
			v1_0: {b: v0_0.a}
			lacunas: [{
				sourceFields: [{path: "a", value: v0_0.a}]
				message: v0_0.a
				type:    "DroppedField"
			}]
		}
		"1.0->0.0": {
			v1_0: _
			v0_0: {a: v1_0.b}
		}
	}
}
-- expect --
bind fail copy-narrowed
