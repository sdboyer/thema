# explicit forward lens across a minor step; it is silently ignored in favor of the implicit one
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensExplicitForwardMinor"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [0, 1]
		schema: {a: int, b?: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}, {
		from: [0, 0]
		to: [0, 1]
		input: _
		result: {a: input.a, b: 42}
	}]
}
-- expect --
bind fail
