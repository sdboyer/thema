# minor bump removes a default in list elements; {l: [{}]} was valid at 0.0 and is invalid at 0.1
#issue: 17
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "compatRemoveDefaultListElem"
	schemas: {
		"0": "0": {
			schema: {l: [...{a: *1 | int}]}
		}
		"0": "1": {
			schema: {l: [...{a: int}]}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: {l: input.l}
		}
	}
}
-- expect --
bind fail
