# without ..., adding an optional field is compatible: versioning assumes undeclared fields are absent (see #48)
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "compat-closed-add-optional"
	schemas: [{
		version: [0, 0]
		schema: {a: string}
	}, {
		version: [0, 1]
		schema: {a: string, zzz?: string}
	}]
	lenses: [{from: [0, 1], to: [0, 0], input: _, result: {a: input.a}}]
}
-- expect --
bind ok
