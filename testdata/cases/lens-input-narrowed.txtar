# lens input is narrowed, so the lens is undefined for most valid source instances
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensInputNarrowed"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"0": "1": {
			schema: {a: string, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: {a: "only-this"}
			v0_0: {a: v0_1.a}
		}
	}
}
-- expect --
bind fail
