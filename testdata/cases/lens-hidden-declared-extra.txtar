# a schema may not declare a hidden field (#250), so there is none for a lens
# to write beneath: the lineage is refused at the schema, not at the lens
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensHiddenDeclaredExtra"
	schemas: {
		"0": "0": {
			schema: {a: string, _h: {k: int}}
		}
		"0": "1": {
			schema: {a: string, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {a: v0_1.a, _h: {k: 1, extra: 2}}
		}
	}
}
-- expect --
bind fail E0151
