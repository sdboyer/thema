# beneath a hidden field the target declares, a lens may build only what it declares
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensHiddenDeclaredExtra"
	schemas: {
		"0": "0": {
			schema: {a: string, _h: {k: int}}
		}
		"0": "1": {
			schema: {a: string, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: {a: input.a, _h: {k: 1, extra: 2}}
		}
	}
}
-- expect --
bind fail _h.extra
