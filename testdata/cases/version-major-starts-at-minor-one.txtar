# a new major starts at [1, 1], with no [1, 0]
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionMajorStartsAtMinorOne"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"1": "1": {
			schema: {a: int, b?: int}
		}
	}
	lenses: {
		"1.1->0.0": {
			input: _
			result: {a: input.a}
		}
	}
}
-- expect --
bind fail schema version 1.1 does not follow 0.0
