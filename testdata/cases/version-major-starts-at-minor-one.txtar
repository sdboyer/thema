# a new major starts at [1, 1], with no [1, 0]
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionMajorStartsAtMinorOne"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"1": "1": {
			schema: {a: int, b?: int}
		}
	}
	lenses: {
		"1.1->0.0": {
			v1_1: _
			v0_0: {a: v1_1.a}
		}
	}
}
-- expect --
bind fail schema version 1.1 does not follow 0.0: the next schema must be version 0.1 or 1.0
