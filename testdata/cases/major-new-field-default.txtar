# major bump that only adds a defaulted field (every 0.0 instance still valid) is accepted as breaking
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "majorNewFieldDefault"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"1": "0": {
			schema: {a: int, b: *1 | int}
		}
	}
	lenses: {
		"1.0->0.0": {
			v1_0: _
			v0_0: {a: v1_0.a}
		}
		"0.0->1.0": {
			v0_0: _
			v1_0: {a: v0_0.a}
		}
	}
}
-- expect --
bind fail
