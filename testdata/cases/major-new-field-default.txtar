# major bump that only adds a defaulted field (every 0.0 instance still valid) is accepted as breaking
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "majorNewFieldDefault"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [1, 0]
		schema: {a: int, b: *1 | int}
	}]
	lenses: [{
		from: [1, 0]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}, {
		from: [0, 0]
		to: [1, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind fail
