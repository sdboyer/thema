# the lens gives its input a default: input must be _, so that the source schema
# alone says what the lens receives
# #issue: 107
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "lensInputDefaulted"
	schemas: {
		"0": "0": {schema: {a: *"x" | string}}
		"1": "0": {schema: {b!: string}}
	}
	lenses: {
		"0.0->1.0": {
			input: {a: *"y" | string}
			result: {b: input.a}
		}
		"1.0->0.0": {
			input: _
			result: {a: input.b}
		}
	}
}
-- expect --
bind fail input-constrained
