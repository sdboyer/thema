# adding a definition used as a field type (same type) is judged backwards incompatible
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "fpDefAdded"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [0, 1]
		schema: {#T: int, a: #T}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind ok
translate 0.0 0.1 ok {a: 1}
