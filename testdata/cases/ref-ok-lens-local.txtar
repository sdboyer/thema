# a lens's own body is input, result, lacunas and anything declared inside the
# lens: a let, a hidden field and a field alias (visible within the struct that
# declares it) are all fine to refer to, and so is thema's own package
# (thema.Lacuna, thema.LacunaTypes), which is part of the substrate
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "refOkLensLocal"
	schemas: {
		"0": "0": {
			schema: {a: string, n: int}
		}
		"1": "0": {
			schema: {b: string, m: int}
		}
	}
	lenses: {
		"1.0->0.0": {
			input: _
			let B = input.b
			_suffix: ""
			result: {
				a~(A): B + _suffix
				n:     input.m
				_echo: A
			}
			lacunas: [thema.Lacuna & {
				condition: input.m == 0
				targetFields: [{path: "a", value: result.a}]
				message: "m was the placeholder value"
				type:    thema.LacunaTypes.Placeholder
			}]
		}
		"0.0->1.0": {
			input: _
			result: {b: input.a, m: input.n}
		}
	}
}
-- expect --
bind ok
translate 1.0 0.0 ok {b: "x", m: 0}
translate 0.0 1.0 ok {a: "x", n: 1}
