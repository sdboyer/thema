# a lens's own body is the instance it takes, the one it returns, lacunas and
# anything declared inside the lens: a let, a hidden field and a field alias
# (visible within the struct that declares it) are all fine to refer to, and
# so is thema's own package (thema.Lacuna, thema.LacunaTypes), which is part
# of the substrate
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "refOkLensLocal"
	schemas: {
		"0": "0": {
			schema: {a: string, n: int}
		}
		"1": "0": {
			schema: {b: string, m: int}
		}
	}
	lenses: {
		"1.0->0.0": {
			v1_0: _
			let B = v1_0.b
			_suffix: ""
			v0_0: {
				a~(A): B + _suffix
				n:     v1_0.m
				_echo: A
			}
			lacunas: [thema.Lacuna & {
				condition: v1_0.m == 0
				targetFields: [{path: "a", value: v0_0.a}]
				message: "m was the placeholder value"
				type:    thema.LacunaTypes.Placeholder
			}]
		}
		"0.0->1.0": {
			v0_0: _
			v1_0: {b: v0_0.a, m: v0_0.n}
		}
	}
}
-- expect --
bind ok
translate 1.0 0.0 ok {b: "x", m: 0}
translate 0.0 1.0 ok {a: "x", n: 1}
