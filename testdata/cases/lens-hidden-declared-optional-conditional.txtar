# as lens-hidden-declared-conditional, with the hidden field optional in the target
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensHiddenDeclaredOptionalConditional"
	schemas: {
		"0": "0": {
			schema: {a: string, _h?: {k: int}}
		}
		"0": "1": {
			schema: {a: string, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {
				a: v0_1.a
				_h: {
					k: 1
					if v0_1.a == "boom" {extra: 2}
				}
			}
		}
	}
}
-- expect --
bind fail _h.extra
