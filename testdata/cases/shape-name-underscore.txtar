# lineage name contains an underscore: allowed. Cap'n Proto, which forbids
# underscores in names, drops them predictably (ship_v2 becomes shipv2).
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "ship_v2"
	schemas: {
		"0": "0": {schema: {a: int}}
	}
}
-- expect --
bind ok
