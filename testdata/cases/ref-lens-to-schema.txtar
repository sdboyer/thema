# a lens result is a field of a schema, read through the lineage: a lens may
# refer only to input, its own body and CUE's builtin packages (rule
# ref-lens-to-schema). The constraint it copies is not a value anyway; the lens
# builds its result from input.
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "refLensToSchema"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"1": "0": {
			schema: {b: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			input: _
			result: {a: input.b}
		}
		"0.0->1.0": {
			input: _
			result: {b: lin.schemas["0"]["0"].schema.a}
		}
	}
}
-- expect --
bind fail ref-lens-to-schema
