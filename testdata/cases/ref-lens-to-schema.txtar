# a lens returns a field of a schema, read through the lineage: a lens may
# refer only to the instance it takes, its own body and CUE's builtin packages
# (rule ref-lens-to-schema). The constraint it copies is not a value anyway;
# the lens builds what it returns from the instance it takes.
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "refLensToSchema"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"1": "0": {
			schema: {b: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			v1_0: _
			v0_0: {a: v1_0.b}
		}
		"0.0->1.0": {
			v0_0: _
			v1_0: {b: lin.schemas["0"]["0"].schema.a}
		}
	}
}
-- expect --
bind fail ref-lens-to-schema
