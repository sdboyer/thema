# a version is a disjunction (*[0, 1] | [1, 0]), not a concrete version
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionDefaultDisjunction"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: *[0, 1] | [1, 0]
		schema: {a: int, b?: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind fail
