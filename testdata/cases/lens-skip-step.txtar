# backward lens 0.2 -> 0.0 skips 0.1, and there is no 0.2 -> 0.1 lens
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensSkipStep"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"0": "1": {
			schema: {a: int, b?: int}
		}
		"0": "2": {
			schema: {a: int, b?: int, c?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {a: v0_1.a}
		}
		"0.2->0.0": {
			v0_2: _
			v0_0: {a: v0_2.a}
		}
	}
}
-- expect --
bind fail has no lens 0.2->0.1
