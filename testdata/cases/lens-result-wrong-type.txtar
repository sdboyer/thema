# lens result is a constant of the wrong type for its target schema
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensResultWrongType"
	schemas: [{
		version: [0, 0]
		schema: {a: string}
	}, {
		version: [0, 1]
		schema: {a: string, b?: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {a: 42}
	}]
}
-- expect --
bind fail
