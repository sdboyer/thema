# schemas read the lineage's #LatestVersion and a lens result reads the
# lineage's name: both are declared in the lineage outside the schema or lens
# that reads them (rule ref-lineage-meta), and both change meaning as the
# lineage grows. Schemas are checked before lenses, so the schemas' references
# are reported; the version a schema wants is already its key, and a lens
# writes the literal.
#issue: 21
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "extLensUsesName"
	schemas: {
		"0": "0": {
			schema: {a: string, v: lin.#LatestVersion[1]}
		}
		"0": "1": {
			schema: {a: string, b?: string, v: lin.#LatestVersion[1]}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: {a: lin.name, v: input.v}
		}
	}
}
-- expect --
bind fail ref-lineage-meta
