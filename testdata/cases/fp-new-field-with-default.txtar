# adding a regular field with a default keeps every old instance valid, but is judged backwards incompatible
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "fpNewFieldWithDefault"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"0": "1": {
			schema: {a: int, b: *1 | int}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: {a: input.a}
		}
	}
}
-- expect --
bind ok
translate 0.0 0.1 ok {a: 3}
