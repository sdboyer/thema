# the first schema is declared [1, 0] rather than [0, 0]
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionFirstMajorOne"
	schemas: {
		"1": "0": {
			schema: {a: int}
		}
	}
	lenses: {}
}
-- expect --
bind fail the first schema is version 1.0, not 0.0
