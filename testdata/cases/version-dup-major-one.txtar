# version [1, 0] is declared twice
#issue: 19
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "versionDupMajorOne"
	schemas: [{
		version: [0, 0]
		schema: {a: int}
	}, {
		version: [1, 0]
		schema: {a: string}
	}, {
		version: [1, 0]
		schema: {a: bool}
	}]
	lenses: [{
		from: [1, 0]
		to: [0, 0]
		input: _
		result: {a: 1}
	}, {
		from: [0, 0]
		to: [1, 0]
		input: _
		result: {a: "s"}
	}]
}
-- expect --
bind fail
