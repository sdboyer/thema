# lens result contains a field its target does not declare, for some inputs
#issue: 20
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensConditionalUndeclared"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"0": "1": {
			schema: {a: string, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: {
				a: input.a
				if input.a == "boom" {extra: 1}
			}
		}
	}
}
-- expect --
bind fail
