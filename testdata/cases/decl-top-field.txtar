# a field typed _ admits struct content in Validate, but Translate rejects that content as undeclared
#issue: 25
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "declTopField"
	schemas: {
		"0": "0": {
			schema: {a: string, meta: _}
		}
		"0": "1": {
			schema: {a: string, meta: _}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: input
		}
	}
}
-- expect --
validate 0.0 ok {a: "x", meta: {smuggled: {deep: 1}}}
translate 0.1 0.0 ok {a: "x", meta: {smuggled: {deep: 1}}}
