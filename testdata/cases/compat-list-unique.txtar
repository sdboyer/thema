# minor bump adds list.UniqueItems(); {l: [1, 1]} was valid at 0.0 and is invalid at 0.1
#issue: 17
-- in.cue --
import (
	"github.com/sdboyer/thema"
	"list"
)

lin: thema.Lineage & {
	name: "compatListUnique"
	schemas: {
		"0": "0": {
			schema: {l: [...int]}
		}
		"0": "1": {
			schema: {l: list.UniqueItems() & [...int]}
		}
	}
	lenses: {
		"0.1->0.0": {
			input: _
			result: {l: input.l}
		}
	}
}
-- expect --
bind fail
