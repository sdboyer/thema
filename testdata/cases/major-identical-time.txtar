# major bump identical to its predecessor (time.Time) is accepted as breaking
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
	"time"
)

lin: thema.Lineage & {
	name: "majorIdenticalTime"
	schemas: [{
		version: [0, 0]
		schema: {a: time.Time}
	}, {
		version: [1, 0]
		schema: {a: time.Time}
	}]
	lenses: [{
		from: [1, 0]
		to: [0, 0]
		input: _
		result: {a: input.a}
	}, {
		from: [0, 0]
		to: [1, 0]
		input: _
		result: {a: input.a}
	}]
}
-- expect --
bind fail
