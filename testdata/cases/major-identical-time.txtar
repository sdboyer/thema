# major bump identical to its predecessor (time.Time) is accepted as breaking
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
	"time"
)

lin: thema.Lineage & {
	name: "majorIdenticalTime"
	schemas: {
		"0": "0": {
			schema: {a: time.Time}
		}
		"1": "0": {
			schema: {a: time.Time}
		}
	}
	lenses: {
		"1.0->0.0": {
			input: _
			result: {a: input.a}
		}
		"0.0->1.0": {
			input: _
			result: {a: input.a}
		}
	}
}
-- expect --
bind fail
