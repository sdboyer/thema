# joinSchema is injected into every schema, so its defaults apply to every version
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "join-injects-default"
	joinSchema: {a?: *"injected" | string, ...}
	schemas: [{
		version: [0, 0]
		schema: {a: string}
	}]
}
-- expect --
bind ok
validate 0.0 ok {}
validate 0.0 ok {a: "x"}
