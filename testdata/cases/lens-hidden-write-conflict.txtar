# lens declares a hidden helper twice in its result, with values that may
# disagree (#125): refused before the totality walk sees it, as a lens result
# may not declare a hidden field (#250)
#issue: 125
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "lensHiddenWriteConflict"
	schemas: {
		"0": "0": {schema: {a!: int32}}
		"1": "0": {schema: {b!: int64}}
	}
	lenses: {
		"0.0->1.0": {
			v0_0: _
			v1_0: {
				_h: v0_0.a
				_h: 1
				b:  _h + 1
			}
		}
		"1.0->0.0": {
			v1_0: _
			v0_0: {a: 1}
		}
	}
}
-- expect --
bind fail E0151
