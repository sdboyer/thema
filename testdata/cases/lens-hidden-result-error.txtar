# a hidden result field fails to evaluate: not data, but evaluated at translate
#issue: 107
-- in.cue --
import "github.com/sdboyer/thema"

lin: thema.Lineage & {
	name: "lensHiddenResultError"
	schemas: {
		"0": "0": {schema: {a!: int}}
		"1": "0": {schema: {b!: int}}
	}
	lenses: {
		"0.0->1.0": {
			v0_0: _
			v1_0: {
				b:  v0_0.a
				_h: v0_0.a + "x"
			}
		}
		"1.0->0.0": {
			v1_0: _
			v0_0: {a: v1_0.b}
		}
	}
}
-- expect --
bind fail unknown-op
