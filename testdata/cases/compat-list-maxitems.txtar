# minor bump adds list.MaxItems(1); {l: [1, 2]} was valid at 0.0 and is invalid at 0.1
#issue: 17
-- in.cue --
import (
	"github.com/sdboyer/thema"
	"list"
)

lin: thema.Lineage & {
	name: "compatListMaxitems"
	schemas: [{
		version: [0, 0]
		schema: {l: [...int]}
	}, {
		version: [0, 1]
		schema: {l: [...int] & list.MaxItems(1)}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {l: input.l}
	}]
}
-- expect --
bind fail
