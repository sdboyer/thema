# as lens-hidden-undeclared, built inside a comprehension
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lens-hidden-undeclared-conditional"
	schemas: [{
		version: [0, 0]
		schema: {a: string}
	}, {
		version: [0, 1]
		schema: {a: string, b?: int}
	}]
	lenses: [{
		from: [0, 1]
		to: [0, 0]
		input: _
		result: {
			a: input.a
			_h: {if input.a == "boom" {extra: 2}}
		}
	}]
}
-- expect --
bind ok
translate 0.1 0.0 ok {a: "boom"}
