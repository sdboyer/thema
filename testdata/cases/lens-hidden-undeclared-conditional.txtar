# as lens-hidden-undeclared, built inside a comprehension
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "lensHiddenUndeclaredConditional"
	schemas: {
		"0": "0": {
			schema: {a: string}
		}
		"0": "1": {
			schema: {a: string, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {
				a: v0_1.a
				_h: {if v0_1.a == "boom" {extra: 2}}
			}
		}
	}
}
-- expect --
bind ok
translate 0.1 0.0 ok {a: "boom"}
