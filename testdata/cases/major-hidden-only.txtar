# a major bump that only adds a definition, invisible to data, is not breaking,
# so it is not a major version. #18 found this for a hidden field, which a
# schema may no longer declare (#250).
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "majorDefinitionOnly"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"1": "0": {
			schema: {a: int, #H: int}
		}
	}
	lenses: {
		"1.0->0.0": {
			v1_0: _
			v0_0: {a: v1_0.a}
		}
		"0.0->1.0": {
			v0_0: _
			v1_0: {a: v0_0.a}
		}
	}
}
-- expect --
bind fail E0208
