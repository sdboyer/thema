# identical time.Time in both versions is judged backwards incompatible
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
	"time"
)

lin: thema.Lineage & {
	name: "fpTimeIdentical"
	schemas: {
		"0": "0": {
			schema: {a: time.Time}
		}
		"0": "1": {
			schema: {a: time.Time, b?: int}
		}
	}
	lenses: {
		"0.1->0.0": {
			v0_1: _
			v0_0: {a: v0_1.a}
		}
	}
}
-- expect --
bind ok
translate 0.0 0.1 ok {a: "2024-01-01T00:00:00Z"}
