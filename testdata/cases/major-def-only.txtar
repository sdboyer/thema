# major bump that only adds an unused definition is accepted as breaking
#issue: 18
-- in.cue --
import (
	"github.com/sdboyer/thema"
)

lin: thema.Lineage & {
	name: "majorDefOnly"
	schemas: {
		"0": "0": {
			schema: {a: int}
		}
		"1": "0": {
			schema: {a: int, #D: string}
		}
	}
	lenses: {
		"1.0->0.0": {
			input: _
			result: {a: input.a}
		}
		"0.0->1.0": {
			input: _
			result: {a: input.a}
		}
	}
}
-- expect --
bind fail
