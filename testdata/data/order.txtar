-- order/history/0.0.thema --
import "strings"

Schema: {
	id: =~"^ord_[a-z0-9]{8}$"
	customer: {
		name:  strings.MinRunes(1) & strings.MaxRunes(100)
		email: =~"^[^@]+@[^@]+$"
		tier:  "free" | "pro" | "enterprise"
	}
	status: "pending" | "paid" | "shipped" | "cancelled"
	items: [...{
		sku:        =~"^[A-Z]{3}-[0-9]{4}$"
		quantity:   int & >=1 & <=1000
		priceCents: int & >=0 & <=100000000
	}]
	note?:     string
	priority?: int & >=0 & <=10
}
