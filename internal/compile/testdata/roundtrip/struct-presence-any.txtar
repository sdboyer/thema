A target struct filled from inside and outside an optional source struct is
written where any of its content is. 1.0 moves b out of q, and q requires
nothing, so backward q is written where 1.0 has q or b: {"b": 2} goes back
to {"q": {"b": 2}}, and {} to {}.
-- ship/history/0.0.thema --
Schema: {
	q?: {
		a?: int
		b?: int
	}
}
-- ship/1.0.thema --
Schema: {
	q?: {
		a?: int
	}
	b?: int
}

ForwardLens: {
	v0_0: _
	v1_0: {
		b: v0_0.q.b
	}
}
-- data/0.0/absent.json --
{}
-- data/0.0/empty.json --
{"q": {}}
-- data/0.0/b.json --
{"q": {"b": 2}}
-- data/1.0/absent.json --
{}
-- data/1.0/empty.json --
{"q": {}}
-- data/1.0/b.json --
{"b": 2}
-- data/1.0/qb.json --
{"q": {"a": 1}, "b": 2}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
Schema: {
	q?: {
		a?: int
	}
	b?: int
}

ForwardLens: {
	v0_0: _
	v1_0: {
		b: v0_0.q.b
	}
}
-- out/decompiled/history/0.0.thema --
