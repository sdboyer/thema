	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			if v0_0.q != _|_ {
				q: {if v0_0.q.a != _|_ {
					a: v0_0.q.a
				}}
			}
			if v0_0.q.b != _|_ {
				b: v0_0.q.b
			}
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			if v1_0.q != _|_ {
				q: {
					if v1_0.q.a != _|_ {
						a: v1_0.q.a
					}
					if v1_0.b != _|_ {
						b: v1_0.b
					}
				}
			}
			if v1_0.b != _|_ && v1_0.q == _|_ {
				q: {
					if v1_0.q.a != _|_ {
						a: v1_0.q.a
					}
					if v1_0.b != _|_ {
						b: v1_0.b
					}
				}
			}
		}
	}
}
