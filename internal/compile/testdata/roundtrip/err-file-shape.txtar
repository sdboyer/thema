A version file with an import, a package clause and a stray field.
-- ship/history/0.0.thema --
Schema: {
	a: string
}
-- ship/1.0.thema --
package ship

import "strings"

Schema: {
	a: string
	b: int
}

extra: 1

ForwardLens: {
	v0_0: _
	v1_0: {
		b: 1
	}
}
-- out/error --
error[E0103]: 1.0.thema has a package clause
 --> 1.0.thema:1:1
  |
1 | package ship
  | ^^^^^^^
  |
  = help: a version file is not a CUE package; remove the clause

error[E0104]: 1.0.thema imports a package
 --> 1.0.thema:3:1
  |
3 | import "strings"
  | ^^^^^^
  |
  = help: a version file imports nothing; a schema uses only CUE's builtins

error[E0105]: extra is not a field of a version file
  --> 1.0.thema:10:1
   |
10 | extra: 1
   | ^^^^^
   |
   = help: a version file has only Schema, ForwardLens and BackwardLens
