A version file with an import, a package clause and a stray field.
-- ship/history/0.0.thema --
Schema: {
	a: string
}
-- ship/history/1.0.thema --
package ship

import "strings"

Schema: {
	a: string
	b: int
}

extra: 1

ForwardLens: {
	v0_0: _
	v1_0: {
		b: 1
	}
}
-- ship/tip.thema --
package ship

import "strings"

Schema: {
	a: string
	b: int
}

extra: 1
-- out/error --
error[E0103]: history/1.0.thema has a package clause
 --> ship/history/1.0.thema:1:1
  |
1 | package ship
  | ^^^^^^^
  |
  = help: a version file is not a CUE package; remove the clause

error[E0105]: extra is not a field of a version file
  --> ship/history/1.0.thema:10:1
   |
10 | extra: 1
   | ^^^^^
   |
   = help: a version file has only Schema, ForwardLens and BackwardLens

error[E0147]: history/1.0.thema imports strings, which its Schema does not use
 --> ship/history/1.0.thema:3:8
  |
3 | import "strings"
  |        ^^^^^^^^^
  |
  = help: remove the import: a lens calls the strings functions without one
