A [_] arm without a lacuna: it collapses every unmapped value into one, and
must say so.
-- ship/history/0.0.thema --
Schema: {
	kind: string
}
-- ship/history/1.0.thema --
Schema: {
	kind: int
}

ForwardLens: {
	v0_0: _
	v1_0: {
		kind: _match(v0_0.kind, {
			"a": 1
			[_]: 0
		})
	}
}
