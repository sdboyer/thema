exemplars/defaultchange.cue in authoring form: the default of an enum field
changes, so each direction matches the old default to the new one, with a
ChangedDefault lacuna when the arm applies. Neither direction derives from
the other.
-- ship/history/0.0.thema --
Schema: {
	aunion: *"foo" | "bar" | "baz"
}
-- ship/history/1.0.thema --
Schema: {
	aunion: "foo" | *"bar" | "baz"
}

ForwardLens: {
	v0_0: _
	v1_0: {
		aunion: _match(v0_0.aunion, {"foo": "bar"})
	}
	lacunas: {
		aunion: [{
			type:    ChangedDefault
			message: "aunion was the source default, \"foo\", and was changed to the target default, \"bar\""
			when:    v0_0.aunion == "foo"
		}]
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		aunion: _match(v1_0.aunion, {"bar": "foo"})
	}
	lacunas: {
		aunion: [{
			type:    ChangedDefault
			message: "aunion was the source default, \"bar\", and was changed to the target default, \"foo\""
			when:    v1_0.aunion == "bar"
		}]
	}
}
-- ship/tip.thema --
Schema: {
	aunion: "foo" | *"bar" | "baz"
}
-- out/bind --
ok
-- out/decompiled/history/0.0.thema --
Schema: {
	aunion: *"foo" | "bar" | "baz"
}
-- out/decompiled/history/1.0.thema --
Schema: {
	aunion: "foo" | *"bar" | "baz"
}

ForwardLens: {
	v0_0: _
	v1_0: {
		aunion: _match(v0_0.aunion, {"foo": "bar"})
	}
	lacunas: {
		aunion: [{
			type:    ChangedDefault
			message: "aunion was the source default, \"foo\", and was changed to the target default, \"bar\""
			when:    v0_0.aunion == "foo"
		}]
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		aunion: _match(v1_0.aunion, {"bar": "foo"})
	}
	lacunas: {
		aunion: [{
			type:    ChangedDefault
			message: "aunion was the source default, \"bar\", and was changed to the target default, \"foo\""
			when:    v1_0.aunion == "bar"
		}]
	}
}
-- out/decompiled/tip.thema --
Schema: {
	aunion: "foo" | *"bar" | "baz"
}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				aunion: *"foo" | "bar" | "baz"
			}
		}
	}
	"1": {
		"0": {
			schema: {
				aunion: "foo" | *"bar" | "baz"
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			if (v0_0.aunion & "foo") != _|_ {
				aunion: "bar"
			}
			if (v0_0.aunion & ("foo")) == _|_ && (v0_0.aunion & ("foo" | *"bar" | "baz")) != _|_ {
				aunion: v0_0.aunion
			}
		}
		lacunas: [{
			condition: v0_0.aunion == "foo"
			sourceFields: [{
				path:  "aunion"
				value: v0_0.aunion
			}]
			targetFields: [{
				path:  "aunion"
				value: v1_0.aunion
			}]
			message: "aunion was the source default, \"foo\", and was changed to the target default, \"bar\""
			type:    "ChangedDefault"
		}]
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			if (v1_0.aunion & "bar") != _|_ {
				aunion: "foo"
			}
			if (v1_0.aunion & ("bar")) == _|_ && (v1_0.aunion & (*"foo" | "bar" | "baz")) != _|_ {
				aunion: v1_0.aunion
			}
		}
		lacunas: [{
			condition: v1_0.aunion == "bar"
			sourceFields: [{
				path:  "aunion"
				value: v1_0.aunion
			}]
			targetFields: [{
				path:  "aunion"
				value: v0_0.aunion
			}]
			message: "aunion was the source default, \"bar\", and was changed to the target default, \"foo\""
			type:    "ChangedDefault"
		}]
	}
}
