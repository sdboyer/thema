A field an each body's element requires beneath a struct the body writes:
it is reported at that struct, and the help names it as the element of the
list the body builds.
-- ship/history/0.0.thema --
Schema: {
	items: [...{
		meta: {
			owner: string
		}
	}]
}
-- ship/history/1.0.thema --
Schema: {
	items: [...{
		meta: {
			owner: string
			team:  string
		}
	}]
}

ForwardLens: (prev): {
	self: {
		items: _each(prev.items, {
			meta: {
				owner: _item.meta.owner
			}
		})
	}
}
-- ship/tip.thema --
Schema: {
	items: [...{
		meta: {
			owner: string
			team:  string
		}
	}]
}
-- out/error --
error[E0346]: ForwardLens produces nothing for meta.team, which v1.0 requires
  --> history/1.0.thema:13:4
   |
13 |             meta: {
   |             ^^^^
   |
   = help: add team: <mapping> to self.items[].meta
