each whose body copies a field of the element, in the forward direction,
where the element has other fields (#165): a list of {id, is_enabled} objects
becomes the list of their ids. The copy is the whole target element, so
nothing could move or drop is_enabled; it is dropped by derivation, with the
aggregated DroppedField lacuna naming each element that had it, as in the
backward direction. note is optional, so its lacuna names only the elements
that have it.
-- ship/history/0.0.thema --
Schema: close({
	u!: [...close({id!: string, is_enabled!: bool, note?: string})]
})
-- ship/1.0.thema --
Schema: close({
	u!: [...string]
})

ForwardLens: {
	v0_0: _
	v1_0: {
		u: _each(v0_0.u, _item.id)
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		u: _each(v1_0.u, {id: _item, is_enabled: true})
	}
}
-- data/0.0/empty.json --
{"u": []}
-- data/0.0/two.json --
{"u": [{"id": "a", "is_enabled": true}, {"id": "b", "is_enabled": false, "note": "x"}]}
-- data/1.0/two.json --
{"u": ["a", "b"]}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
Schema: close({u!: [...string]})

ForwardLens: {
	v0_0: _
	v1_0: {
		u: _each(v0_0.u, _item.id)
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		u: _each(v1_0.u, {
			id:         _item
			is_enabled: true
		})
	}
}
-- out/decompiled/history/0.0.thema --
Schema: close({
	u!: [...close({
		id!:         string
		is_enabled!: bool
		note?:       string
	})]
})
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: close({
				u!: [...close({id!: string, is_enabled!: bool, note?: string})]
			})
		}
	}
	"1": {
		"0": {
			schema: close({
				u!: [...string]
			})
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		let _d_0 = [for i, _item in v0_0.u {
			path:  "u[\(i)].is_enabled"
			value: _item.is_enabled
		}]
		let _d_1 = [for i, _item in v0_0.u if _item.note != _|_ {
			path:  "u[\(i)].note"
			value: _item.note
		}]
		v1_0: {
			u: [for _item in v0_0.u {
				_item.id
			}]
		}
		lacunas: [
			{
				@thema(derived)
				condition:    len(_d_0) > 0
				sourceFields: _d_0
				message:      "u[].is_enabled has no equivalent in 1.0 and was dropped"
				type:         "DroppedField"
			},
			{
				@thema(derived)
				condition:    len(_d_1) > 0
				sourceFields: _d_1
				message:      "u[].note has no equivalent in 1.0 and was dropped"
				type:         "DroppedField"
			}
		]
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			u: [for _item in v1_0.u {
				id:         _item
				is_enabled: true
			}]
		}
	}
}
-- out/translate/0.0/empty->1.0 --
{"u":[]}
[]
-- out/translate/0.0/two->1.0 --
{"u":["a","b"]}
