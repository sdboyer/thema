exemplars/rename.cue in authoring form: a rename is one forward entry; the
backward entry is derived, and the unchanged field is copied implicitly.
-- ship/history/0.0.thema --
schema: {
	before:    string
	unchanged: string
}
-- ship/1.0.thema --
schema: {
	after:     string
	unchanged: string
}

forward: {
	after: input.before
}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
schema: {
	after:     string
	unchanged: string
}

forward:
	after: input.before
-- out/decompiled/history/0.0.thema --
schema: {
	before:    string
	unchanged: string
}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				before:    string
				unchanged: string
			}
		}
	}
	"1": {
		"0": {
			schema: {
				after:     string
				unchanged: string
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		input: _
		result: {
			after:     input.before
			unchanged: input.unchanged
		}
	}
	"1.0->0.0": {
		input: _
		result: {
			before:    input.after
			unchanged: input.unchanged
		}
	}
}
