exemplars/rename.cue in authoring form: a rename is one forward entry; the
backward entry is derived, and the unchanged field is copied implicitly.
-- ship/history/0.0.thema --
schema: {
	before:    string
	unchanged: string
}
-- ship/1.0.thema --
schema: {
	after:     string
	unchanged: string
}

ForwardLens: {
	v0_0: _
	v1_0: {
		after: v0_0.before
	}
}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
schema: {
	after:     string
	unchanged: string
}

ForwardLens: {
	v0_0: _
	v1_0: {
		after: v0_0.before
	}
}
-- out/decompiled/history/0.0.thema --
schema: {
	before:    string
	unchanged: string
}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				before:    string
				unchanged: string
			}
		}
	}
	"1": {
		"0": {
			schema: {
				after:     string
				unchanged: string
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			after:     v0_0.before
			unchanged: v0_0.unchanged
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			before:    v1_0.after
			unchanged: v1_0.unchanged
		}
	}
}
