A required field that is not a bool, named bare as a when. A bare reference
is a presence test for an optional field and a value for a required bool;
anything else is not a condition.
-- ship/history/0.0.thema --
Schema: {
	name: string
}
-- ship/history/1.0.thema --
Schema: {
	name:  string
	count: int
}

ForwardLens: {
	v0_0: _
	v1_0: {
		count: 0
	}
	lacunas: {
		count: [{
			type:    Placeholder
			message: "0 is a placeholder"
			when:    v0_0.name
		}]
	}
}
