-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				q?: {
					a!: int
				}
			}
		}
	}
	"1": {
		"0": {
			schema: {
				q: {
					a!: int
				}
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			if v0_0.q != _|_ {
				q: v0_0.q
			}
			if v0_0.q == _|_ {
				q: {
					a: 0
				}
			}
		}
		lacunas: [{
			condition: v0_0.q == _|_
			sourceFields: [if v0_0.q != _|_ {
				path:  "q"
				value: v0_0.q
			}]
			targetFields: [{
				path:  "q"
				value: v1_0.q
			}]
			message: "q was absent; {a: 0} is a placeholder"
			type:    "Placeholder"
		}]
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			q: v1_0.q
		}
	}
}
