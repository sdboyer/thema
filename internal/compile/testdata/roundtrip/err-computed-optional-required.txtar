A computed mapping reading an optional field into a field the target
requires: coalesce says what to use when it is absent.
-- ship/history/0.0.thema --
Schema: {
	count?: int32
}
-- ship/history/1.0.thema --
Schema: {
	total: int64
}

ForwardLens: (prev): {
	self: {
		total: prev.count * 2
		count: _drop
	}
}
-- ship/tip.thema --
Schema: {
	total: int64
}
-- out/error --
error[E0343]: prev.count * 2 reads prev.count, which v0.0 may omit, and v1.0 requires total
 --> history/1.0.thema:7:3
  |
7 |         total: prev.count * 2
  |         ^^^^^
  |
  = help: write _coalesce(prev.count * 2, <fallback>) to say what to use when it is absent
