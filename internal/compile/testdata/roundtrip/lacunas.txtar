lacunas: several lacunas on one mapping, a lacuna with its own when, and a
key nested like the mapping it describes. count's first lacuna applies when
the orelse fallback does, its second under the author's condition; name's
applies under a condition over a field 0.0 always has, a guard the totality
proof accepts as a boolean it can evaluate. The backward lens is wholly
derived.
-- ship/history/0.0.thema --
Schema: {
	name: string
	meta: {
		owner: string
	}
	count?: int
}
-- ship/1.0.thema --
Schema: {
	name: string
	meta: {
		owner: string
		team:  string
	}
	count: int
}

ForwardLens: {
	v0_0: _
	v1_0: {
		name: v0_0.name
		meta: {
			team: "unassigned"
		}
		count: _orelse(v0_0.count, 0)
	}
	lacunas: {
		name: [{
			type:    LossyFieldMapping
			message: "names longer than 64 characters are truncated downstream"
			when:    len(v0_0.name) > 64
		}]
		meta: {
			team: [{
				type:    Placeholder
				message: "0.0 has no team; \"unassigned\" is a placeholder"
			}]
		}
		count: [{
			type:    Placeholder
			message: "count was absent; 0 is a placeholder"
		}, {
			type:    AmbiguousMapping
			message: "legacy records never recorded a count, so 0 may be real"
			when:    v0_0.name == "legacy"
		}]
	}
}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
Schema: {
	name: string
	meta: {
		owner: string
		team:  string
	}
	count: int
}

ForwardLens: {
	v0_0: _
	v1_0: {
		name: v0_0.name
		meta: {
			team: "unassigned"
		}
		count: _orelse(v0_0.count, 0)
	}
	lacunas: {
		name: [{
			type:    LossyFieldMapping
			message: "names longer than 64 characters are truncated downstream"
			when:    len(v0_0.name) > 64
		}]
		meta: {
			team: [{
				type:    Placeholder
				message: "0.0 has no team; \"unassigned\" is a placeholder"
			}]
		}
		count: [{
			type:    Placeholder
			message: "count was absent; 0 is a placeholder"
		}, {
			type:    AmbiguousMapping
			message: "legacy records never recorded a count, so 0 may be real"
			when:    v0_0.name == "legacy"
		}]
	}
}
-- out/decompiled/history/0.0.thema --
Schema: {
	name: string
	meta: {
		owner: string
	}
	count?: int
}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				name: string
				meta: {
					owner: string
				}
				count?: int
			}
		}
	}
	"1": {
		"0": {
			schema: {
				name: string
				meta: {
					owner: string
					team:  string
				}
				count: int
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			name: v0_0.name
			meta: {
				owner: v0_0.meta.owner
				team:  "unassigned"
			}
			if v0_0.count != _|_ {
				count: v0_0.count
			}
			if v0_0.count == _|_ {
				count: 0
			}
		}
		lacunas: [
			{
				condition: len(v0_0.name) > 64
				sourceFields: [{
					path:  "name"
					value: v0_0.name
				}]
				targetFields: [{
					path:  "name"
					value: v1_0.name
				}]
				message: "names longer than 64 characters are truncated downstream"
				type:    "LossyFieldMapping"
			},
			{
				targetFields: [{
					path:  "meta.team"
					value: v1_0.meta.team
				}]
				message: "0.0 has no team; \"unassigned\" is a placeholder"
				type:    "Placeholder"
			},
			{
				condition: v0_0.count == _|_
				sourceFields: [if v0_0.count != _|_ {
					path:  "count"
					value: v0_0.count
				}]
				targetFields: [{
					path:  "count"
					value: v1_0.count
				}]
				message: "count was absent; 0 is a placeholder"
				type:    "Placeholder"
			},
			{
				condition: v0_0.name == "legacy"
				sourceFields: [if v0_0.count != _|_ {
					path:  "count"
					value: v0_0.count
				}]
				targetFields: [{
					path:  "count"
					value: v1_0.count
				}]
				message: "legacy records never recorded a count, so 0 may be real"
				type:    "AmbiguousMapping"
			}
		]
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			name: v1_0.name
			meta:
				owner: v1_0.meta.owner
			count: v1_0.count
		}
		lacunas: [{
			@thema(derived)
			sourceFields: [{
				path:  "meta.team"
				value: v1_0.meta.team
			}]
			message: "meta.team has no equivalent in 0.0 and was dropped"
			type:    "DroppedField"
		}]
	}
}
