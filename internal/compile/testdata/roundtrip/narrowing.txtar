exemplars/narrowing.cue in authoring form: a string-or-bool field narrows to a
bool. The match keys the two strings, lets a bool pass through, and sends any
other string to the [_] arm, which must have a lacuna: the one declared on
properbool without a when. Backward is a move, since 0.0's boolish accepts a
bool.
-- ship/history/0.0.thema --
schema: {
	boolish: "true" | "false" | bool | string
}
-- ship/1.0.thema --
schema: {
	properbool: bool
}

ForwardLens: {
	v0_0: _
	v1_0: {
		properbool: match(v0_0.boolish, {
			"true":  true
			"false": false
			[_]:     false
		})
	}
	lacunas: {
		properbool: [{
			type:    LossyFieldMapping
			message: "boolish was a string but neither \"true\" nor \"false\"; fallback to treating as false"
		}]
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		boolish: v1_0.properbool
	}
}
-- out/bind --
lens 0.0->1.0: result is not an instance of schema 1.0:
Lineage.lenses."0.0->1.0".result.properbool: conflicting values false and true:
    1.0.thema:9:13
    1.0.thema:10:13
:
    1.0.thema:5:1
-- out/decompiled/1.0.thema --
schema: {
	properbool: bool
}

ForwardLens: {
	v0_0: _
	v1_0: {
		properbool: match(v0_0.boolish, {
			"true":  true
			"false": false
			[_]:     false
		})
	}
	lacunas: {
		properbool: [{
			type:    LossyFieldMapping
			message: "boolish was a string but neither \"true\" nor \"false\"; fallback to treating as false"
		}]
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		boolish: v1_0.properbool
	}
}
-- out/decompiled/history/0.0.thema --
schema: {
	boolish: "true" | "false" | bool | string
}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				boolish: "true" | "false" | bool | string
			}
		}
	}
	"1": {
		"0": {
			schema: {
				properbool: bool
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		input: _
		result: {
			if (input.boolish & "true") != _|_ {
				properbool: true
			}
			if (input.boolish & "false") != _|_ {
				properbool: false
			}
			if (input.boolish & ("true" | "false")) == _|_ && (input.boolish & (bool)) != _|_ {
				properbool: input.boolish
			}
			if (input.boolish & ("true" | "false")) == _|_ && (input.boolish & (bool)) == _|_ {
				properbool: false
			}
		}
		lacunas: [{
			condition: (input.boolish & ("true" | "false")) == _|_ && (input.boolish & (bool)) == _|_
			sourceFields: [{
				path:  "boolish"
				value: input.boolish
			}]
			targetFields: [{
				path:  "properbool"
				value: result.properbool
			}]
			message: "boolish was a string but neither \"true\" nor \"false\"; fallback to treating as false"
			type:    "LossyFieldMapping"
		}]
	}
	"1.0->0.0": {
		input: _
		result: {
			boolish: input.properbool
		}
	}
}
