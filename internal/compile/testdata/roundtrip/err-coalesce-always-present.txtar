coalesce over a field the source always has: the fallback could never apply.
-- ship/history/0.0.thema --
Schema: {
	a: string
}
-- ship/history/1.0.thema --
Schema: {
	b: string
}

ForwardLens: {
	v0_0: _
	v1_0: {
		b: _coalesce(v0_0.a, "x")
	}
}
-- ship/tip.thema --
Schema: {
	b: string
}
