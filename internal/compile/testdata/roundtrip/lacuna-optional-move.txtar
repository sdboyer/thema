Lacunas on mappings from optional fields. Each mapping is written only where
the instance has what it reads, so the lacuna's targetFields value is written
under the same presence test: dimension moves size, area computes from w and
h. A when that reads an optional field concerns only the instances that have
it. A lacuna without a when applies where its mapping writes: label's where
tag is present, area's second where both w and h are. An instance with none
of them raises no lacuna.
-- ship/history/0.0.thema --
Schema: {
	size?: int
	w?:    int32
	h?:    int32
	tag?:  string
}
-- ship/1.0.thema --
Schema: {
	dimension?: int
	area?:      int
	label?:     string
}

ForwardLens: {
	v0_0: _
	v1_0: {
		dimension: v0_0.size
		area:      v0_0.w * v0_0.h
		label:     v0_0.tag
	}
	lacunas: {
		dimension: [{
			type:    LossyFieldMapping
			message: "large sizes are clamped"
			when:    v0_0.size > 100
		}]
		area: [{
			type:    PrecisionLoss
			message: "large areas are rounded"
			when:    v0_0.w > 10
		}, {
			type:    LossyFieldMapping
			message: "areas are approximate"
		}]
		label: [{
			type:    LossyFieldMapping
			message: "labels are truncated downstream"
		}]
	}
}
-- data/0.0/absent.json --
{}
-- data/0.0/small.json --
{"size": 5, "w": 2, "h": 3, "tag": "t"}
-- data/0.0/large.json --
{"size": 500, "w": 20, "h": 3}
-- data/0.0/partial.json --
{"w": 20}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
