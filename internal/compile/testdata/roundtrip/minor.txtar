A minor version adds an optional field. Its file is just the schema: the
forward lens is implicit, and the backward lens is a derived drop, conditional
on the field being present.
-- ship/history/0.0.thema --
Schema: {
	firstfield: string
}
-- ship/0.1.thema --
Schema: {
	firstfield:  string
	secondfield?: int
}
-- out/bind --
ok
-- out/decompiled/0.1.thema --
Schema: {
	firstfield:   string
	secondfield?: int
}
-- out/decompiled/history/0.0.thema --
Schema: {
	firstfield: string
}
-- out/normal.cue --
name: "ship"
schemas:
	"0": {
		"0": {
			schema: {
				firstfield: string
			}
		}
		"1": {
			schema: {
				firstfield:   string
				secondfield?: int
			}
		}
	}
lenses:
	"0.1->0.0": {
		v0_1: _
		v0_0: {
			firstfield: v0_1.firstfield
		}
		lacunas: [{
			@thema(derived)
			condition: v0_1.secondfield != _|_
			sourceFields: [{
				path:  "secondfield"
				value: v0_1.secondfield
			}]
			message: "secondfield has no equivalent in 0.0 and was dropped"
			type:    "DroppedField"
		}]
	}
