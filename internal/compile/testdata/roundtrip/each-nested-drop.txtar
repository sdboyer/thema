{"steps":[{"title":"a","fields":[{"name":"x"},{"name":"y"}]},{"title":"b"},{"title":"c","fields":[{"name":"z"}]}]}
[{"sourceFields":[{"path":"steps[0].fields[0].legacy","value":"old"},{"path":"steps[2].fields[0].legacy","value":"older"}],"type":"DroppedField","message":"1.0 form fields have no legacy field"}]
