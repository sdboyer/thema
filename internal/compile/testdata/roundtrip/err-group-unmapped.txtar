Schema: {
	id:     string
	legacy: string
	shadow: string
}
-- ship/history/1.0.thema --
Schema: {
	id: string
}

ForwardLens: {
	v0_0: _
	v1_0: {
		id: v0_0.id
	}
}
-- ship/tip.thema --
Schema: {
	id: string
}
