A lacuna without a when on a match that has no [_] arm: the condition a
match implies is its [_] arm's, so there is nothing for the lacuna to apply
under.
-- ship/history/0.0.thema --
Schema: {
	aunion: *"foo" | "bar" | "baz"
}
-- ship/tip.thema --
Schema: {
	aunion: "foo" | *"bar" | "baz"
}

ForwardLens: {
	v0_0: _
	tip: {
		aunion: _match(v0_0.aunion, {"foo": "bar"})
	}
	lacunas: {
		aunion: [{
			type:    ChangedDefault
			message: "the default changed"
		}]
	}
}

BackwardLens: {
	tip: _
	v0_0: {
		aunion: _match(tip.aunion, {"bar": "foo"})
	}
	lacunas: {
		aunion: [{
			type:    ChangedDefault
			message: "the default changed"
			when:    tip.aunion == "bar"
		}]
	}
}
-- out/error --
error[E0420]: lacunas.aunion: a lacuna on a _match applies when its [_] arm does, and this _match has none
  --> tip.thema:11:12
   |
11 |         aunion: [{
   |                  ^
   |
   = help: say when it applies with when: <condition>
