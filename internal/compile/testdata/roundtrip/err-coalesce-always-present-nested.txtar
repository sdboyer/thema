coalesce over a field the source always has, beneath a struct: the mapping
the help offers is written where the _coalesce is, under its own key.
-- ship/history/0.0.thema --
Schema: {
	meta: {
		a: string
	}
}
-- ship/history/1.0.thema --
Schema: {
	meta: {
		b: string
	}
}

ForwardLens: (prev): {
	self: {
		meta: {
			b: _coalesce(prev.meta.a, "x")
		}
	}
}
-- ship/tip.thema --
Schema: {
	meta: {
		b: string
	}
}
-- out/error --
error[E0348]: v0.0 always has meta.a, so _coalesce's fallback could never apply
  --> history/1.0.thema:10:7
   |
10 |             b: _coalesce(prev.meta.a, "x")
   |                ^^^^^^^^^
   |
   = help: write b: prev.meta.a
