Computed mappings: arithmetic, a strings function and a comparison over
fields 0.0 always has, a computed value over an optional field written only
where it is present, and coalesce over a computed primary.
-- ship/history/0.0.thema --
Schema: {
	name:   string
	width:  int32
	height: int32
	tag?:   string
	count?: int32
}
-- ship/history/1.0.thema --
Schema: {
	name:   string
	label:  string
	area:   int64
	wide:   bool
	tag?:   string
	total:  int64
}

ForwardLens: {
	v0_0: _
	v1_0: {
		label: strings.ToUpper(v0_0.name)
		area:  v0_0.width * v0_0.height
		wide:  v0_0.width > v0_0.height
		tag:   strings.TrimSpace(v0_0.tag)
		total: _coalesce(v0_0.count * 2, 0)
		width:  _drop
		height: _drop
		count:  _drop
	}
	lacunas: {
		total: [{
			type:    Placeholder
			message: "count was absent; 0 is a placeholder"
		}]
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		width:  0
		height: 0
	}
}
