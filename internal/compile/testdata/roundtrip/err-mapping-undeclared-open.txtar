A mapping to a field the target admits through its ... but does not declare.
A lens writes only what its target declares.
-- ship/history/0.0.thema --
Schema: {
	a!: string
}
-- ship/1.0.thema --
Schema: {
	a!: int
	...
}

ForwardLens: {
	v0_0: _
	v1_0: {
		a:     len(v0_0.a)
		extra: v0_0.a
	}
}
-- out/error --
error[E0341]: 1.0 does not declare extra
  --> 1.0.thema:10:3
   |
10 |         extra: v0_0.a
   |         ^^^^^
   |
