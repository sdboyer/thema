A mapping to a field the target admits through its ... but does not declare.
A lens writes only what its target declares.
-- ship/history/0.0.thema --
Schema: {
	a!: string
}
-- ship/history/1.0.thema --
Schema: {
	a!: int
	...
}

ForwardLens: (prev): {
	self: {
		a:     len(prev.a)
		extra: prev.a
	}
}
-- ship/tip.thema --
Schema: {
	a!: int
	...
}
-- out/error --
error[E0341]: v1.0 does not declare extra
 --> history/1.0.thema:9:3
  |
9 |         extra: prev.a
  |         ^^^^^
  |
