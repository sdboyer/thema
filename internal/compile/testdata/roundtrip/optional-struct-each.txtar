	items: [
		...{
			q?: {
				x?: int
			}
		},
	]
}

ForwardLens: {
	v0_0: _
	v1_0: {
		items: _each(v0_0.items, {
			q: {
				y: _drop
			}
			o: _drop
		})
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		items: _each(v1_0.items, {})
	}
}
-- out/decompiled/history/0.0.thema --
Schema: {
	items: [...{
		q?: {
			x?: int
			y?: int
		}
		o?: {
