}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				items: [...{
					q?: {
						x?: int
						y?: int
					}
					o?: {
						e?: bool
					}
				}]
			}
		}
	}
	"1": {
		"0": {
			schema: {
				items: [...{
					q?: {
						x?: int
					}
				}]
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		let _d_0 = [for i, _item in v0_0.items if _item.q.y != _|_ {
			path:  "items[\(i)].q.y"
			value: _item.q.y
		}]
		let _d_1 = [for i, _item in v0_0.items if _item.o != _|_ {
			path:  "items[\(i)].o"
			value: _item.o
		}]
		v1_0: {
			items: [for _item in v0_0.items {
				if _item.q != _|_ {
					q: {if _item.q.x != _|_ {
						x: _item.q.x
					}}
				}
			}]
		}
		lacunas: [
			{
				@thema(derived)
				condition:    len(_d_0) > 0
				sourceFields: _d_0
				message:      "items[].q.y has no equivalent in 1.0 and was dropped"
				type:         "DroppedField"
			},
			{
				@thema(derived)
				condition:    len(_d_1) > 0
				sourceFields: _d_1
				message:      "items[].o has no equivalent in 1.0 and was dropped"
				type:         "DroppedField"
			}
		]
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			items: [for _item in v1_0.items {
				if _item.q != _|_ {
					q: _item.q
				}
			}]
		}
	}
}
