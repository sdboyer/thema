Inside an each body, a copy of an optional struct is written only where the
element has it, and a struct the body drops is dropped whole: the drop's
derived lacuna names every element that had it, empty or not. q's nested
body only drops y, and x is copied.
-- ship/history/0.0.thema --
Schema: {
	items: [...{
		q?: {
			x?: int
			y?: int
		}
		o?: {
			e?: bool
		}
	}]
}
-- ship/1.0.thema --
Schema: {
	items: [...{
		q?: {
			x?: int
		}
	}]
}

ForwardLens: {
	v0_0: _
	v1_0: {
		items: _each(v0_0.items, {
			q: {
				y: _drop
			}
			o: _drop
		})
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		items: _each(v1_0.items, {})
	}
}
-- data/0.0/items.json --
{"items": [{}, {"q": {}, "o": {}}, {"q": {"x": 1, "y": 2}, "o": {"e": true}}]}
-- data/1.0/items.json --
{"items": [{}, {"q": {}}, {"q": {"x": 1}}]}
-- out/bind --
ok
