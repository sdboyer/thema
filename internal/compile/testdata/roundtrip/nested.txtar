A nested restructure: a field moves into a struct that embeds its source, and
an untouched sibling struct is copied whole.
-- ship/history/0.0.thema --
schema: {
	ownerName: string
	meta: {
		created: string
	}
	dims: {
		w: int
		h: int
	}
}
-- ship/1.0.thema --
schema: {
	meta: {
		created: string
		owner:   string
	}
	dims: {
		w: int
		h: int
	}
}

forward: {
	meta: {
		owner: input.ownerName
	}
}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
schema: {
	meta: {
		created: string
		owner:   string
	}
	dims: {
		w: int
		h: int
	}
}

forward:
	meta:
		owner: input.ownerName
-- out/decompiled/history/0.0.thema --
schema: {
	ownerName: string
	meta:
		created: string
	dims: {
		w: int
		h: int
	}
}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				ownerName: string
				meta: {
					created: string
				}
				dims: {
					w: int
					h: int
				}
			}
		}
	}
	"1": {
		"0": {
			schema: {
				meta: {
					created: string
					owner:   string
				}
				dims: {
					w: int
					h: int
				}
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		input: _
		result: {
			meta: {
				created: input.meta.created
				owner:   input.ownerName
			}
			dims: input.dims
		}
	}
	"1.0->0.0": {
		input: _
		result: {
			ownerName: input.meta.owner
			meta:
				created: input.meta.created
			dims: input.dims
		}
	}
}
