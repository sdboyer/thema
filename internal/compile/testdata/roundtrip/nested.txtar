A nested restructure: a field moves into a struct that embeds its source, and
an untouched sibling struct is copied whole.
-- ship/history/0.0.thema --
Schema: {
	ownerName: string
	meta: {
		created: string
	}
	dims: {
		w: int
		h: int
	}
}
-- ship/1.0.thema --
Schema: {
	meta: {
		created: string
		owner:   string
	}
	dims: {
		w: int
		h: int
	}
}

ForwardLens: {
	v0_0: _
	v1_0: {
		meta: {
			owner: v0_0.ownerName
		}
	}
}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
Schema: {
	meta: {
		created: string
		owner:   string
	}
	dims: {
		w: int
		h: int
	}
}

ForwardLens: {
	v0_0: _
	v1_0: {
		meta: {
			owner: v0_0.ownerName
		}
	}
}
-- out/decompiled/history/0.0.thema --
Schema: {
	ownerName: string
	meta: {
		created: string
	}
	dims: {
		w: int
		h: int
	}
}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				ownerName: string
				meta: {
					created: string
				}
				dims: {
					w: int
					h: int
				}
			}
		}
	}
	"1": {
		"0": {
			schema: {
				meta: {
					created: string
					owner:   string
				}
				dims: {
					w: int
					h: int
				}
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			meta: {
				created: v0_0.meta.created
				owner:   v0_0.ownerName
			}
			dims: v0_0.dims
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			ownerName: v1_0.meta.owner
			meta:
				created: v1_0.meta.created
			dims: v1_0.dims
		}
	}
}
