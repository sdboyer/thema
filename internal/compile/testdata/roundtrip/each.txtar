each: a list of structs mapped element by element, with a rename and a drop
inside the body. The drop's derived lacuna aggregates over the elements, and
its message is refined by a DroppedField lacuna keyed through the list. each
has no derived inverse, so the backward lens is authored.
-- ship/history/0.0.thema --
Schema: {
	items: [...{
		title:   string
		legacy?: string
	}]
}
-- ship/1.0.thema --
Schema: {
	items: [...{
		name: string
	}]
}

ForwardLens: {
	v0_0: _
	v1_0: {
		items: _each(v0_0.items, {
			name:   _item.title
			legacy: _drop
		})
	}
	lacunas: {
		items: {
			legacy: [{
				type:    DroppedField
				message: "1.0 items have no legacy field; the old one is dropped"
			}]
		}
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		items: _each(v1_0.items, {
			title: _item.name
		})
	}
}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
Schema: {
	items: [...{name: string}]
}

ForwardLens: {
	v0_0: _
	v1_0: {
		items: _each(v0_0.items, {
			name:   _item.title
			legacy: _drop
		})
	}
	lacunas: {
		items: {
			legacy: [{
				type:    DroppedField
				message: "1.0 items have no legacy field; the old one is dropped"
			}]
		}
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		items: _each(v1_0.items, {title: _item.name})
	}
}
-- out/decompiled/history/0.0.thema --
Schema: {
	items: [...{
		title:   string
		legacy?: string
	}]
}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				items: [...{
					title:   string
					legacy?: string
				}]
			}
		}
	}
	"1": {
		"0": {
			schema: {
				items: [...{
					name: string
				}]
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		let _d_0 = [for i, _item in v0_0.items if _item.legacy != _|_ {
			path:  "items[\(i)].legacy"
			value: _item.legacy
		}]
		v1_0: {
			items: [for _item in v0_0.items {
				name: _item.title
			}]
		}
		lacunas: [{
			@thema(derived)
			condition:    len(_d_0) > 0
			sourceFields: _d_0
			message:      "1.0 items have no legacy field; the old one is dropped"
			type:         "DroppedField"
		}]
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			items: [for _item in v1_0.items {
				title: _item.name
			}]
		}
	}
}
