each: a list of structs mapped element by element, with a rename and a drop
inside the body. The drop's derived lacuna aggregates over the elements, and
its message is refined by a DroppedField lacuna keyed through the list. each
has no derived inverse, so the backward lens is authored.
-- ship/history/0.0.thema --
schema: {
	items: [...{
		title:   string
		legacy?: string
	}]
}
-- ship/1.0.thema --
schema: {
	items: [...{
		name: string
	}]
}

ForwardLens: {
	v0_0: _
	v1_0: {
		items: each(v0_0.items, {
			name:   item.title
			legacy: drop
		})
	}
	lacunas: {
		items: {
			legacy: [{
				type:    DroppedField
				message: "1.0 items have no legacy field; the old one is dropped"
			}]
		}
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		items: each(v1_0.items, {
			title: item.name
		})
	}
}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
schema: {
	items: [...{name: string}]
}

ForwardLens: {
	v0_0: _
	v1_0: {
		items: each(v0_0.items, {
			name:   item.title
			legacy: drop
		})
	}
	lacunas: {
		items: {
			legacy: [{
				type:    DroppedField
				message: "1.0 items have no legacy field; the old one is dropped"
			}]
		}
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		items: each(v1_0.items, {title: item.name})
	}
}
-- out/decompiled/history/0.0.thema --
schema: {
	items: [...{
		title:   string
		legacy?: string
	}]
}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				items: [...{
					title:   string
					legacy?: string
				}]
			}
		}
	}
	"1": {
		"0": {
			schema: {
				items: [...{
					name: string
				}]
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		let _d_0 = [for i, item in v0_0.items if item.legacy != _|_ {
			path:  "items[\(i)].legacy"
			value: item.legacy
		}]
		v1_0: {
			items: [for item in v0_0.items {
				name: item.title
			}]
		}
		lacunas: [{
			@thema(derived)
			condition:    len(_d_0) > 0
			sourceFields: _d_0
			message:      "1.0 items have no legacy field; the old one is dropped"
			type:         "DroppedField"
		}]
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			items: [for item in v1_0.items {
				title: item.name
			}]
		}
	}
}
