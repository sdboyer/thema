Both schemas are open (...), and 1.0 adds b. 0.0 admits a
b through its ... but does not declare one, so the derived backward lens
leaves b alone: translation carries it into 0.0 as a field 0.0 does not
declare, with no lacuna (#158, #193). Were 0.0 closed, the derived lens would
drop b with a DroppedField lacuna.
-- ship/history/0.0.thema --
Schema: {
	a!: string
	...
}
-- ship/1.0.thema --
Schema: {
	a!: string
	b!: bool
	...
}

ForwardLens: {
	v0_0: _
	v1_0: {
		b: true
	}
}
-- out/bind --
ok
-- out/decompiled/1.0.thema --
Schema: {
	a!: string
	b!: bool
	...
}

ForwardLens: {
	v0_0: _
	v1_0: {
		b: true
	}
}
-- out/decompiled/history/0.0.thema --
Schema: {
	a!: string
	...
}
-- out/normal.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a!: string
				...
			}
		}
	}
	"1": {
		"0": {
			schema: {
				a!: string
				b!: bool
				...
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			a: v0_0.a
			b: true
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			a: v1_0.a
		}
	}
}
