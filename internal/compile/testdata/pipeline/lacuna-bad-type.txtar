schema: {
	title: string
	count?: int
}
-- ship/1.0.thema --
schema: {
	title: string
	count: int & <10
}

forward: {
	count: from.count
	lacuna: {
		kind: "Guess"
		target: "count"
		message: "count is a placeholder"
	}
}

backward: {
	count: to.count
}
