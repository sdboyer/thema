# A lacuna reporting a constant the lens wrote (docs/ship.cue).
-- source.cue --
firstfield: string
-- target.cue --
firstfield: string
secondfield: int
-- lens.cue --
v0_0: _
v1_0: {firstfield: v0_0.firstfield, secondfield: -1}
lacunas: [{
	targetFields: [{path: "secondfield", value: v1_0.secondfield}]
	message: "placeholder"
	type: "Placeholder"
}]
-- out --
total
-- ir --
out: {
  out.firstfield <- in.firstfield
  out.secondfield = -1
}
lacuna Placeholder {
  target secondfield = out.secondfield
  message "placeholder"
}
