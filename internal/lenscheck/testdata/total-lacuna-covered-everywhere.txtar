# A lacuna whose condition tests a field unrelated to the patterns its target field is written under. The field is written on every instance (present and absent branches), so it is present whenever the lacuna applies.
-- source.cue --
name: string
count?: int
-- target.cue --
name: string
count: int
-- lens.cue --
v0_0: _
v1_0: {
	name: v0_0.name
	if v0_0.count != _|_ {count: v0_0.count}
	if v0_0.count == _|_ {count: 0}
}
lacunas: [{
	condition: v0_0.name == "legacy"
	targetFields: [{path: "count", value: v1_0.count}]
	message: "legacy records never recorded a count, so 0 may be real"
	type: "AmbiguousMapping"
}]
-- out --
total
-- ir --
out: {
  out.name <- in.name
  if in.count != _|_ {
    out.count <- in.count
  }
  if in.count == _|_ {
    out.count = 0
  }
}
lacuna AmbiguousMapping {
  when in.name == "legacy"
  target count = out.count
  message "legacy records never recorded a count, so 0 may be real"
}
