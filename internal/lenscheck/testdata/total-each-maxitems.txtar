# A list mapped element by element from a source list that list.MaxItems bounds into a target list that list.MaxItems bounds no tighter (#163).
-- source.cue --
import "list"
items: [...int] & list.MaxItems(2)
-- target.cue --
import "list"
items: [...int] & list.MaxItems(3)
-- lens.cue --
v0_0: _
v1_0: {items: [for x in v0_0.items {x}]}
-- out --
total
-- ir --
out: {
  out.items = each in.items {
    out.items[_] <- in.items[_]
  }
}
