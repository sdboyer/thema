# Type tests whose types together subsume every alternative of the tested field, each arm proven under its refinement (exemplars/narrowing).
-- source.cue --
boolish: "true" | "false" | bool | string
-- target.cue --
properbool: bool
-- lens.cue --
v0_0: _
v1_0: {
	if (v0_0.boolish & string) != _|_ {properbool: v0_0.boolish == "true"}
	if (v0_0.boolish & bool) != _|_ {properbool: v0_0.boolish}
}
lacunas: [{
	condition: ((v0_0.boolish & string) != _|_) && ((v0_0.boolish & ("true" | "false")) == _|_)
	sourceFields: [{path: "boolish", value: v0_0.boolish}]
	targetFields: [{path: "properbool", value: v1_0.properbool}]
	message: "lossy"
	type: "LossyFieldMapping"
}]
-- out --
total
-- ir --
out: {
  if (in.boolish & string) != _|_ {
    out.properbool = in.boolish == "true"
  }
  if (in.boolish & bool) != _|_ {
    out.properbool <- in.boolish
  }
}
lacuna LossyFieldMapping {
  when (in.boolish & string) != _|_ && (in.boolish & ("true" | "false")) == _|_
  source boolish = in.boolish
  target properbool = out.properbool
  message "lossy"
}
