# A lacuna condition p == c on a field written under (p & c) != _|_. On data the two tests are the same, so the write is implied by the condition.
-- source.cue --
k: string
-- target.cue --
a?: string
-- lens.cue --
v0_0: _
v1_0: {if (v0_0.k & "x") != _|_ {a: "1"}}
lacunas: [{
	condition: v0_0.k == "x"
	targetFields: [{path: "a", value: v1_0.a}]
	message: "set"
	type: "Placeholder"
}]
-- out --
total
