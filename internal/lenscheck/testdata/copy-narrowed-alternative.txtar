# A copy whose source has an alternative the target lacks (exemplars/expand 0.3->0.2).
-- source.cue --
withDefault?: *"foo" | "bar" | "baz"
-- target.cue --
withDefault?: *"foo" | "bar"
-- lens.cue --
v0_0: _
v1_0: {if v0_0.withDefault != _|_ {withDefault: v0_0.withDefault}}
-- out --
not total
v1_0.withDefault copies v0_0.withDefault, which was *"foo" | "bar" | "baz" and is now *"foo" | "bar" (compat rule value-narrowed) (rule copy-narrowed) @ lens.cue:2:8
