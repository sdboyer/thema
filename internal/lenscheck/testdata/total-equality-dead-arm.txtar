# An equality with a literal the source never holds: the arm is dead, and the copy under it has no alternatives rather than the literal.
-- source.cue --
a!: "x" | "y"
-- target.cue --
b!: "x" | "y"
-- lens.cue --
v0_0: _
v1_0: {
	if v0_0.a == "z" {b: v0_0.a}
	if v0_0.a != "z" {b: v0_0.a}
}
-- out --
total
