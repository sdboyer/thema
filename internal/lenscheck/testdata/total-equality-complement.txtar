# A required field written under an equality and under its negation (exemplars/defaultchange).
-- source.cue --
aunion: "foo" | *"bar" | "baz"
-- target.cue --
aunion: *"foo" | "bar" | "baz"
-- lens.cue --
v0_0: _
v1_0: {
	if v0_0.aunion == "bar" {aunion: "foo"}
	if v0_0.aunion != "bar" {aunion: v0_0.aunion}
}
lacunas: [{
	condition: v0_0.aunion == "bar"
	sourceFields: [{path: "aunion", value: v0_0.aunion}]
	targetFields: [{path: "aunion", value: v1_0.aunion}]
	message: "changed"
	type: "ChangedDefault"
}]
-- out --
total
-- ir --
out: {
  if in.aunion == "bar" {
    out.aunion = "foo"
  }
  if in.aunion != "bar" {
    out.aunion <- in.aunion
  }
}
lacuna ChangedDefault {
  when in.aunion == "bar"
  source aunion = in.aunion
  target aunion = out.aunion
  message "changed"
}
