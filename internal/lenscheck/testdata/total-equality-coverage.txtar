# Equalities with every constant alternative of the tested field.
-- source.cue --
t: 1 | 2
-- target.cue --
u: "a" | "b"
-- lens.cue --
v0_0: _
v1_0: {
	if v0_0.t == 1 {u: "a"}
	if v0_0.t == 2 {u: "b"}
}
-- out --
total
-- ir --
out: {
  if in.t == 1 {
    out.u = "a"
  }
  if in.t == 2 {
    out.u = "b"
  }
}
