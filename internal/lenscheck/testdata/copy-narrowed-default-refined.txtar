# A copy under an equality that admits the default: the omitting instance takes that arm and copies the disjunction.
-- source.cue --
d: *1 | int
-- target.cue --
d: *2 | int
-- lens.cue --
v0_0: _
v1_0: {
	if v0_0.d == 1 {d: v0_0.d}
	if v0_0.d != 1 {d: v0_0.d}
}
-- out --
not total
v1_0.d copies v0_0.d, which an instance may omit; it then fills with 1 in the source schema and with 2 in the target schema, and the copy has no single value (rule copy-narrowed) @ lens.cue:3:2
