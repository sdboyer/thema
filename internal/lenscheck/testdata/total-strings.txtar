# Total string functions, and a predicate on a string.
-- source.cue --
a: string
-- target.cue --
b: string
has: bool
-- lens.cue --
import "strings"
v0_0: _
v1_0: {b: strings.ToUpper(v0_0.a), has: strings.HasPrefix(v0_0.a, "x")}
-- out --
total
-- ir --
out: {
  out.b = strings.ToUpper(in.a)
  out.has = strings.HasPrefix(in.a, "x")
}
