# The whole input embedded beside a comprehension, carrying a field the target does not declare: the embedding is a copy however it is exported.
-- source.cue --
a!: int
o?: int
-- target.cue --
a!: int
x!: int
-- lens.cue --
input: _
result: {
	input
	if input.o != _|_ {x: 1}
	if input.o == _|_ {x: 0}
}
-- out --
not total
result copies input, whose o is declared in the source schema and not accepted by the new one (compat rule field-removed) (rule copy-narrowed) @ lens.cue:3:2
