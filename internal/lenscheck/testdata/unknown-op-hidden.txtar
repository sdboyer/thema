# A hidden result field that fails to evaluate: hidden fields are not data, but they are evaluated.
-- source.cue --
a!: int
-- target.cue --
b!: int
-- lens.cue --
input: _
result: {
	b:  input.a
	_h: input.a + "x"
}
-- out --
unknown
result._h applies + to an integer in [-inf, +inf] and a string (rule unknown-op) @ lens.cue:2:1
