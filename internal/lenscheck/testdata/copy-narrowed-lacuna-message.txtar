# A lacuna message copying an integer: the message must be a string.
-- source.cue --
a!: int
-- target.cue --
b!: int
-- lens.cue --
input: _
result: {b: input.a}
lacunas: [{
	sourceFields: [{path: "a", value: input.a}]
	message: input.a
	type:    "DroppedField"
}]
-- out --
not total
lacunas[0].message copies input.a, which was int and is now string (compat rule value-narrowed) (rule copy-narrowed) @ lens.cue:5:11
