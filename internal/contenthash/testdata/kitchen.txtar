A lineage using most of what schemas and lenses are written with: defaults,
optional and required fields, disjunctions, bounds, attributes, a builtin
package, patterns, lists, hidden fields, definitions inside a schema, a
joinSchema, a schema built on its predecessor, examples, conditional lens
results, and lacunas built from thema.Lacuna, which is hashed by name
(__ref("github.com/sdboyer/thema", "Lacuna")), not content.
-- in.cue --
package p

import (
	"strings"

	"github.com/sdboyer/thema"
)

lin: {
	name: "kitchen"
	joinSchema: {kind: string}
	schemas: {
		"0": {"0": {
		schema: {
			kind:  "kitchen"
			title: string & strings.MinRunes(1)
			// how many
			count?: int & >=0 @cuetsy(kind="type")
			mode:   *"auto" | "manual"
			tags: [...string]
			[=~"^x-"]: string
		}
		examples: basic: {kind: "kitchen", title: "t", tags: []}
		}
		"1": {
		schema: schemas["0"]["0"].schema & {
			owner?: #Person
			#Person: {name!: string, email?: string}
			_scratch: int | *0
		}
		}}
		"1": {"0": {
		schema: {
			kind:   "kitchen"
			title:  string & strings.MinRunes(1)
			count:  int & >=0 | *0
			mode:   "auto" | "manual" | *"auto"
			labels: [string]: string
			owner?: {name!: string, email?: string}
		}
		}}
	}
	lenses: {
		"0.1->0.0": {
		input: _
		result: {
			kind:  input.kind
			title: input.title
			if input.count != _|_ {count: input.count}
			mode: input.mode
			tags: input.tags
		}
		lacunas: [if input.owner != _|_ {
			thema.Lacuna & {
				sourceFields: [{path: "owner", value: input.owner}]
				message: "owner is dropped"
				type:    thema.LacunaTypes.DroppedField
			}
		}]
		}
		"0.1->1.0": {
		input: _
		result: {
			kind:  input.kind
			title: input.title
			count: *input.count | 0
			mode:  input.mode
			labels: {for t in input.tags {(t): t}}
			if input.owner != _|_ {owner: input.owner}
		}
		lacunas: []
		}
		"1.0->0.1": {
		input: _
		result: {
			kind:  input.kind
			title: input.title
			count: input.count
			mode:  input.mode
			tags: [for k, _ in input.labels {k}]
			if input.owner != _|_ {owner: input.owner}
		}
		lacunas: [thema.Lacuna & {
			sourceFields: [{path: "labels", value: input.labels}]
			message: "label values are dropped"
			type:    thema.LacunaTypes.LossyFieldMapping
		}]
		}
	}
}
