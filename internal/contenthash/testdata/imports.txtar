A lineage whose schemas and lenses refer to another package of its module.
The referenced content is hashed, not the import path: a definition through a
let CUE generates for it, a regular field inlined. A change in the package
changes the IDs of the versions that use it.
-- shared/shared.cue --
package shared

#Thing: {p: int, q?: string}
Reg: {r: int}
Fallback: {r: 0}
-- in.cue --
package p

import "example.com/p/shared"

lin: {
	name: "imports"
	schemas: [{
		version: [0, 0]
		schema: {a: shared.#Thing, b: shared.Reg}
	}, {
		version: [1, 0]
		schema: {a: shared.#Thing}
	}]
	lenses: [{
		from: [0, 0]
		to: [1, 0]
		input: _
		result: a: input.a
	}, {
		from: [1, 0]
		to: [0, 0]
		input: _
		result: {a: input.a, b: shared.Fallback}
	}]
}
