## embeddedRef
{
	k: R.#x

	//cue:path: #R
	let R = {
		#x: {
			a: int
			if INPUT.x != _|_ // explicit error (_|_ literal) in source
			{
				extra: 1
			}
		}
	}

	//cue:path: input
	let INPUT = _
}
