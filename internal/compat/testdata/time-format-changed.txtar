# a different time format
-- old.cue --
import "time"
t: time.Format(time.RFC3339)
-- new.cue --
import "time"
t: time.Format(time.RFC3339Date)
-- out --
incompatible
t: new replaces the validator time.Format("2006-01-02T15:04:05Z07:00") with time.Format("2006-01-02") [validator-added] @ new.cue:2:1
