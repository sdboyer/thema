# G1: a forward step to the next minor version applies no lens, and
# undeclared data follows C: here carried, the successor's struct being open.
# A minor version cannot close a struct, nor declare in an open one a label
# that does not accept every value (compat's labels rules), and capnp has no
# type accepting every value (rule top), so no compiled minor step promotes
# or sets aside undeclared data. 0.1 adds c to the closed struct s, and 0.2
# makes n defaulted, a new generation, so 0.1 -> 0.2 has a synthesized edge,
# which has no fate either. Going back, the lenses leave c alone, and 0.0's
# closed s does not declare it (B5).
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "fateG1"
schemas: {
	"0": "0": {
		schema: {
			a: string
			n: int8
			s: {x: string}
			...
		}
		examples: extra: {a: "x", n: 1, s: {x: "1"}, z: 1}
	}
	"0": "1": {
		schema: {
			a: string
			n: int8
			s: {x: string, c?: string}
			...
		}
		examples: extra: {a: "x", n: 1, s: {x: "1", c: "c"}, z: 1}
	}
	"0": "2": {
		schema: {
			a: string
			n: int8 | *0
			s: {x: string, c?: string}
			...
		}
		examples: extra: {a: "x", n: 1, s: {x: "1"}, z: 1}
	}
}
lenses: {
	"0.1->0.0": {
		v0_1: _
		v0_0: {a: v0_1.a, n: v0_1.n, s: x: v0_1.s.x}
	}
	"0.2->0.1": {
		v0_2: _
		v0_1: {a: v0_2.a, n: v0_2.n, s: x: v0_2.s.x}
	}
}
-- out/capnp --
