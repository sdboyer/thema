# C4: where the lens writes a field the target declares, its value wins over
# undeclared data of that name, which is dropped with a DroppedField (cause
# written); none where the values are equal.
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "fateC4"
schemas: {
	"0": "0": {
		schema: {
			a: string
			...
		}
		examples: {
			one: {a: "x", stamp: "mine"}
			both: {a: "x", stamp: "mine", mark: "m"}
			equal: {a: "x", stamp: "s"}
		}
	}
	"1": "0": {
		schema: {
			a:     string
			stamp: string
			mark:  string
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {a: v0_0.a, stamp: "s", mark: "k"}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {a: v1_0.a}
	}
}
