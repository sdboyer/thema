edge 0.0 -> 1.0
  out: {
    out.a <- in.a
    out.stamp = "s"
    out.mark = "k"
  }
edge 1.0 -> 0.0
  out: {
    out.a <- in.a
  }
checks
  1.0 FateC4V1.stamp: (type(x) == string)
  1.0 FateC4V1.mark: (type(x) == string)
-- out/capnp/fate --
version 0.0
  struct (root) FateC4V0 open: a
version 1.0
