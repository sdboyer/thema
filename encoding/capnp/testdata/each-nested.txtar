	"1": "0": schema: {
		s: [...{f: [...{m: string}], k: int8}]
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {s: [for _item in v0_0.s {k: _item.k, f: [for _item in _item.f {m: strings.TrimSpace(_item.n)}]}]}
