# C2: undeclared data under a name the target declares, which the lens does
# not write, is promoted into the field where it is an instance of it, over a
# default too. The checks for 1.0's b and flag decide it.
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "fateC2"
schemas: {
	"0": "0": {
		schema: {
			a: string
			...
		}
		examples: fits: {a: "x", b: true, flag: false}
	}
	"1": "0": {
		schema: {
			a:    string
			b?:   bool
			flag: bool | *true
			...
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {a: v0_0.a}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {a: v1_0.a}
	}
}
-- out/capnp --
# Generated by thema from lineage fateC2. DO NOT EDIT.
@0xff9aeeddd912c2f9;

# FateC2V0: versions 0.0
struct FateC2V0 @0xb4ba153e22f259fc {
  extras @0 :Data;
  a @1 :Text;
}

# FateC2V1: versions 1.0
struct FateC2V1 @0x9d28e571aee7502f {
  extras @0 :Data;
  a @1 :Text;
  b :union {
    unset @2 :Void;
    value @3 :Bool;
  }
  flag @4 :Bool = true;
}
-- out/capnp/programs --
edge 0.0 -> 1.0
  out: {
    out.a <- in.a
  }
edge 1.0 -> 0.0
  out: {
    out.a <- in.a
  }
checks
  1.0 FateC2V1.b: (type(x) == bool)
  1.0 FateC2V1.flag: (type(x) == bool)
-- out/capnp/fate --
version 0.0
  struct (root) FateC2V0 open: a
version 1.0
  struct (root) FateC2V1 open: a, b, flag
edge 0.0 -> 1.0
  read a
  reader a <- a
  copy a <- a
edge 1.0 -> 0.0
  read a
  reader a <- a
  copy a <- a
-- out/capnp/artifact --
sha256 83a76f33bb995ee8cb881e24f5503ca351a117a79ca50342d0b0e51a7a878ce0
4688 bytes
-- out/capnp/layout --
struct FateC2V0 @0xb4ba153e22f259fc: data=0 ptrs=2
  extras @0: data off=0
  a @1: text off=1
struct FateC2V1 @0x9d28e571aee7502f: data=1 ptrs=2
  extras @0: data off=0
  a @1: text off=1
  b: group @0xde6d73f02ac2eccd
  flag @4: bool off=17 default=true
struct FateC2V1.b @0xde6d73f02ac2eccd: data=1 ptrs=2 disc=2@0 group
  unset @2: void off=0 disc=0
  value @3: bool off=16 disc=1
-- out/capnp/translate --
0.0 fits -> 1.0
  in  {"a":"x","b":true,"flag":false}
  out {"a":"x","flag":false,"b":true}
