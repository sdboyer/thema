			if v0_1.color == "green" {color: "red"}
			inner: a: v0_1.inner.a
			if v0_1.opt != _|_ {opt: v0_1.opt}
		}
	}
	"0.1->1.0": {
		v0_1: _
		v1_0: {
			count: v0_1.n
			color: v0_1.color
			kind: null
			inner: v0_1.inner
		}
	}
	"1.0->0.1": {
		v1_0: _
		v0_1: {
			n: v1_0.count
			color: v1_0.color
			inner: v1_0.inner
		}
	}
	"1.1->1.0": {
		v1_1: _
