# C7: undeclared data inside list elements is carried element by element, by
# index. The forward lens shortens the list to one element, so the elements
# past it, which nothing maps, are dropped whole (#196's reading: as B6);
# the backward lens maps each element, and each keeps its own extras; rank,
# which 0.0's open elements do not declare, is carried with them (B4).
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "fateC7"
schemas: {
	"0": "0": {
		schema: {
			items: [...{name: string, ...}]
		}
		examples: three: {items: [{name: "a", color: "red"}, {name: "b"}, {name: "c", color: "blue"}]}
	}
	"1": "0": {
		schema: {
			items: [...{name: string, rank: int8, ...}]
		}
		examples: two: {items: [{name: "a", rank: 1, color: "red"}, {name: "b", rank: 2, size: 2}]}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: items: [{name: "first", rank: 1}]
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: items: [for x in v1_0.items {name: x.name}]
	}
}
-- out/capnp --
# Generated by thema from lineage fateC7. DO NOT EDIT.
@0xf32bdb00aa0803c0;

# FateC7V0: versions 0.0
struct FateC7V0 @0xfa8fa665a07059e8 {
  extras @0 :Data;
  items @1 :List(ItemsItem);
  struct ItemsItem @0x84b2b0c599e36483 {
    extras @0 :Data;
    name @1 :Text;
  }
}

# FateC7V1: versions 1.0
struct FateC7V1 @0xb43775a78a082db6 {
  extras @0 :Data;
  items @1 :List(ItemsItem);
  struct ItemsItem @0xd831c33ed36de974 {
    extras @0 :Data;
    name @1 :Text;
    rank @2 :Int8;
  }
}
-- out/capnp/programs --
edge 0.0 -> 1.0
  out: {
    out.items: [1] {
      out.items[0]: {
        out.items[0].name = "first"
        out.items[0].rank = 1
      }
    }
  }
edge 1.0 -> 0.0
  out: {
    out.items = each in.items {
      out.items[_].name <- in.items[_].name
    }
  }
checks
  1.0 FateC7V1.ItemsItem.rank: ((type(x) == int) && (x >= -128) && (x <= 127))
-- out/capnp/fate --
version 0.0
  struct (root) FateC7V0 closed: items
  struct items[_] FateC7V0.ItemsItem open: name
version 1.0
  struct (root) FateC7V1 closed: items
  struct items[_] FateC7V1.ItemsItem open: name, rank
edge 0.0 -> 1.0
edge 1.0 -> 0.0
  read items[_].name
  reader items <- items[_].name
