  in  {"items":[{"name":"a","color":"red"},{"name":"b"},{"name":"c","color":"blue"}]}
  out {"items":[{"name":"first","rank":1,"color":"red"}]}
  lacuna {"sourceFields":[{"path":"items[1]","value":{"name":"b"}},{"path":"items[2]","value":{"color":"blue","name":"c"}}],"type":"DroppedField","message":"items[1], items[2] set aside: the lens from 0.0 to 1.0 neither maps nor writes them"}
