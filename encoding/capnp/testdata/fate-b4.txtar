# B4 (docs/translation.md): a field the source declares, which the lens does
# not map and the target does not declare, is carried into the target's open
# struct as undeclared data. 1.0 declares b, 0.0 does not and is open, and
# the lenses map only a: going back, b is carried into 0.0. The fate section
# records what the engine reads for it: 0.0's root is open and does not
# declare b, and the backward lens reads only a.
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "fateB4"
schemas: {
	"0": "0": {
		schema: {
			a: string
			...
		}
		examples: plain: {a: "x"}
	}
	"1": "0": {
		schema: {
			a:  string
			b?: bool
			...
		}
		examples: {
			withB: {a: "x", b: false}
			withoutB: {a: "x"}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {a: v0_0.a}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {a: v1_0.a}
	}
}
-- out/capnp --
