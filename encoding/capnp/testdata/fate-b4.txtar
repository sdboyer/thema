@0xda4b067bc9df80ad;

# FateB4V0: versions 0.0
struct FateB4V0 @0xb6dab253707aa320 {
  extras @0 :Data;
  a @1 :Text;
}

# FateB4V1: versions 1.0
struct FateB4V1 @0x8f65819f5fc62aa5 {
  extras @0 :Data;
  a @1 :Text;
  b :union {
    unset @2 :Void;
    value @3 :Bool;
  }
}
-- out/capnp/programs --
edge 0.0 -> 1.0
  out: {
    out.a <- in.a
  }
edge 1.0 -> 0.0
  out: {
    out.a <- in.a
  }
checks
  1.0 FateB4V1.b: (type(x) == bool)
-- out/capnp/fate --
version 0.0
  struct (root) FateB4V0 open: a
version 1.0
  struct (root) FateB4V1 open: a, b
edge 0.0 -> 1.0
  read a
  reader a <- a
  copy a <- a
edge 1.0 -> 0.0
  read a
  reader a <- a
  copy a <- a
