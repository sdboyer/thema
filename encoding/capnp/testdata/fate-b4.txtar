struct FateB4V1 @0x8f65819f5fc62aa5: data=1 ptrs=2
  extras @0: data off=0
  a @1: text off=1
  b: group @0x81d0ce231266af6d
struct FateB4V1.b @0x81d0ce231266af6d: data=1 ptrs=2 disc=2@0 group
  unset @2: void off=0 disc=0
  value @3: bool off=16 disc=1
-- out/capnp/translate --
0.0 plain -> 1.0
  in  {"a":"x"}
  out {"a":"x"}
1.0 withB -> 0.0
  in  {"a":"x","b":false}
