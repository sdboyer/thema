# Computed expressions and lacunas render to CEL, with the divergences
# between CUE and CEL rewritten: quo and rem are CEL's / and %, div and mod
# (floored) are written in terms of them, len of a string counts bytes,
# interpolation concatenates with string(), and strings.Replace with -1 is
# the two-argument replace. A match in an expression is the type test on the
# input's kind and bounds.
-- in.cue --
import (
	"strings"
	"github.com/sdboyer/thema"
)

thema.Lineage
name: "ops"
schemas: {
	"0": "0": schema: {
		a:    int32
		b:    int32
		s:    string
		xs:   [...string]
		flag: bool
	}
	"1": "0": schema: {
		sum:    int64
		diff:   int64
		prod:   int64
		neg:    int64
		q:      int64
		r:      int64
		dv:     int64
		md:     int64
		msg:    string
		has:    bool
		pre:    bool
		suf:    bool
		trim:   string
		n:      int64
		cnt:    int64
		rep:    string
		cmp:    bool
		both:   bool
		either: bool
		fits:   bool
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			sum:    v0_0.a + v0_0.b
			diff:   v0_0.a - v0_0.b
			prod:   v0_0.a * v0_0.b
			neg:    -v0_0.a
			q:      quo(v0_0.a, 2)
			r:      rem(v0_0.a, 2)
			dv:     div(v0_0.a, 2)
			md:     mod(v0_0.a, 2)
			msg:    "a=\(v0_0.a), s=\(v0_0.s)"
			has:    strings.Contains(v0_0.s, "x")
			pre:    strings.HasPrefix(v0_0.s, "x")
			suf:    strings.HasSuffix(v0_0.s, "x")
			trim:   strings.TrimSpace(v0_0.s)
			n:      len(v0_0.s)
			cnt:    len(v0_0.xs)
			rep:    strings.Replace(v0_0.s, "a", "b", -1)
			cmp:    v0_0.a < v0_0.b
			both:   v0_0.flag && v0_0.a == 1
			either: v0_0.flag || v0_0.a != 1
			fits:   (v0_0.a & int8) != _|_
		}
		lacunas: [
			thema.Lacuna & {
				condition: v0_0.a < 0
				sourceFields: [{path: "a", value: v0_0.a}]
				targetFields: [{path: "neg", value: v1_0.neg}]
				message: "a was \(v0_0.a), which is negative"
				type:    thema.LacunaTypes.LossyFieldMapping
			},
		]
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			a:    0
			b:    0
			s:    v1_0.msg
			xs:   []
			flag: v1_0.has
		}
	}
}
