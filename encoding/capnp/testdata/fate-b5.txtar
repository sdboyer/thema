# B5: a field the source declares, which the lens does not map and the
# target does not declare, is dropped with a DroppedField where the target's
# struct is closed (old, s.y: cause closed) or the result has no struct to
# carry it in (t.y: t became t2, cause nowhere). A DroppedField the lens lists
# (gone) supersedes the automatic one.
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "fateB5"
schemas: {
	"0": "0": {
		schema: {
			a:    string
			gone: string
			old?: string
			s: {x: string, y?: string}
			t: {x: string, y?: string}
		}
		examples: {
			full: {a: "x", gone: "g", old: "o", s: {x: "1", y: "2"}, t: {x: "3", y: "4"}}
			bare: {a: "x", gone: "g", s: {x: "1"}, t: {x: "3"}}
		}
	}
	"1": "0": {
		schema: {
			a: string
			s: {x: string}
			t2: {x: string}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {a: v0_0.a, s: x: v0_0.s.x, t2: x: v0_0.t.x}
		lacunas: [{
			type:    "DroppedField"
			message: "gone is gone"
			sourceFields: [{path: "gone", value: v0_0.gone}]
		}]
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {a: v1_0.a, gone: "g", s: x: v1_0.s.x, t: x: v1_0.t2.x}
	}
}
