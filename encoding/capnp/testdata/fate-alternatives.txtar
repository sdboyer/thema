# The struct alternatives of a disjunction share a path and differ by node,
# and each is open or closed as its author wrote it: u's alternative tagged
# "a" is open, the one tagged "b" closed. Openness is read by validation
# against the closed schema, as translation places a field, never through
# Allows: an alternative as compat.Branches returns it allows every label.
# Undeclared data in the open alternative follows u, which the lens copies
# whole (C6), and is carried (C1).
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "fateAlternatives"
schemas: {
	"0": "0": {
		schema: {
			u: {k: "a", ...} | {k: "b", n: int8}
		}
		examples: {
			openAlt: {u: {k: "a", z: 1}}
			closedAlt: {u: {k: "b", n: 1}}
		}
	}
	"1": "0": {
		schema: {
			u: {k: "a", ...} | {k: "b", n: int8}
			v: int8
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {u: v0_0.u, v: 1}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {u: v1_0.u}
	}
}
