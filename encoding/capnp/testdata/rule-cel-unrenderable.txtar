# rule cel-unrenderable: a computed expression CUE and CEL disagree on has no
# faithful rendering: strings.ToUpper and strings.ToLower map case per Unicode
# in CUE and per ASCII in CEL. One finding per expression.
-- in.cue --
import (
	"strings"
	"github.com/sdboyer/thema"
)

thema.Lineage
name: "unrenderable"
schemas: {
	"0": "0": schema: {
		s: string
	}
	"1": "0": schema: {
		s:   string
		up:  string
		low: string
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			s:   v0_0.s
			up:  strings.ToUpper(v0_0.s)
			low: strings.ToLower(v0_0.s)
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: s: v1_0.s
	}
}
-- out/capnp --
rejected
lens 0.0->1.0: low calls strings.ToLower, whose CEL counterpart changes ASCII only (rule cel-unrenderable) @ /in.cue:19:2
lens 0.0->1.0: up calls strings.ToUpper, whose CEL counterpart changes ASCII only (rule cel-unrenderable) @ /in.cue:19:2
