			kept?: string
			two?:  string
		}
		examples: {
			one: {a: "x", kept: "k"}
			both: {a: "x", kept: "k", two: "t"}
		}
	}
	"1": "0": {
		schema: {
			a:     string
			kept?: string
			two?:  string
			v:     int8
		}
		examples: one: {a: "x", kept: "k", v: 1}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {a: v0_0.a, v: 1}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {a: v1_0.a}
	}
}
