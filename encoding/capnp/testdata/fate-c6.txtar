# C6: undeclared data follows a struct the lens takes whole, by a move
# (info: v0_0.meta) or an embedding (conf: {v0_0.cfg, b: 1}), and C1-C5 apply
# at its new path. conf declares b, which 0.0's open cfg does not: an extra
# cfg.b would arrive there, so the artifact carries a check for it, though
# the lens writes b (C4). Going back, cfg is assembled from a part of conf,
# so conf's other fields have no conf to go to.
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "fateC6"
schemas: {
	"0": "0": {
		schema: {
			meta: {owner: string, ...}
			cfg: {a: int8, ...}
		}
		examples: {
			carried: {meta: {owner: "o", tag: "t"}, cfg: {a: 1, tag: "c"}}
			written: {meta: {owner: "o"}, cfg: {a: 1, b: 5}}
		}
	}
	"1": "0": {
		schema: {
			info: {owner: string, ...}
			conf: {a: int8, b: int8, ...}
		}
		examples: moved: {info: {owner: "o", tag: "t"}, conf: {a: 1, b: 2, tag: "c"}}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			info: v0_0.meta
			conf: {v0_0.cfg, b: 1}
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			meta: v1_0.info
			cfg: a: v1_0.conf.a
		}
	}
}
-- out/capnp --
