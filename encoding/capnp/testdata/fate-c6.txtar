    extras @0 :Data;
    owner @1 :Text;
  }
  struct Cfg @0xff3d6e722e585a6a {
    extras @0 :Data;
    a @1 :Int8;
  }
}

# FateC6V1: versions 1.0
struct FateC6V1 @0x8ab13d4062f2562f {
  extras @0 :Data;
  info @1 :Info;
  conf @2 :Conf;
  struct Info @0x9c3f8e7d5a325004 {
    extras @0 :Data;
    owner @1 :Text;
  }
  struct Conf @0xfa1f2241279dd11d {
    extras @0 :Data;
    a @1 :Int8;
    b @2 :Int8;
  }
}
-- out/capnp/programs --
edge 0.0 -> 1.0
  out: {
    out.info <- in.meta
    out.conf: {
      out.conf <- in.cfg
      out.conf.b = 1
    }
  }
edge 1.0 -> 0.0
  out: {
    out.meta <- in.info
    out.cfg: {
      out.cfg.a <- in.conf.a
    }
  }
checks
  1.0 FateC6V1.info: ((type(x) == map) && (("owner" in x) && (type(x["owner"]) == string)) && (x.all(k1, k1 in ["owner"])))
  1.0 FateC6V1.conf: ((type(x) == map) && (("a" in x) && ((type(x["a"]) == int) && (x["a"] >= -128) && (x["a"] <= 127))) && (("b" in x) && ((type(x["b"]) == int) && (x["b"] >= -128) && (x["b"] <= 127))) && (x.all(k1, k1 in ["a", "b"])))
  1.0 FateC6V1.Conf.b: ((type(x) == int) && (x >= -128) && (x <= 127))
-- out/capnp/fate --
version 0.0
  struct (root) FateC6V0 closed: meta, cfg
  struct meta FateC6V0.Meta open: owner
  struct cfg FateC6V0.Cfg open: a
version 1.0
  struct (root) FateC6V1 closed: info, conf
  struct info FateC6V1.Info open: owner
  struct conf FateC6V1.Conf open: a, b
edge 0.0 -> 1.0
  read meta
  read cfg
  reader info <- meta
  reader conf <- cfg
  copy info <- meta
  copy conf <- cfg
edge 1.0 -> 0.0
  read info
  read conf.a
  reader meta <- info
  reader cfg.a <- conf.a
  copy meta <- info
  copy cfg.a <- conf.a
