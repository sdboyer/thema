thema.Lineage
name: "fateC1"
schemas: {
	"0": "0": {
		schema: {
			a: string
			...
		}
		examples: extras: {a: "x", z: 1, w: "s"}
	}
	"1": "0": {
		schema: {
			a: string
			v: int8
			...
		}
		examples: extras: {a: "x", v: 1, z: 2}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {a: v0_0.a, v: 1}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {a: v1_0.a}
	}
}
