# Writes into a disjunction of structs, lowered to union members: a copy
# carries one source member to the target member its alternative lands in
# (the IR's Copy.Alts), and a struct literal of one alternative sets that
# member (Wrap.Alt). Going back, equalities on the tag refine the copied
# alternatives one per arm, and the alternative the target lacks becomes a
# literal of another. Members are named by ordinal, as the layout reads them.
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "unionWrites"
schemas: {
	"0": "0": schema: {
		r: {k: "a", x: string} | {k: "b", n: int8}
		s: string
	}
	"1": "0": schema: {
		r: {k: "a", x: string} | {k: "b", n: int8} | {k: "c"}
		w: {k: "a", x: string} | {k: "b", n: int8}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			r: v0_0.r
			w: {k: "a", x: v0_0.s}
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			if v1_0.r.k == "a" {r: v1_0.r}
			if v1_0.r.k == "b" {r: v1_0.r}
			if v1_0.r.k == "c" {r: {k: "a", x: "wasc"}}
			s: ""
		}
	}
}
