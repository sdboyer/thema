import "github.com/sdboyer/thema"

thema.Lineage
name: "fateE3a"
schemas: {
	"0": "0": {
		schema: {
			q?: {a!: int8, b?: int8, tags?: [...string]}
		}
	}
	"1": "0": {
		schema: {
			q?: {a!: int8}
			b?: int8
			tags?: [...string]
		}
		examples: {
			bOnly: {b: 2}
			bAndTags: {b: 2, tags: ["x"]}
			withQ: {q: {a: 1}, b: 2}
			emptyTags: {b: 2, tags: []}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			if v0_0.q != _|_ {
				q: a: v0_0.q.a
				if v0_0.q.b != _|_ {b: v0_0.q.b}
				if v0_0.q.tags != _|_ {tags: v0_0.q.tags}
			}
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			if v1_0.q != _|_ {
				q: {
					a: v1_0.q.a
					if v1_0.b != _|_ {b: v1_0.b}
					if v1_0.tags != _|_ {tags: v1_0.tags}
				}
			}
		}
	}
}
