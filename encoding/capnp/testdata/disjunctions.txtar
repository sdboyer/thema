# Discriminated disjunctions: alternatives of pairwise distinct kinds become
# union members named as<Kind>; struct alternatives sharing a label holding a
# distinct constant in each become members named after the tag, each a
# nested struct; null is a Void member. Constants of one kind collapse to a
# type (enum, hull integer). A disjunction as a list element is boxed in a
# struct holding an anonymous union; as a map value it is the entry's value
# union. Mixed kinds beside tagged structs are allowed.
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "disjunctions"
schemas: "0": "0": schema: {
	kinds:        string | int32 | bool | null | bytes
	withList:     string | [...int8]
	withStruct:   string | {a: string}
	tagged:       {kind: "circle", r: uint8} | {kind: "square", side: uint8}
	intTagged:    {t: 1, a: string} | {t: 2, b: string}
	boolTagged:   {on: true, a: string} | {on: false}
	taggedAndKind: string | {kind: "a", x: string} | {kind: "b", y: string}
	strings:      "a" | "b" | int8
	ints:         1 | 2 | string
	optional?:    string | int32
	elems:        [...string | int32]
	mapped:       [string]: string | int32
	mappedList:   [string]: [...string | int32]
	nested: inner: string | bool
	doubleList:   [...[...string | bool]]
	taggedElems:  [...{kind: "a", x: string} | {kind: "b", y: string}]
	nullable:     string | null
}
lenses: {}
