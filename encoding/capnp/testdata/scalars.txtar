	i64:      int64
	u8:       uint8
	u16:      uint16
	u32:      uint32
	u64:      uint64
	small:    int & >=0 & <=100
	negative: int & >=-5 & <=5
	wide:     int & >=-1 & <=300
	huge:     int & >=0 & <=4294967296
	constant: 42
	negConst: -1
	bigConst: 70000
	intHull:  1 | 2 | 300
	strConst: "fixed"
	defBool:  *true | bool
	defStr:   *"hello \"world\"\n" | string
	defBytes: *'\x00\xff' | bytes
	defInt:   *5 | int8
	defEnum:  *"a" | "b" | "c"
	defNeg:   *-3 | int & >=-10 & <=10
}
lenses: {}
