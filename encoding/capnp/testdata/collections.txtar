# Collections: open lists to List(T); closed lists of one element type the
# same; a struct of a lone [string]: T pattern to List(Entry) with key and
# value; nested structs to nested struct nodes named after the field, each
# with its extras field; an empty struct to a struct with only extras. Labels
# are sanitized to capnp names; a label colliding with extras is renamed.
-- in.cue --
import "github.com/sdboyer/thema"

thema.Lineage
name: "collections"
schemas: "0": "0": schema: {
	strings:    [...string]
	ints:       [...uint8]
	nested:     [...[...string]]
	closed:     [string, string]
	structs:    [...{a: string, b?: int8}]
	stringMap:  [string]: int8
	listMap:    [string]: [...string]
	mapMap:     [string]: [string]: bool
	structMap:  [string]: {a: string}
	mapList:    [...{[string]: string}]
	inner: {
		a: string
		deeper: {
			b: bool
		}
	}
	empty:      {}
	emptyList:  []
	emptyElems: [...{}]
	emptyMap:   [string]: {}
	Capital:    string
	"with space": string
	"kebab-case": string
	"1starts":  string
	snake_case: string
	extras:     string
}
lenses: {}
