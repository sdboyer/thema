{
  "ok": true,
  "diagnostics": [],
  "version": "0.0",
  "output": "{\n  \"openapi\": \"3.0.0\",\n  \"info\": {\n    \"title\": \"ship\",\n    \"version\": \"0.0\"\n  },\n  \"paths\": {},\n  \"components\": {\n    \"schemas\": {\n      \"ship\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"name\"\n        ],\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          }\n        },\n        \"$schema\": \"http://json-schema.org/draft-04/schema#\"\n      }\n    }\n  }\n}\n"
}
