#op: translate
#raw: false
Translating into the tip needs the ForwardLens it does not write yet: the
translation fails with E1002, not with a lens error.
-- request.json --
{"from": "0.0", "to": "1.0"}
-- ship/history/0.0.thema --
Schema: {
	name: string
	crew: int
}
-- ship/tip.thema --
Schema: {
	name: string
}
-- data.json --
{"name": "Argo", "crew": 50}
-- out/response.json --
{
  "ok": false,
  "diagnostics": [
    {
      "code": "E1002",
      "severity": "error",
      "headline": "translating from v0.0 to v1.0 needs the ForwardLens of tip, which is not written yet",
      "path": [
        "lenses",
        "0.0-\u003e1.0"
      ],
      "address": {
        "from": [
          0,
          0
        ],
        "kind": "lens",
        "to": [
          1,
          0
        ]
      },
      "notes": [
        {
          "label": "v1.0 is provisional: the schema of tip, which is still being worked on, and whose lenses may not be written yet"
        }
      ],
      "help": [
        "write the ForwardLens of tip"
      ]
    }
  ],
  "from": "0.0",
  "to": "tip",
  "cutsAs": "1.0"
}
