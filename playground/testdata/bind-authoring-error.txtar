#op: bind
A lineage in the authoring form that compiles but does not bind is reported
in the authoring form's terms, and its normal form is still returned.
-- ship/history/0.0.thema --
Schema: {
	a: int32
}
-- ship/1.0.thema --
Schema: {
	a: int32 & >=0
}

ForwardLens: {
	v0_0: _
	v1_0: {
		a: v0_0.a * 2
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		a: v1_0.a
	}
}
