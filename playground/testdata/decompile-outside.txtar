#op: decompile
A lens the compiler would not have produced is refused, with the reason, rather
than approximated.
-- lineage.cue --
name: "ship"
schemas: {
	"0": "0": {
		schema: {
			name: string
		}
	}
	"1": "0": {
		schema: {
			title: string
			crew:  int | *1
		}
	}
}
lenses: {
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			name: v1_0.title
		}
		lacunas: [{
			sourceFields: [{path: "crew", value: v1_0.crew}]
			message: "crew is dropped"
			type:    "DroppedField"
		}]
	}
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			title: v0_0.name
			crew:  1
		}
		lacunas: [{
			targetFields: [{path: "crew", value: v1_0.crew}]
			message: "crew is a placeholder"
			type:    "Placeholder"
		}]
	}
}
-- out/response.json --
{
  "ok": false,
  "diagnostics": [
    {
      "code": "E0356",
      "severity": "error",
      "headline": "lens 1.0-\u003e0.0 is outside the authoring form: a lacuna on a field no mapping produces",
      "primary": {
        "file": "lineage.cue",
        "line": 1,
        "col": 1,
        "origin": "user"
      },
      "help": [
        "the authoring form expresses the lenses Compile produces: mappings that copy and compute, and _drop, _orelse, _match and _each"
      ]
    }
  ]
}
