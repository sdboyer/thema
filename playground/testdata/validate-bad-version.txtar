#op: validate
A version in a request that is not of the form major.minor.
-- request.json --
{"version": "1"}
-- lineage.cue --
name: "ship"
schemas: {
	"0": "0": {
		schema: {
			name: string
		}
	}
	"1": "0": {
		schema: {
			title: string
			crew:  int | *1
		}
	}
}
lenses: {
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			name: v1_0.title
		}
		lacunas: [{
			sourceFields: [{path: "crew", value: v1_0.crew}]
			message: "crew is dropped"
			type:    "DroppedField"
		}]
	}
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			title: v0_0.name
			crew:  1
		}
		lacunas: [{
			targetFields: [{path: "crew", value: v1_0.crew}]
			message: "crew is a placeholder"
			type:    "Placeholder"
		}]
	}
}
-- data.json --
{"name": "Argo"}
-- out/response.json --
{
  "ok": false,
  "diagnostics": [
    {
      "code": "E0803",
      "severity": "error",
      "headline": "\"1\" is not a version",
      "help": [
        "a version is \u003cmajor\u003e.\u003cminor\u003e, such as 1.0"
      ]
    }
  ]
}
