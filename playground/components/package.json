{
  "name": "@sdboyer/thema-ui",
  "version": "0.0.0",
  "description": "thema's CUE editor, diagnostics and wire types for the browser: the pieces the thema playground is built from.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdboyer/thema.git",
    "directory": "playground/components"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors/*": "./errors/*"
  },
  "files": [
    "dist",
    "errors",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@lezer/highlight": "^1.2.5",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@codemirror/commands": "6.7.1",
    "@codemirror/lang-json": "6.0.1",
    "@codemirror/language": "6.10.8",
    "@codemirror/lint": "6.8.4",
    "@codemirror/search": "6.5.8",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.36.1",
    "@lezer/highlight": "1.2.5",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.5",
    "jsdom": "25.0.1",
    "preact": "10.29.8",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
