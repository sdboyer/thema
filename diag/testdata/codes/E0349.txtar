#op: develop
coalesce's fallback is what the lens uses when the field is absent, so the
fallback itself must always exist: a constant, or a field the source always
has. An optional field may be absent too.
-- ship/history/0.0.thema --
Schema: {
	a?: string
	b?: string
}
-- ship/tip.thema --
Schema: {
	c: string
}

ForwardLens: {
	v0_0: _
	tip: {
		c: _coalesce(v0_0.a, v0_0.b)
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0349",
      "severity": "error",
      "headline": "b is optional in v0.0, so it cannot be _coalesce's fallback: the fallback must always exist",
      "primary": {
        "file": "tip.thema",
        "line": 8,
        "col": 24,
        "offset": 79,
        "origin": "user"
      }
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
