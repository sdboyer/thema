#op: bind
A literal the lens writes is not an instance of the target at that path. Here
the target wants a list of one int and the lens writes two elements.
-- lineage.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a: int
			}
		}
	}
	"1": {
		"0": {
			schema: {
				l: [int]
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			l: [v0_0.a, 1]
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			a: v1_0.l[0]
		}
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0366",
      "severity": "error",
      "headline": "l in the result of lens 0.0->1.0 is a list of 2 elements, which the target schema does not accept: incompatible list lengths (1 and 2)",
      "path": [
        "lenses",
        "0.0->1.0",
        "v1_0",
        "l"
      ],
      "address": {
        "field": [
          "l"
        ],
        "from": [
          0,
          0
        ],
        "kind": "lensResultField",
        "to": [
          1,
          0
        ]
      },
      "primary": {
        "file": "lineage.cue",
        "line": 22,
        "col": 4,
        "offset": 182,
        "origin": "user"
      },
      "notes": [
        {
          "label": "a lens must be total: every instance of schema 0.0 must translate to an instance of schema 1.0 (totality rule literal-not-instance)"
        }
      ]
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
