#op: compile
A drop inside an each body aggregates over the list: its lacuna applies when
any element had the field. Such a lacuna has no `when` of its own.
-- ship/history/0.0.thema --
schema: {
	items: [...{
		name:    string
		legacy?: string
	}]
}
-- ship/1.0.thema --
schema: {
	items: [...{
		name: string
	}]
}

ForwardLens: {
	v0_0: _
	v1_0: {
		items: each(v0_0.items, {
			legacy: drop
		})
	}
	lacunas: {
		items: {
			legacy: [{
				type:    DroppedField
				message: "legacy was dropped"
				when:    v0_0.items != _|_
			}]
		}
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		items: each(v1_0.items, {
			name: item.name
		})
	}
}
