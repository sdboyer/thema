#op: compile
A drop inside an each body aggregates over the list: its lacuna applies when
any element had the field. Such a lacuna has no `when` of its own.
-- ship/history/0.0.thema --
Schema: {
	items: [...{
		name:    string
		legacy?: string
	}]
}
-- ship/history/1.0.thema --
Schema: {
	items: [...{
		name: string
	}]
}

ForwardLens: (prev): {
	self: {
		items: _each(prev.items, {
			legacy: _drop
		})
	}
	lacunas: {
		items: {
			legacy: [{
				type:    DroppedField
				message: "legacy was dropped"
				when:    len(prev.items) > 1
			}]
		}
	}
}

BackwardLens: (self): {
	prev: {
		items: _each(self.items, {
			name: _item.name
		})
	}
}
-- ship/tip.thema --
Schema: {
	items: [...{name: string}]
}
