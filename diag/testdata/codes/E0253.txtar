#op: append-only
Versions are only appended: a new version comes after the newest published
one. Here 0.0 and 1.0 were published, and the candidate adds 0.1 between them,
so the published 1.0 would no longer follow the version it was published
after. 1.0 itself is as published: its lenses map the same from 0.1 as from
0.0, and its backward lens derives the same drop of crew, though the drop's
message now names 0.1.
-- candidate/ship/history/0.0.thema --
Schema: {
	size: int & <10
}
-- candidate/ship/history/0.1.thema --
Schema: {
	size: int & <20
}

BackwardLens: {
	v0_1: _
	v0_0: {
		size: 0
	}
	lacunas: {
		size: [{
			type:    Placeholder
			message: "0 is a placeholder"
		}]
	}
}
-- candidate/ship/history/1.0.thema --
Schema: {
	size: string
	crew: int
}

ForwardLens: {
	v0_1: _
	v1_0: {
		size: "unknown"
		crew: 0
	}
	lacunas: {
		size: [{
			type:    Placeholder
			message: "unknown is a placeholder"
		}]
		crew: [{
			type:    Placeholder
			message: "0 is a placeholder"
		}]
	}
}

BackwardLens: {
	v1_0: _
	v0_1: {
		size: 0
	}
	lacunas: {
		size: [{
			type:    Placeholder
			message: "0 is a placeholder"
		}]
	}
}
-- published/ship/history/0.0.thema --
Schema: {
	size: int & <10
}
-- published/ship/history/1.0.thema --
Schema: {
	size: string
	crew: int
}

ForwardLens: {
	v0_0: _
	v1_0: {
		size: "unknown"
		crew: 0
	}
	lacunas: {
		size: [{
			type:    Placeholder
			message: "unknown is a placeholder"
		}]
		crew: [{
			type:    Placeholder
			message: "0 is a placeholder"
		}]
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		size: 0
	}
	lacunas: {
		size: [{
			type:    Placeholder
			message: "0 is a placeholder"
		}]
	}
}
