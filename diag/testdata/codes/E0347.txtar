        "file": "tip.thema",
        "line": 6,
        "col": 1,
        "offset": 51,
        "origin": "user"
      },
      "help": [
        "write <field>: v0_0.before to move it, or before: _drop"
      ]
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
