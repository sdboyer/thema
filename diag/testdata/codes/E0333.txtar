#op: compile
A lens maps data fields. A hidden field (_x) or a definition (#X) is not
data, so a lens body and its lacunas have neither. That also keeps the
operations, spelled _drop, _coalesce, _match and _each, and _item from ever
naming a field.
-- ship/history/0.0.thema --
Schema: {
	kind: string
}
-- ship/history/1.0.thema --
Schema: {
	kind: "a" | "b"
}

ForwardLens: {
	v0_0: _
	v1_0: {
		_match: "a"
		kind: _match(v0_0.kind, {"a": "a", [_]: "b"})
	}
	lacunas: {
		kind: [{
			type:    LossyFieldMapping
			message: "kinds other than a become b"
		}]
	}
}
-- ship/tip.thema --
Schema: {
	kind: "a" | "b"
}
