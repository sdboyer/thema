#op: bind
A lineage declares exactly the lenses its versions call for. A forward lens
across a minor version is one they do not: a minor version is backward
compatible, so translating forward is implicit. The note says why the lens is
not called for.
-- lineage.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a: string
			}
		}
		"1": {
			schema: {
				a: string
				b?: int
			}
		}
	}
}
lenses: {
	"0.1->0.0": {
		input: _
		result: {
			a: input.a
		}
	}
	"0.0->0.1": {
		input: _
		result: {
			a: input.a
		}
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0302",
      "severity": "error",
      "headline": "the lineage's versions do not call for lens 0.0->0.1",
      "path": [
        "lenses",
        "0.0->0.1"
      ],
      "address": {
        "from": [
          0,
          0
        ],
        "kind": "lens",
        "to": [
          0,
          1
        ]
      },
      "primary": {
        "file": "lineage.cue",
        "line": 24,
        "col": 2,
        "offset": 209,
        "origin": "user"
      },
      "notes": [
        {
          "label": "0.1 is backward compatible with 0.0, so translating forward is implicit"
        }
      ],
      "help": [
        "a lineage declares a lens from each schema back to its predecessor, and one forward across each major version"
      ]
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
