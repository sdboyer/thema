#op: compile
Each target field is mapped once. Two mappings for one field would have to
agree on every instance, and the lens language has no way to say which wins.
-- ship/history/0.0.thema --
schema: {
	a: string
}
-- ship/1.0.thema --
schema: {
	b: string
}

ForwardLens: {
	v0_0: _
	v1_0: {
		b: v0_0.a
		b: "x"
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0345",
      "severity": "error",
      "headline": "b is mapped twice",
      "primary": {
        "file": "1.0.thema",
        "line": 9,
        "col": 3,
        "offset": 71,
        "origin": "user"
      }
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
