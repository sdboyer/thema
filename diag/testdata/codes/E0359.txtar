#op: develop
A move takes a source field's value as it is, so the target field must
accept every value the source field may hold. Here count may be any integer,
and total accepts only non-negative ones.
-- ship/history/0.0.thema --
Schema: {
	count: int
}
-- ship/tip.thema --
Schema: {
	total: int & >=0
}

ForwardLens: {
	v0_0: _
	tip: {
		total: v0_0.count
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0359",
      "severity": "error",
      "headline": "the ForwardLens of tip moves v0_0.count into total, which does not accept every value of it",
      "primary": {
        "file": "tip.thema",
        "line": 8,
        "col": 10,
        "offset": 72,
        "origin": "user"
      },
      "notes": [
        {
          "label": "total in tip is now uint, which does not accept every value of the prior int"
        }
      ],
      "help": [
        "map total from a value it accepts: a _match, or a computed value"
      ]
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
