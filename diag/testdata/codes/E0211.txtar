#op: bind
A minor version accepts every instance of its predecessor. Removing a field the
predecessor declares rejects every instance that has it. The position is the
predecessor's declaration, since the new schema has nothing to point at.
-- lineage.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a: string
				b: int
			}
		}
		"1": {
			schema: {
				a: string
			}
		}
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0211",
      "severity": "error",
      "headline": "b in schema 0.1 is declared in the prior schema and not accepted by the new one",
      "path": [
        "schemas",
        "0",
        "1",
        "schema",
        "b"
      ],
      "address": {
        "field": [
          "b"
        ],
        "kind": "schemaField",
        "version": [
          0,
          1
        ]
      },
      "primary": {
        "file": "lineage.cue",
        "line": 7,
        "col": 5,
        "offset": 72,
        "origin": "user"
      },
      "notes": [
        {
          "label": "schema 0.1 is declared as a minor version of 0.0, so every instance of schema 0.0 must be an instance of it (compatibility rule field-removed)"
        }
      ],
      "help": [
        "make the change compatible, or make this version 1.0"
      ]
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
