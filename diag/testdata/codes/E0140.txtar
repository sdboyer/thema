  "diagnostics": [
    {
      "code": "E0140",
      "severity": "error",
      "headline": "a in schema 0.1 refers to schemas[\"0\"][\"0\"].schema.a, a schema in the lineage",
      "path": [
        "schemas",
        "0",
        "1",
        "schema"
      ],
      "address": {
        "kind": "schema",
        "version": [
          0,
          1
        ]
      },
      "primary": {
