#op: bind
A lens reads a field its source schema does not declare. No instance of the
source has it, so the lens never has a value to copy.
-- lineage.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a: string
			}
		}
	}
	"1": {
		"0": {
			schema: {
				b: string
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		v0_0: _
		v1_0: {
			b: v0_0.nope
		}
	}
	"1.0->0.0": {
		v1_0: _
		v0_0: {
			a: v1_0.b
		}
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0362",
      "severity": "error",
      "headline": "b in the result of lens 0.0->1.0 copies v0_0.nope, which the source schema does not declare",
      "path": [
        "lenses",
        "0.0->1.0",
        "v1_0",
        "b"
      ],
      "address": {
        "field": [
          "b"
        ],
        "from": [
          0,
          0
        ],
        "kind": "lensResultField",
        "to": [
          1,
          0
        ]
      },
      "primary": {
        "file": "lineage.cue",
        "line": 22,
        "col": 7,
        "offset": 189,
        "origin": "user"
      },
      "notes": [
        {
          "label": "a lens must be total: every instance of schema 0.0 must translate to an instance of schema 1.0 (totality rule source-undeclared)"
        }
      ]
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
