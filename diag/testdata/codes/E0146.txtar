        "schemas",
        "0",
        "0",
        "schema"
      ],
      "address": {
        "kind": "schema",
        "version": [
          0,
          0
        ]
      },
      "primary": {
        "file": "lineage.cue",
        "line": 5,
        "col": 27,
        "offset": 73,
        "origin": "user"
      },
      "notes": [
        {
          "label": "reference rule ref-unresolved"
        }
      ],
      "help": [
        "write the reference with constant labels, or declare what it needs inside the schema"
      ]
    }
  ],
  "summary": {
    "errors": 1,
