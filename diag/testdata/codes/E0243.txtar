#op: append-only
Once a lineage is published, its schemas are fixed: a new revision may only add
versions. This revision changes a schema that was published, so instances
validated against the published one may no longer be instances of it.
-- old.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a: string
			}
		}
	}
}
-- new.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a: int
			}
		}
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0243",
      "severity": "error",
      "headline": "schema 0.0 differs from the published one",
      "primary": {
        "file": "new.cue",
        "line": 5,
        "col": 4,
        "offset": 44,
        "origin": "user"
      },
      "notes": [
        {
          "pos": {
            "file": "/github.com/sdboyer/thema/lineage.cue",
            "line": 178,
            "col": 11,
            "offset": 7893,
            "origin": "thema"
          },
          "label": "in thema's own CUE"
        }
      ],
      "help": [
        "a published schema is never changed; add a new version instead"
      ],
      "detail": "field a not present in {a:int}\nmissing field \"a\""
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
