#op: cli
#args: data validate -l lineage.cue -p a[ data.json
The CUE path given with -p does not parse as a path expression.
-- lineage.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a: string
			}
		}
	}
}
-- data.json --
{"a": "Argo"}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0604",
      "severity": "error",
      "headline": "\"a[\" is not a CUE path",
      "help": [
        "-p takes a path into the package, such as lin or lineages.ship"
      ],
      "detail": "expected operand, found 'EOF'"
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
-- out/text --
error[E0604]: "a[" is not a CUE path
  |
  = detail: expected operand, found 'EOF'
  = help: -p takes a path into the package, such as lin or lineages.ship
