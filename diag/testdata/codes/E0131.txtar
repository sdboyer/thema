{
  "diagnostics": [
    {
      "code": "E0131",
      "severity": "error",
      "headline": "example empty of schema 0.0 is not an instance of it",
      "path": [
        "schemas",
        "0",
        "0",
        "examples",
        "empty"
      ],
      "address": {
        "kind": "example",
        "name": "empty",
        "version": [
          0,
          0
        ]
      },
      "primary": {
        "file": "lineage.cue",
        "line": 9,
        "col": 5,
        "offset": 93,
        "origin": "user"
      },
      "notes": [
        {
          "pos": {
            "file": "lineage.cue",
