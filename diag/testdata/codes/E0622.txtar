{
  "diagnostics": [
    {
      "code": "E0622",
      "severity": "error",
      "headline": "lineages holds no example",
      "notes": [
        {
          "label": "lineages/wip/draft holds a lineage but no example.cue"
        }
      ],
      "help": [
        "an example is a lineage's directory of version files with an example.cue beside them"
      ]
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
