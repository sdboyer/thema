#op: bind
Integer arithmetic in a lens may exceed int64 for some instance. Bound the
fields the lens reads so that every result fits.
-- lineage.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a: int64
				b: int64
			}
		}
	}
	"1": {
		"0": {
			schema: {
				n: int
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		input: _
		result: {
			n: input.a + input.b
		}
	}
	"1.0->0.0": {
		input: _
		result: {
			a: 0
			b: 0
		}
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0370",
      "severity": "error",
      "headline": "lens 0.0->1.0 is not total at n in the result of lens 0.0->1.0",
      "path": [
        "lenses",
        "0.0->1.0",
        "result",
        "n"
      ],
      "address": {
        "field": [
          "n"
        ],
        "from": [
          0,
          0
        ],
        "kind": "lensResultField",
        "to": [
          1,
          0
        ]
      },
      "primary": {
        "file": "lineage.cue",
        "line": 23,
        "col": 7,
        "offset": 201,
        "origin": "user"
      },
      "notes": [
        {
          "label": "n in the result of lens 0.0->1.0 computes input.a + input.b, whose result may be [-18446744073709551616, 18446744073709551614], outside int64; bound the fields it reads so that the result fits"
        },
        {
          "label": "a lens must be total: every instance of schema 0.0 must translate to an instance of schema 1.0 (totality rule arith-overflow)"
        }
      ]
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
