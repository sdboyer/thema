#op: append-only
A version's lenses are part of it: an instance translated through the
published lens would translate differently through a changed one. Here the
candidate's 1.0 keeps its schema, but its ForwardLens writes a different
placeholder. The schema's identity is unchanged and its lenses' is not.
-- candidate/ship/history/0.0.thema --
Schema: {
	name: string
}
-- candidate/ship/history/1.0.thema --
Schema: {
	name: string
	size: int
}

ForwardLens: {
	v0_0: _
	v1_0: {
		size: 0
	}
	lacunas: {
		size: [{
			type:    Placeholder
			message: "0 is a placeholder"
		}]
	}
}
-- published/ship/history/0.0.thema --
Schema: {
	name: string
}
-- published/ship/history/1.0.thema --
Schema: {
	name: string
	size: int
}

ForwardLens: {
	v0_0: _
	v1_0: {
		size: -1
	}
	lacunas: {
		size: [{
			type:    Placeholder
			message: "-1 is a placeholder"
		}]
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0251",
      "severity": "error",
      "headline": "the ForwardLens in history/1.0.thema is not as published",
      "path": [
        "history/1.0.thema",
        "ForwardLens"
      ],
      "address": {
        "from": [
          0,
          0
        ],
        "kind": "lens",
        "to": [
          1,
          0
        ]
      },
      "primary": {
        "file": "history/1.0.thema",
        "line": 6,
        "col": 1,
        "offset": 38,
        "origin": "user"
      },
      "notes": [
        {
          "label": "a version's lenses are part of it: instances already translated through the published lens would translate differently"
        }
      ],
      "help": [
        "restore the ForwardLens in history/1.0.thema as it was published"
      ]
    }
  ],
