#op: develop
A lens produces every field its target requires. Here the tip adds a required
field the source lacks, and the ForwardLens does not say where it
comes from.
-- ship/history/0.0.thema --
Schema: {
	a: string
}
-- ship/tip.thema --
Schema: {
	a: string
	b: int
}

ForwardLens: {
	v0_0: _
	tip: {
		a: v0_0.a
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0346",
      "severity": "error",
      "headline": "ForwardLens produces nothing for b, which tip requires",
      "primary": {
        "file": "tip.thema",
        "line": 6,
        "col": 1,
        "offset": 32,
        "origin": "user"
      },
      "help": [
        "add b: <mapping> to tip"
      ]
    }
  ],
  "summary": {
    "errors": 1,
    "warnings": 0,
    "notes": 0
  }
}
-- out/text --
error[E0346]: ForwardLens produces nothing for b, which tip requires
