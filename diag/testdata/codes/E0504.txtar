#op: validate
A value in the data is of the right kind but outside what the schema allows:
out of a bound the schema sets, failing a validator it applies, or not the
constant it fixes. Here the schema bounds `count` and fixes `kind`.
-- lineage.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				kind:  "ship"
				count: int & >=0 & <10
			}
		}
	}
}
-- data.json --
{
	"kind":  "boat",
	"count": 12
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0504",
      "severity": "error",
      "headline": "kind in the data is \"boat\", but schema 0.0 requires \"ship\"",
      "path": [
        "kind"
      ],
      "address": {
        "field": [
          "kind"
        ],
        "kind": "data",
        "version": [
          0,
          0
        ]
      },
