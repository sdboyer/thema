        "file": "data.json",
        "line": 2,
        "col": 11,
        "offset": 12,
        "origin": "user"
      },
      "notes": [
        {
          "pos": {
            "file": "lineage.cue",
            "line": 6,
            "col": 5,
            "offset": 58,
            "origin": "user"
          },
          "label": "required here"
        }
      ],
      "detail": "kind: conflicting values \"ship\" and \"boat\""
    },
    {
      "code": "E0504",
      "severity": "error",
      "headline": "count in the data is 12, outside the bound <10 that schema 0.0 sets",
