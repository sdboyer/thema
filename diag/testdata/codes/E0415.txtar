#op: compile
A lacuna applies under the condition its mapping implies; an each implies
none, since it maps every element. A lacuna on an each says when it applies
with `when`.
-- ship/history/0.0.thema --
Schema: {
	items: [...{
		title: string
	}]
}
-- ship/1.0.thema --
Schema: {
	items: [...{
		name: string
	}]
}

ForwardLens: {
	v0_0: _
	v1_0: {
		items: _each(v0_0.items, {
			name: _item.title
		})
	}
	lacunas: {
		items: [{
			type:    LossyFieldMapping
			message: "titles were renamed"
		}]
	}
}

BackwardLens: {
	v1_0: _
	v0_0: {
		items: _each(v1_0.items, {
			title: _item.name
		})
	}
}
