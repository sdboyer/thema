#op: bind
A field written twice unifies the two values. Where they can disagree, one
rejects the other's value and the lens fails. Write each field once.
-- lineage.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a: int
			}
		}
	}
	"1": {
		"0": {
			schema: {
				a: int
				k: string
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		input: _
		result: {
			a: input.a
			a: 1000
			k: "v"
		}
	}
	"1.0->0.0": {
		input: _
		result: {
			a: input.a
		}
	}
}
