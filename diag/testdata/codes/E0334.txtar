#op: compile
A nested body may embed a path into the source instance, `{v0_0.meta, x: 1}`,
to copy the fields found there and add to them. It may embed nothing else.
-- ship/history/0.0.thema --
Schema: {
	meta: {
		owner: string
	}
}
-- ship/history/1.0.thema --
Schema: {
	meta: {
		owner: string
		team:  string
	}
}

ForwardLens: {
	v0_0: _
	v1_0: {
		meta: {
			defaults
			team: "unassigned"
		}
	}
}
-- ship/tip.thema --
Schema: {
	meta: {
		owner: string
		team:  string
	}
}
