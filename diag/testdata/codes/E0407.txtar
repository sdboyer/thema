#op: bind
A lacuna has a fixed set of fields: condition, sourceFields, targetFields,
message and type. A field outside that set is usually a typo; the help names
the closest.
-- lineage.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				a: string
			}
		}
		"1": {
			schema: {
				a:  string
				b?: int
			}
		}
	}
}
lenses: {
	"0.1->0.0": {
		v0_1: _
		v0_0: {
			a: v0_1.a
		}
		lacunas: [
			{type: "DroppedField", message: "b was dropped", condition: v0_1.b != _|_, severity: 1},
		]
	}
}
