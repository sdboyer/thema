#op: bind
A divisor's range includes zero, though zero itself may be excluded by a
constraint the checker does not follow. Bound the divisor away from zero with
`>0` or `<0`.
-- lineage.cue --
name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				d: int & !=0 & >=-5 & <=5
			}
		}
	}
	"1": {
		"0": {
			schema: {
				q: int
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		input: _
		result: {
			q: quo(10, input.d)
		}
	}
	"1.0->0.0": {
		input: _
		result: {
			d: 1
		}
	}
}
-- out/json --
{
  "diagnostics": [
    {
      "code": "E0387",
      "severity": "error",
      "headline": "lens 0.0->1.0 is not total at q in the result of lens 0.0->1.0",
      "path": [
        "lenses",
        "0.0->1.0",
        "result",
        "q"
      ],
      "address": {
