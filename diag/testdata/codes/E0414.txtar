#op: compile
A match's `[_]` arm collapses every value no other arm matches into one, which
loses information. It must say so, with a lacuna keyed by the mapping.
-- ship/history/0.0.thema --
Schema: {
	kind: string
}
-- ship/history/1.0.thema --
Schema: {
	kind: int
}

ForwardLens: {
	v0_0: _
	v1_0: {
		kind: _match(v0_0.kind, {
			"a": 1
			[_]: 0
		})
	}
}
