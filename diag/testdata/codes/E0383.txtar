import "strconv"

name: "ship"
schemas: {
	"0": {
		"0": {
			schema: {
				s: string
			}
		}
	}
	"1": {
		"0": {
			schema: {
				n: int
			}
		}
	}
}
lenses: {
	"0.0->1.0": {
		input: _
		result: {
			n: strconv.Atoi(input.s)
		}
	}
	"1.0->0.0": {
		input: _
		result: {
			s: "0"
		}
	}
}
